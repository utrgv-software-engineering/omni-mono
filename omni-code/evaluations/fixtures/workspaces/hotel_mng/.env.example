# Azure Deployment Configuration
# Copy this file to .env and fill in your values

# GitHub personal access token with 'repo' scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub repository (org/repo or user/repo format)
GITHUB_REPO=your-username/hotel-mng

# Azure subscription ID
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Azure Container Registry credentials
AZURE_REGISTRY_SERVER=yourregistry.azurecr.io
AZURE_REGISTRY_USERNAME=yourregistry
ROCKETSHIP_REGISTRY_PASSWORD=your-acr-password

# Azure App Service configuration
AZURE_APP_NAME=your-app-name
AZURE_RESOURCE_GROUP=your-resource-group

# Rails secrets (generate with: bin/rails secret)
RAILS_MASTER_KEY=your-master-key-from-config-master-key
SECRET_KEY_BASE=your-secret-key-base

# Platform admin credentials (created during db:seed)
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=your-secure-password-here

# Eval API token for student agent testing
# This token is shared with students to access /api/v1/eval/* endpoints
EVAL_API_TOKEN=eval-development-token

# PostgreSQL password for production sidecar container
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=your-secure-postgres-password
