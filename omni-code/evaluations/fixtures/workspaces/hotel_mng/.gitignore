# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files except templates
/.env*
!/.env*.example
/agents/.env
/agents/hotel_agent/.env

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any database files).
/storage/*
!/storage/.keep
# Eval fixture: ship the prebuilt dev sqlite so `bin/rails server`
# responds immediately. Without it the server 500s before any route
# (including /up) can answer, blocking the acceptance runner's
# health probe. Rebuild with `bin/rails db:prepare` if migrations
# change.
!/storage/development.sqlite3
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore test files
/public/test-files/*

# Ignore public uploads
/public/uploads

# Ignore public assets (in production they're compiled)
/public/assets

# Ignore node_modules
/node_modules

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore byebug history
.byebug_history

# Ignore development sqlite files (though we're using PostgreSQL)
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore rspec files if using rspec
/spec/examples.txt

# Ignore Mac .DS_Store files
.DS_Store

# Ignore IDE files
.idea
.vscode
*.swp
*.swo
*~
.project
.settings
.classpath

# Ignore coverage files
/coverage

# Ignore vendor/bundle
/vendor/bundle

# Ignore generated files
/public/packs
/public/packs-test
/public/vite

# Ignore credentials
/config/credentials/*.key

# Ignore local database config overrides
/config/database.yml.local

# Ignore ruby version managers local files
.rvmrc
.rbenv-gemsets
.tool-versions

# Ignore terraform files if using infrastructure as code
*.tfstate
*.tfstate.*
.terraform/

# Ignore dotenv local overrides
.env.local
.env.*.local

# Ignore local docker compose overrides
docker-compose.override.yml
/app/assets/builds/*
!/app/assets/builds/.keep
# Eval fixture: ship the precompiled tailwind so the layout renders
# without a build step. Rebuild with `bin/rails tailwindcss:build` if
# view templates introduce new utility classes.
!/app/assets/builds/tailwind.css

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
agents/.venv-docker/
venv/
ENV/
env/
agents/.venv/
agents/__pycache__/
agents/**/__pycache__/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
*.db
coverage/

# Ignore gremlin worktrees
.gremlin/
