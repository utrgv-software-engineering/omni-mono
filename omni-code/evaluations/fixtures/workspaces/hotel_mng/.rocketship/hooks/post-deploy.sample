#!/bin/sh
# Rocketship post-deploy hook
#
# This script runs after successful deployment to Azure.
# Remove the .sample extension to activate.
#
# Available environment variables:
#   ROCKETSHIP_IMAGE - The image that was deployed
#   ROCKETSHIP_APP_NAME - The Azure App Service name

echo "Deployed to Azure App Service: $ROCKETSHIP_APP_NAME"

# Example: Send Slack notification
# curl -X POST -H 'Content-type: application/json' \
#     --data "{\"text\":\"Deployed $ROCKETSHIP_IMAGE to $ROCKETSHIP_APP_NAME\"}" \
#     $SLACK_WEBHOOK_URL

exit 0
