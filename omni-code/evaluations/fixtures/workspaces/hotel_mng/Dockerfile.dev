# syntax=docker/dockerfile:1
# Development Dockerfile for Rails 8 application

ARG RUBY_VERSION=3.4.4
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# Rails app lives here
WORKDIR /rails

# Install base packages and build dependencies
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    # Runtime dependencies
    curl \
    libvips \
    libpq5 \
    postgresql-client \
    python3 \
    python3-pip \
    python3-venv \
    # Build dependencies
    build-essential \
    git \
    libpq-dev \
    libyaml-dev \
    pkg-config \
    # Chrome dependencies for Selenium Manager's Chrome for Testing
    # These are the shared libraries Chrome needs to run
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    fonts-liberation && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set development environment
ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT=""

# Install gems
# We copy Gemfile first to leverage Docker layer caching
COPY Gemfile Gemfile.lock ./
# Copy vendored gems (required for blazer)
COPY vendor/gems ./vendor/gems
RUN bundle install && \
    bundle exec bootsnap precompile --gemfile

# Create directories for mounted volumes
RUN mkdir -p tmp/pids tmp/cache tmp/sockets log storage

# The application code will be mounted as a volume
# This is intentionally at the end so code changes don't require rebuild

# Expose port 3000 for the Rails server
EXPOSE 3000

# Configure the entrypoint to handle database preparation
COPY docker-entrypoint-dev.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-dev.sh"]

CMD ["bin/dev"]
