<% content_for :page_title, "Edit Team Member Role" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Team Members", account_users_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit Role</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Change Team Member Role</h1>
    <p class="mt-1 text-sm text-gray-600">Update the role for <%= @account_user.user.full_name %></p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- User Information (Read-only) -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Team Member Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @account_user.user.full_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Email</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @account_user.user.email %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Current Role</dt>
              <dd class="mt-1">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= 
                  case @current_role
                  when 'owner' then 'bg-purple-100 text-purple-800'
                  when 'admin' then 'bg-blue-100 text-blue-800'
                  when 'hotel_manager' then 'bg-green-100 text-green-800'
                  when 'front_desk' then 'bg-orange-100 text-orange-800'
                  when 'housekeeping' then 'bg-teal-100 text-teal-800'
                  else 'bg-gray-100 text-gray-800'
                  end
                %>">
                  <%= @current_role&.humanize || 'No Role' %>
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Member Since</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @account_user.user.invitation_accepted_at %>
                  <%= @account_user.user.invitation_accepted_at.strftime("%B %d, %Y") %>
                <% elsif @account_user.created_at %>
                  <%= @account_user.created_at.strftime("%B %d, %Y") %>
                <% else %>
                  -
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Role Selection -->
      <%= form_with url: account_user_path(@account_user), method: :patch, local: true do |form| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Select New Role</h2>
            <p class="mt-1 text-sm text-gray-600">Choose the new role for this team member</p>
          </div>
          <div class="px-6 py-4">
            <fieldset>
              <legend class="sr-only">Select a role</legend>
              <div class="space-y-3">
                <!-- Owner -->
                <label class="relative flex items-start p-4 border rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 <%= 'border-indigo-500 bg-indigo-50' if @current_role == 'owner' %>">
                  <div class="flex items-center h-5">
                    <%= radio_button_tag :role, 'owner', @current_role == 'owner', 
                        class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <span class="block text-sm font-medium text-gray-900">
                      Owner
                      <% if @current_role == 'owner' %>
                        <span class="ml-2 text-xs text-indigo-600">(Current)</span>
                      <% end %>
                    </span>
                    <span class="block text-sm text-gray-500">
                      Full system access, can manage account settings, billing, and all hotel operations.
                    </span>
                  </div>
                </label>

                <!-- Admin -->
                <label class="relative flex items-start p-4 border rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 <%= 'border-indigo-500 bg-indigo-50' if @current_role == 'admin' %>">
                  <div class="flex items-center h-5">
                    <%= radio_button_tag :role, 'admin', @current_role == 'admin', 
                        class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <span class="block text-sm font-medium text-gray-900">
                      Administrator
                      <% if @current_role == 'admin' %>
                        <span class="ml-2 text-xs text-indigo-600">(Current)</span>
                      <% end %>
                    </span>
                    <span class="block text-sm text-gray-500">
                      Can manage users, hotels, and most settings. Cannot access billing.
                    </span>
                  </div>
                </label>

                <!-- Hotel Manager -->
                <label class="relative flex items-start p-4 border rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 <%= 'border-indigo-500 bg-indigo-50' if @current_role == 'hotel_manager' %>">
                  <div class="flex items-center h-5">
                    <%= radio_button_tag :role, 'hotel_manager', @current_role == 'hotel_manager', 
                        class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <span class="block text-sm font-medium text-gray-900">
                      Hotel Manager
                      <% if @current_role == 'hotel_manager' %>
                        <span class="ml-2 text-xs text-indigo-600">(Current)</span>
                      <% end %>
                    </span>
                    <span class="block text-sm text-gray-500">
                      Full control over hotel operations including rooms, rates, and reservations.
                    </span>
                  </div>
                </label>

                <!-- Front Desk -->
                <label class="relative flex items-start p-4 border rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 <%= 'border-indigo-500 bg-indigo-50' if @current_role == 'front_desk' %>">
                  <div class="flex items-center h-5">
                    <%= radio_button_tag :role, 'front_desk', @current_role == 'front_desk', 
                        class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <span class="block text-sm font-medium text-gray-900">
                      Front Desk Staff
                      <% if @current_role == 'front_desk' %>
                        <span class="ml-2 text-xs text-indigo-600">(Current)</span>
                      <% end %>
                    </span>
                    <span class="block text-sm text-gray-500">
                      Can manage reservations, check-ins/outs, and guest profiles.
                    </span>
                  </div>
                </label>

                <!-- Housekeeping -->
                <label class="relative flex items-start p-4 border rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-indigo-500 <%= 'border-indigo-500 bg-indigo-50' if @current_role == 'housekeeping' %>">
                  <div class="flex items-center h-5">
                    <%= radio_button_tag :role, 'housekeeping', @current_role == 'housekeeping', 
                        class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" %>
                  </div>
                  <div class="ml-3 flex-1">
                    <span class="block text-sm font-medium text-gray-900">
                      Housekeeping Staff
                      <% if @current_role == 'housekeeping' %>
                        <span class="ml-2 text-xs text-indigo-600">(Current)</span>
                      <% end %>
                    </span>
                    <span class="block text-sm text-gray-500">
                      Can view room status and update cleaning status.
                    </span>
                  </div>
                </label>
              </div>
            </fieldset>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="mt-6 flex items-center justify-end space-x-3">
          <%= link_to "Cancel", account_users_path, 
              class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <%= submit_tag "Update Role", 
              class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="lg:col-span-1">
      <!-- Warning Messages -->
      <% if @account_user.owner? && @account_user.account.account_users.joins(:roles).where(roles: { name: 'owner' }).count == 1 %>
        <div class="mb-6 bg-yellow-50 rounded-lg p-6 border border-yellow-200">
          <h3 class="text-sm font-semibold text-yellow-900 mb-2 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            Last Owner Warning
          </h3>
          <p class="text-sm text-yellow-800">
            This is the only owner of this account. You must assign another owner before changing this user's role.
          </p>
        </div>
      <% end %>

      <!-- Role Information -->
      <div class="bg-blue-50 rounded-lg p-6 border border-blue-200">
        <h3 class="text-lg font-semibold text-blue-900 mb-4">Role Permissions</h3>
        <div class="space-y-4 text-sm">
          <div>
            <h4 class="font-semibold text-blue-900">Owner</h4>
            <ul class="mt-1 space-y-1 text-blue-800">
              <li class="flex items-start">
                <svg class="w-4 h-4 mr-1 mt-0.5 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Account settings & billing
              </li>
              <li class="flex items-start">
                <svg class="w-4 h-4 mr-1 mt-0.5 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                All administrative functions
              </li>
            </ul>
          </div>
          
          <div>
            <h4 class="font-semibold text-blue-900">Administrator</h4>
            <ul class="mt-1 space-y-1 text-blue-800">
              <li class="flex items-start">
                <svg class="w-4 h-4 mr-1 mt-0.5 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                User management
              </li>
              <li class="flex items-start">
                <svg class="w-4 h-4 mr-1 mt-0.5 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Hotel configuration
              </li>
              <li class="flex items-start">
                <svg class="w-4 h-4 mr-1 mt-0.5 flex-shrink-0 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
                No billing access
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>