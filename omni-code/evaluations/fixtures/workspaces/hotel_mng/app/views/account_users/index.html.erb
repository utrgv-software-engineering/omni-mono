<% content_for :page_title, "Team Members - #{current_tenant.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Team Members</h1>
      <p class="mt-1 text-sm text-gray-600">Manage user access and roles for <%= current_tenant.name %></p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(AccountUser).new? %>
        <%= link_to new_account_user_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Invite Team Member
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Pending Invitations -->
  <% if @pending_invitations.any? %>
    <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">
            <%= pluralize(@pending_invitations.count, "pending invitation") %>
          </h3>
          <div class="mt-2 text-sm text-yellow-700">
            <ul class="list-disc pl-5 space-y-1">
              <% @pending_invitations.each do |user| %>
                <li>
                  <%= user.email %> - invited <%= time_ago_in_words(user.invitation_sent_at) %> ago
                  <% if user.invitation_due_at %>
                    (expires in <%= time_ago_in_words(user.invitation_due_at) %>)
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Team Members by Role -->
  <div class="space-y-6">
    <!-- Owners -->
    <% if @owners.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-purple-50">
          <h2 class="text-lg font-semibold text-purple-900 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Owners
          </h2>
          <p class="text-sm text-purple-700 mt-1">Full system access and account management</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% @owners.each do |account_user| %>
            <%= render 'team_member', account_user: account_user %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Admins -->
    <% if @admins.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
          <h2 class="text-lg font-semibold text-blue-900 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a1 1 0 00-1 1v1a1 1 0 002 0V3a1 1 0 00-1-1zM4 4h3a3 3 0 006 0h3a2 2 0 012 2v9a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2zm2.5 7a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm2.45 4a2.5 2.5 0 10-4.9 0h4.9zM12 9a1 1 0 100 2h3a1 1 0 100-2h-3zm-1 4a1 1 0 011-1h2a1 1 0 110 2h-2a1 1 0 01-1-1z"/>
            </svg>
            Administrators
          </h2>
          <p class="text-sm text-blue-700 mt-1">Administrative access and user management</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% @admins.each do |account_user| %>
            <%= render 'team_member', account_user: account_user %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Hotel Managers -->
    <% if @hotel_managers.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-green-50">
          <h2 class="text-lg font-semibold text-green-900 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"/>
            </svg>
            Hotel Managers
          </h2>
          <p class="text-sm text-green-700 mt-1">Full hotel operations control</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% @hotel_managers.each do |account_user| %>
            <%= render 'team_member', account_user: account_user %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Front Desk Staff -->
    <% if @front_desk_staff.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-orange-50">
          <h2 class="text-lg font-semibold text-orange-900 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Front Desk Staff
          </h2>
          <p class="text-sm text-orange-700 mt-1">Reservations, check-ins/outs, and guest management</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% @front_desk_staff.each do |account_user| %>
            <%= render 'team_member', account_user: account_user %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Housekeeping Staff -->
    <% if @housekeeping_staff.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-teal-50">
          <h2 class="text-lg font-semibold text-teal-900 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 2a1 1 0 00-1 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0113 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 7.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V7.477l-.763.105-1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 013 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L7 4.323V3a1 1 0 011-1h2z" clip-rule="evenodd"/>
            </svg>
            Housekeeping Staff
          </h2>
          <p class="text-sm text-teal-700 mt-1">Room status updates and cleaning management</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% @housekeeping_staff.each do |account_user| %>
            <%= render 'team_member', account_user: account_user %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Empty State -->
    <% if @account_users.empty? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="text-center py-12 px-6">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No team members</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by inviting your first team member.</p>
          <div class="mt-6">
            <% if policy(AccountUser).new? %>
              <%= link_to new_account_user_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Invite Team Member
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>