<div class="mb-6">
  <%= link_to admin_students_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Students
  <% end %>
</div>

<div class="max-w-lg">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Add Multiple Students</h1>
    <p class="text-gray-600 mt-1">Create accounts for multiple students at once</p>
  </div>

  <div class="bg-white shadow-sm rounded-lg p-6">
    <%= form_with url: bulk_create_admin_students_path, method: :post, local: true, class: "space-y-6" do |f| %>
      <div>
        <label for="emails" class="block text-sm font-medium text-gray-700">Student Entries (CSV)</label>
        <textarea name="emails" id="emails" rows="10" required
                  class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm font-mono"
                  placeholder='"Baker, Bob L.",bob@university.edu,12345
"Smith, Alice M.",alice@university.edu,67890
"Jones, Carol",carol@university.edu,11111'></textarea>
        <p class="mt-2 text-sm text-gray-500">CSV format: <code class="bg-gray-200 px-1 rounded">"Last, First",email,student_id</code></p>
      </div>

      <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
        <p>Password will be set to <code class="bg-gray-200 px-1 rounded">ai_&lt;student_id&gt;</code></p>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to "Cancel", admin_students_path, class: "px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <button type="submit" class="px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
          Create Students
        </button>
      </div>
    <% end %>
  </div>
</div>
