<div class="mb-6">
  <%= link_to admin_students_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Students
  <% end %>
</div>

<div class="max-w-md">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Add Student</h1>
    <p class="text-gray-600 mt-1">Create a new student account with a hotel</p>
  </div>

  <div class="bg-white shadow-sm rounded-lg p-6">
    <%= form_with url: admin_students_path, method: :post, local: true, class: "space-y-6" do |f| %>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Student Email</label>
        <input type="email" name="email" id="email" required autofocus
               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
               placeholder="student@university.edu">
      </div>

      <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
        <p class="font-medium text-gray-700 mb-2">This will create:</p>
        <ul class="space-y-1">
          <li>&#8226; Hotel with 20 rooms (10 Standard, 10 Deluxe)</li>
          <li>&#8226; Sample guest with reservation</li>
          <li>&#8226; Login account (password change required on first login)</li>
          <li>&#8226; API key for AI agent development</li>
        </ul>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to "Cancel", admin_students_path, class: "px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <button type="submit" class="px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
          Create Student
        </button>
      </div>
    <% end %>
  </div>
</div>
