<div class="mb-6">
  <%= link_to admin_students_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Students
  <% end %>
</div>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @student_user&.email %></h1>
    <p class="text-gray-600 mt-1"><%= @hotel&.name %></p>
  </div>
  <div class="flex space-x-3">
    <%= button_to admin_student_path(@account), method: :delete, data: { turbo_confirm: "Delete this student account?" }, class: "inline-flex items-center px-4 py-2 border border-red-300 rounded-lg text-sm font-medium text-red-700 bg-white hover:bg-red-50" do %>
      Delete
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Student Login Card -->
  <div class="bg-white shadow-sm rounded-lg p-6 border-2 border-indigo-200">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Student Login</h2>

    <% if @student_user %>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-500">Email</label>
          <div class="mt-1 flex items-center space-x-2">
            <code class="flex-1 px-3 py-2 bg-indigo-50 rounded-lg text-sm font-mono text-indigo-800"><%= @student_user.email %></code>
            <button onclick="navigator.clipboard.writeText('<%= @student_user.email %>')" class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg" title="Copy">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </button>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-500">Temporary Password</label>
          <div class="mt-1 flex items-center space-x-2">
            <code class="flex-1 px-3 py-2 bg-indigo-50 rounded-lg text-sm font-mono text-indigo-800"><%= @student_account_user&.generated_password || '(already changed)' %></code>
            <% if @student_account_user&.generated_password %>
              <button onclick="navigator.clipboard.writeText('<%= @student_account_user.generated_password %>')" class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg" title="Copy">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              </button>
            <% end %>
          </div>
        </div>

        <% if @student_user.force_password_change? %>
          <div class="pt-3 p-3 bg-yellow-50 rounded-lg text-sm text-yellow-800">
            Student will be required to change password on first login.
          </div>
        <% else %>
          <div class="pt-3 p-3 bg-green-50 rounded-lg text-sm text-green-800">
            Student has already set their own password.
          </div>
        <% end %>

        <div class="pt-3 text-sm text-gray-500">
          Login URL: <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">/users/sign_in</code>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No student user found.</p>
    <% end %>
  </div>

  <!-- API Credentials Card -->
  <div class="bg-white shadow-sm rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">API Credentials</h2>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-500">API Key</label>
        <div class="mt-1 flex items-center space-x-2">
          <code class="flex-1 px-3 py-2 bg-gray-100 rounded-lg text-sm font-mono text-gray-800 break-all"><%= @api_key || 'Not configured' %></code>
          <% if @api_key %>
            <button onclick="navigator.clipboard.writeText('<%= @api_key %>')" class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg" title="Copy">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </button>
          <% end %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-500">Hotel ID</label>
        <div class="mt-1 flex items-center space-x-2">
          <code class="flex-1 px-3 py-2 bg-gray-100 rounded-lg text-sm font-mono text-gray-800"><%= @hotel&.id || 'N/A' %></code>
          <% if @hotel %>
            <button onclick="navigator.clipboard.writeText('<%= @hotel.id %>')" class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg" title="Copy">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </button>
          <% end %>
        </div>
      </div>

      <div class="pt-4 border-t border-gray-200">
        <label class="block text-sm font-medium text-gray-700 mb-2">Environment Variables</label>
        <div class="bg-gray-900 rounded-lg p-4">
          <pre class="text-sm text-green-400 font-mono whitespace-pre-wrap">HOTEL_API_KEY=<%= @api_key %>
HOTEL_API_HOTEL_ID=<%= @hotel&.id %></pre>
        </div>
        <button onclick="navigator.clipboard.writeText('HOTEL_API_KEY=<%= @api_key %>\nHOTEL_API_HOTEL_ID=<%= @hotel&.id %>')" class="mt-2 text-sm text-indigo-600 hover:text-indigo-800">
          Copy to clipboard
        </button>
      </div>

      <div class="pt-4">
        <%= button_to "Regenerate API Key", regenerate_api_key_admin_student_path(@account), method: :post, data: { turbo_confirm: "This will invalidate the current API key. Continue?" }, class: "text-sm text-orange-600 hover:text-orange-800" %>
      </div>
    </div>
  </div>

  <!-- Hotel Info Card -->
  <% if @hotel %>
    <div class="bg-white shadow-sm rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Hotel</h2>

      <dl class="space-y-3">
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Name</dt>
          <dd class="text-sm text-gray-900"><%= @hotel.name %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Rooms</dt>
          <dd class="text-sm text-gray-900"><%= @hotel.rooms.count %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Room Types</dt>
          <dd class="text-sm text-gray-900"><%= @hotel.room_types.pluck(:name).join(', ') %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Reservations</dt>
          <dd class="text-sm text-gray-900"><%= @account.reservations.count %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Guests</dt>
          <dd class="text-sm text-gray-900"><%= @account.guests.count %></dd>
        </div>
      </dl>
    </div>
  <% end %>

  <!-- Sample Data Card -->
  <div class="bg-white shadow-sm rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Sample Data</h2>

    <% sample_reservation = @account.reservations.first %>
    <% if sample_reservation %>
      <dl class="space-y-3">
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Guest</dt>
          <dd class="text-sm text-gray-900"><%= sample_reservation.guest.full_name %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Email</dt>
          <dd class="text-sm text-gray-900"><%= sample_reservation.guest.email %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Confirmation #</dt>
          <dd class="text-sm font-mono text-gray-900"><%= sample_reservation.confirmation_number %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Dates</dt>
          <dd class="text-sm text-gray-900"><%= sample_reservation.check_in_date.strftime("%b %d") %> - <%= sample_reservation.check_out_date.strftime("%b %d, %Y") %></dd>
        </div>
      </dl>
    <% else %>
      <p class="text-sm text-gray-500">No sample reservation.</p>
    <% end %>
  </div>
</div>
