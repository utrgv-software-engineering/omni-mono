<% content_for :page_title, "Edit #{@amenity.name} - Amenities" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Amenities", amenities_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to @amenity.name, amenity_path(@amenity), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Edit <%= @amenity.name %></h1>
    <p class="mt-1 text-sm text-gray-600">Update amenity details and settings</p>
  </div>

  <%= render 'form', amenity: @amenity %>
</div>