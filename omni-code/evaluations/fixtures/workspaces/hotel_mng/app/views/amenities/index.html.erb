<% content_for :page_title, "Amenities - #{current_tenant.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Amenities</h1>
      <p class="mt-1 text-sm text-gray-600">Manage amenity definitions for hotels and rooms</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(Amenity).new? %>
        <%= link_to new_amenity_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Amenity
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Category Filter Tabs -->
  <div class="mb-6">
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8" aria-label="Categories">
        <%= link_to "All", amenities_path, 
            class: "#{params[:category].blank? ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm" %>
        <% Amenity::CATEGORIES.each do |category| %>
          <%= link_to category.humanize, amenities_path(category: category),
              class: "#{params[:category] == category ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm" %>
        <% end %>
      </nav>
    </div>
  </div>

  <% if @amenities.any? %>
    <!-- Amenities Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <% @amenities.each do |amenity| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <div class="p-4">
            <div class="flex items-start justify-between">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                    <% if amenity.icon.present? %>
                      <i class="fa-solid fa-<%= amenity.icon %> text-gray-600"></i>
                    <% else %>
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
                <div class="ml-3 flex-1">
                  <h3 class="text-sm font-medium text-gray-900">
                    <%= link_to amenity.name, amenity_path(amenity), class: "hover:text-indigo-600" %>
                  </h3>
                  <p class="mt-1 text-xs text-gray-500"><%= amenity.category.humanize %></p>
                </div>
              </div>
              <% if amenity.is_countable? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                  123
                </span>
              <% end %>
            </div>
            
            <% if amenity.description.present? %>
              <p class="mt-3 text-xs text-gray-600 line-clamp-2"><%= amenity.description %></p>
            <% end %>
            
            <!-- Usage Stats -->
            <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
              <span><%= amenity.hotels.count %> hotels</span>
              <span><%= amenity.room_types.count %> room types</span>
            </div>
            
            <!-- Actions -->
            <div class="mt-3 flex space-x-2">
              <%= link_to "View", amenity_path(amenity), 
                  class: "flex-1 text-center px-2 py-1 text-xs border border-gray-300 font-medium rounded text-gray-700 bg-white hover:bg-gray-50" %>
              <% if policy(amenity).edit? %>
                <%= link_to "Edit", edit_amenity_path(amenity), 
                    class: "flex-1 text-center px-2 py-1 text-xs border border-transparent font-medium rounded text-indigo-700 bg-indigo-100 hover:bg-indigo-200" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="text-center py-12 px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No amenities found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if params[:category].present? %>
            No amenities in the <%= params[:category].humanize %> category.
          <% else %>
            Get started by creating your first amenity.
          <% end %>
        </p>
        <% if policy(Amenity).new? %>
          <div class="mt-6">
            <%= link_to new_amenity_path, class: "inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add First Amenity
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>