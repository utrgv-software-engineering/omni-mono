<% content_for :page_title, "#{@amenity.name} - Amenities" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to "Amenities", amenities_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @amenity.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @amenity.name %></h1>
      <div class="mt-1 flex items-center space-x-3">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <%= @amenity.category.humanize %>
        </span>
        <% if @amenity.is_countable? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Countable
          </span>
        <% end %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@amenity).edit? %>
        <%= link_to edit_amenity_path(@amenity), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if policy(@amenity).destroy? && @amenity.hotels.empty? && @amenity.room_types.empty? %>
        <%= link_to amenity_path(@amenity), method: :delete,
            data: { confirm: "Are you sure you want to delete this amenity?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @amenity.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Category</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @amenity.category.humanize %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Icon</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-gray-100 rounded flex items-center justify-center mr-2">
                    <% if @amenity.icon.present? %>
                      <i class="fa-solid fa-<%= @amenity.icon %> text-gray-600"></i>
                    <% else %>
                      <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                      </svg>
                    <% end %>
                  </div>
                  <span class="text-xs text-gray-500"><%= @amenity.icon || "default" %></span>
                </div>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Countable</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @amenity.is_countable? ? "Yes (can specify quantity)" : "No (single item)" %>
              </dd>
            </div>
          </dl>
          
          <% if @amenity.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @amenity.description %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Hotels Using This Amenity -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Hotels Using This Amenity (<%= @amenity.hotels.count %>)</h2>
        </div>
        
        <% if @amenity.hotels.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Hotel
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Cost
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Location
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @amenity.hotel_amenities.includes(:hotel).each do |hotel_amenity| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to hotel_amenity.hotel.name, hotel_path(hotel_amenity.hotel), class: "hover:text-indigo-600" %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if hotel_amenity.is_available? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Available
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                          Unavailable
                        </span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= hotel_amenity.display_price %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= hotel_amenity.location || "-" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8">
            <p class="text-sm text-gray-500">No hotels are currently using this amenity.</p>
          </div>
        <% end %>
      </div>

      <!-- Room Types Using This Amenity -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Room Types Using This Amenity (<%= @amenity.room_types.count %>)</h2>
        </div>
        
        <% if @amenity.room_types.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Room Type
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Hotel
                  </th>
                  <% if @amenity.is_countable? %>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Quantity
                    </th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @amenity.room_type_amenities.includes(room_type: :hotel).each do |room_type_amenity| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to room_type_amenity.room_type.name, 
                            hotel_room_type_path(room_type_amenity.room_type.hotel, room_type_amenity.room_type), 
                            class: "hover:text-indigo-600" %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= room_type_amenity.room_type.hotel.name %>
                    </td>
                    <% if @amenity.is_countable? %>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        <%= room_type_amenity.quantity %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8">
            <p class="text-sm text-gray-500">No room types are currently using this amenity.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Usage Statistics -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Usage Statistics</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Hotels</dt>
              <dd class="text-sm font-medium text-gray-900"><%= @amenity.hotels.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Room Types</dt>
              <dd class="text-sm font-medium text-gray-900"><%= @amenity.room_types.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Total Rooms</dt>
              <dd class="text-sm font-medium text-gray-900">
                <%= @amenity.room_types.joins(:rooms).count(:rooms) %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Type</dt>
              <dd class="text-gray-900">
                <%= @amenity.hotel_amenity? ? "Hotel-level" : "Room-level" %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Created</dt>
              <dd class="text-gray-900"><%= @amenity.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Last Updated</dt>
              <dd class="text-gray-900"><%= @amenity.updated_at.strftime("%b %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>