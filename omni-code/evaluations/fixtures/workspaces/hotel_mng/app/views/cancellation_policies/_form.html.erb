<%= form_with model: cancellation_policy, local: true do |form| %>
  <% if cancellation_policy.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(cancellation_policy.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% cancellation_policy.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, 
                  placeholder: "e.g., Flexible Cancellation",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Display name for this policy</p>
            </div>
            <div>
              <%= form.label :code, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :code, 
                  placeholder: "e.g., FLEX-24",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Unique code for internal use</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :cancellation_type, "Policy Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :cancellation_type, 
                  options_for_select(CancellationPolicy::CANCELLATION_TYPES.map { |type| [type.humanize, type] }, cancellation_policy.cancellation_type),
                  { prompt: "Select a type" },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Determines cancellation rules</p>
            </div>
            <div>
              <%= form.label :hotel_id, "Apply To", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :hotel_id, 
                  options_for_select([["Account-wide (All Hotels)", ""]] + current_tenant.hotels.pluck(:name, :id), cancellation_policy.hotel_id),
                  {},
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Scope of this policy</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Cancellation Terms -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Cancellation Terms</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :free_cancellation_hours, "Free Cancellation Hours", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :free_cancellation_hours, 
                  min: 0,
                  placeholder: "24",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Hours before check-in for free cancellation</p>
            </div>
            <div>
              <%= form.label :penalty_percentage, "Penalty Percentage", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative">
                <%= form.number_field :penalty_percentage, 
                    min: 0,
                    max: 100,
                    placeholder: "0",
                    class: "w-full pr-8 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
                <span class="absolute right-3 top-2 text-gray-500">%</span>
              </div>
              <p class="mt-1 text-xs text-gray-500">Percentage of total amount charged</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :penalty_nights, "Penalty Nights", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :penalty_nights, 
                  min: 0,
                  placeholder: "1",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Number of nights charged as penalty</p>
            </div>
            <div>
              <%= form.label :no_show_penalty, "No-Show Penalty", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative">
                <%= form.number_field :no_show_penalty, 
                    min: 0,
                    max: 100,
                    placeholder: "100",
                    class: "w-full pr-8 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
                <span class="absolute right-3 top-2 text-gray-500">%</span>
              </div>
              <p class="mt-1 text-xs text-gray-500">Percentage charged for no-shows</p>
            </div>
          </div>
          
          <div>
            <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, 
                rows: 4,
                placeholder: "Enter policy description and terms...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">Detailed policy description shown to guests</p>
          </div>
        </div>
      </div>

      <!-- Policy Settings -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Policy Settings</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="flex items-center">
            <%= form.check_box :is_default, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <%= form.label :is_default, "Set as Default", class: "ml-2 block text-sm text-gray-900" %>
            <p class="ml-6 text-xs text-gray-500">Make this the default policy for new rate plans</p>
          </div>
          
          <div class="flex items-center">
            <%= form.check_box :is_refundable, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <%= form.label :is_refundable, "Refundable", class: "ml-2 block text-sm text-gray-900" %>
            <p class="ml-6 text-xs text-gray-500">Allow refunds under this policy</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Account</dt>
              <dd class="text-gray-900 font-medium"><%= current_tenant.name %></dd>
            </div>
            <% if cancellation_policy.persisted? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Created</dt>
                <dd class="text-gray-900"><%= cancellation_policy.created_at.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Last Updated</dt>
                <dd class="text-gray-900"><%= cancellation_policy.updated_at.strftime("%b %d, %Y") %></dd>
              </div>
            <% else %>
              <div class="text-gray-500 italic">
                New policy will be created
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Policy Type Guide -->
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Policy Types</h3>
            <div class="mt-2 text-sm text-blue-700">
              <dl class="space-y-2">
                <div>
                  <dt class="font-medium">Flexible</dt>
                  <dd class="text-xs">Free cancellation until specified hours before check-in</dd>
                </div>
                <div>
                  <dt class="font-medium">Moderate</dt>
                  <dd class="text-xs">Free 5+ days before, 1 night penalty within 5 days</dd>
                </div>
                <div>
                  <dt class="font-medium">Strict</dt>
                  <dd class="text-xs">50% charge 7+ days before, full charge within 7 days</dd>
                </div>
                <div>
                  <dt class="font-medium">Non-refundable</dt>
                  <dd class="text-xs">No refunds for any cancellations</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", cancellation_policies_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <%= form.submit class: "px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>
<% end %>