<% content_for :page_title, "Cancellation Policies - #{current_tenant.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Cancellation Policies</h1>
      <p class="mt-1 text-sm text-gray-600">Manage cancellation policies for your account and hotels</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(CancellationPolicy).new? %>
        <%= link_to new_cancellation_policy_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Policy
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="mb-6">
    <nav class="flex space-x-4" aria-label="Tabs">
      <%= link_to cancellation_policies_path, 
          class: "px-3 py-2 font-medium text-sm rounded-lg #{params[:filter].blank? ? 'bg-white text-gray-700' : 'text-gray-500 hover:text-gray-700'}" do %>
        All Policies (<%= CancellationPolicy.count %>)
      <% end %>
      <%= link_to cancellation_policies_path(filter: 'account_wide'), 
          class: "px-3 py-2 font-medium text-sm rounded-lg #{params[:filter] == 'account_wide' ? 'bg-white text-gray-700' : 'text-gray-500 hover:text-gray-700'}" do %>
        Account-Wide (<%= CancellationPolicy.account_wide.count %>)
      <% end %>
      <%= link_to cancellation_policies_path(filter: 'hotel_specific'), 
          class: "px-3 py-2 font-medium text-sm rounded-lg #{params[:filter] == 'hotel_specific' ? 'bg-white text-gray-700' : 'text-gray-500 hover:text-gray-700'}" do %>
        Hotel-Specific (<%= CancellationPolicy.hotel_specific.count %>)
      <% end %>
    </nav>
  </div>

  <!-- Policies Table -->
  <div class="bg-white shadow-sm rounded-lg border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">All Cancellation Policies</h2>
    </div>
    
    <% if @cancellation_policies.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Policy Name
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Code
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Type
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Hotel
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Free Hours
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th scope="col" class="relative px-6 py-3">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @cancellation_policies.includes(:hotel).each do |cancellation_policy| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">
                    <%= link_to cancellation_policy.name, cancellation_policy_path(cancellation_policy), class: "hover:text-indigo-600" %>
                  </div>
                  <% if cancellation_policy.description.present? %>
                    <div class="text-xs text-gray-500 max-w-xs truncate"><%= cancellation_policy.description %></div>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= cancellation_policy.code %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% type_colors = {
                    "flexible" => "green",
                    "moderate" => "yellow",
                    "strict" => "orange",
                    "non_refundable" => "red"
                  } %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= type_colors[cancellation_policy.cancellation_type] %>-100 text-<%= type_colors[cancellation_policy.cancellation_type] %>-800">
                    <%= cancellation_policy.cancellation_type.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if cancellation_policy.hotel.present? %>
                    <div class="text-sm text-gray-900"><%= cancellation_policy.hotel.name %></div>
                  <% else %>
                    <span class="text-sm text-gray-500">Account-wide</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if cancellation_policy.free_cancellation_hours.present? %>
                    <div class="text-sm text-gray-900"><%= cancellation_policy.free_cancellation_hours %> hrs</div>
                  <% else %>
                    <span class="text-sm text-gray-500">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col space-y-1">
                    <% if cancellation_policy.is_default %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                        Default
                      </span>
                    <% end %>
                    <% if cancellation_policy.is_refundable %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                        Refundable
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to cancellation_policy_path(cancellation_policy), class: "text-gray-600 hover:text-gray-900" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                    <% end %>
                    <% if policy(cancellation_policy).edit? %>
                      <%= link_to edit_cancellation_policy_path(cancellation_policy), class: "text-indigo-600 hover:text-indigo-900" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      <% end %>
                    <% end %>
                    <% if policy(cancellation_policy).destroy? %>
                      <%= link_to cancellation_policy_path(cancellation_policy), method: :delete,
                          data: { confirm: "Are you sure you want to delete this cancellation policy?" },
                          class: "text-red-600 hover:text-red-900" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No cancellation policies</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating your first cancellation policy.</p>
        <div class="mt-6">
          <% if policy(CancellationPolicy).new? %>
            <%= link_to new_cancellation_policy_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Cancellation Policy
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>