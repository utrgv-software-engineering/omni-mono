<% content_for :page_title, "New Cancellation Policy - #{current_tenant.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Cancellation Policies", cancellation_policies_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Policy</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">New Cancellation Policy</h1>
    <p class="mt-1 text-sm text-gray-600">Create a cancellation policy for your account or specific hotel</p>
  </div>

  <%= render "form", cancellation_policy: @cancellation_policy %>
</div>