<% content_for :page_title, "#{@cancellation_policy.name} - Cancellation Policy" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to "Cancellation Policies", cancellation_policies_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @cancellation_policy.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @cancellation_policy.name %></h1>
      <div class="mt-1 flex items-center space-x-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <%= @cancellation_policy.code %>
        </span>
        <% type_colors = {
          "flexible" => "green",
          "moderate" => "yellow", 
          "strict" => "orange",
          "non_refundable" => "red"
        } %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= type_colors[@cancellation_policy.cancellation_type] %>-100 text-<%= type_colors[@cancellation_policy.cancellation_type] %>-800">
          <%= @cancellation_policy.cancellation_type.humanize %>
        </span>
        <% if @cancellation_policy.is_default %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Default
          </span>
        <% end %>
        <% if @cancellation_policy.is_refundable %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Refundable
          </span>
        <% end %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@cancellation_policy).edit? && !@cancellation_policy.is_default %>
        <%= link_to cancellation_policy_path(@cancellation_policy), method: :patch,
            data: { params: { cancellation_policy: { is_default: true } }.to_param },
            class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          Set as Default
        <% end %>
      <% end %>
      
      <% if policy(@cancellation_policy).edit? %>
        <%= link_to edit_cancellation_policy_path(@cancellation_policy), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if policy(@cancellation_policy).destroy? %>
        <%= link_to cancellation_policy_path(@cancellation_policy), method: :delete,
            data: { confirm: "Are you sure you want to delete this cancellation policy?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Policy Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Policy Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @cancellation_policy.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Code</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @cancellation_policy.code %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Type</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @cancellation_policy.cancellation_type.humanize %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Scope</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @cancellation_policy.hotel.present? %>
                  <%= @cancellation_policy.hotel.name %>
                <% else %>
                  Account-wide
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Free Cancellation</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @cancellation_policy.free_cancellation_hours.present? %>
                  <%= @cancellation_policy.free_cancellation_hours %> hours before check-in
                <% else %>
                  Not applicable
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Penalty</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @cancellation_policy.penalty_percentage.present? %>
                  <%= @cancellation_policy.penalty_percentage %>% of total
                <% elsif @cancellation_policy.penalty_nights.present? %>
                  <%= pluralize(@cancellation_policy.penalty_nights, "night") %> charge
                <% else %>
                  Varies by type
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">No-Show Penalty</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @cancellation_policy.no_show_penalty.present? %>
                  <%= @cancellation_policy.no_show_penalty %>% of total
                <% else %>
                  Full charge
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Refundable</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @cancellation_policy.is_refundable ? "Yes" : "No" %>
              </dd>
            </div>
          </dl>
          
          <% if @cancellation_policy.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= @cancellation_policy.description %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Calculation Examples -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Cancellation Fee Examples</h2>
        </div>
        <div class="px-6 py-4">
          <p class="text-sm text-gray-600 mb-4">Based on a $500 reservation total (2 nights at $250/night)</p>
          
          <div class="space-y-3">
            <% case @cancellation_policy.cancellation_type %>
            <% when "flexible" %>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel <%= (@cancellation_policy.free_cancellation_hours || 24) %> hours before check-in</span>
                <span class="text-sm font-medium text-green-600">No fee</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel within <%= (@cancellation_policy.free_cancellation_hours || 24) %> hours</span>
                <span class="text-sm font-medium text-orange-600">
                  <% if @cancellation_policy.penalty_nights %>
                    $<%= 250 * @cancellation_policy.penalty_nights %> (<%= pluralize(@cancellation_policy.penalty_nights, "night") %>)
                  <% elsif @cancellation_policy.penalty_percentage %>
                    $<%= (500 * @cancellation_policy.penalty_percentage / 100).round %> (<%= @cancellation_policy.penalty_percentage %>%)
                  <% else %>
                    Varies
                  <% end %>
                </span>
              </div>
            <% when "moderate" %>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel 5+ days before check-in</span>
                <span class="text-sm font-medium text-green-600">No fee</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel 1-4 days before check-in</span>
                <span class="text-sm font-medium text-orange-600">$250 (1 night)</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel day of check-in</span>
                <span class="text-sm font-medium text-red-600">$500 (full amount)</span>
              </div>
            <% when "strict" %>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel 7+ days before check-in</span>
                <span class="text-sm font-medium text-orange-600">$250 (50%)</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Cancel within 7 days</span>
                <span class="text-sm font-medium text-red-600">$500 (full amount)</span>
              </div>
            <% when "non_refundable" %>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-700">Any cancellation</span>
                <span class="text-sm font-medium text-red-600">$500 (non-refundable)</span>
              </div>
            <% end %>
            
            <div class="flex justify-between items-center p-3 bg-red-50 rounded-lg">
              <span class="text-sm text-gray-700">No-show</span>
              <span class="text-sm font-medium text-red-600">
                <% if @cancellation_policy.no_show_penalty %>
                  $<%= (500 * @cancellation_policy.no_show_penalty / 100).round %> (<%= @cancellation_policy.no_show_penalty %>%)
                <% else %>
                  $500 (full amount)
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Statistics -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Statistics</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Status</dt>
              <dd class="text-sm font-medium text-gray-900">
                <% if @cancellation_policy.is_default %>
                  <span class="text-blue-600">Default</span>
                <% else %>
                  <span class="text-gray-600">Active</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Refundable</dt>
              <dd class="text-sm font-medium text-gray-900">
                <%= @cancellation_policy.is_refundable ? "Yes" : "No" %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Account</dt>
              <dd class="text-gray-900"><%= current_tenant.name %></dd>
            </div>
            <% if @cancellation_policy.hotel.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Hotel</dt>
                <dd class="text-gray-900"><%= @cancellation_policy.hotel.name %></dd>
              </div>
            <% end %>
            <div class="flex justify-between">
              <dt class="text-gray-500">Created</dt>
              <dd class="text-gray-900"><%= @cancellation_policy.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Last Updated</dt>
              <dd class="text-gray-900"><%= @cancellation_policy.updated_at.strftime("%b %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>