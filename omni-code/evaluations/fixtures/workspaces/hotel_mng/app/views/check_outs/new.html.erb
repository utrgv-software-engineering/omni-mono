<% content_for :page_title, "Check Out - #{@reservation.confirmation_number}" %>

<div class="max-w-5xl mx-auto">
  <!-- Header with Breadcrumb -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Reservations", reservations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to @reservation.confirmation_number, reservation_path(@reservation), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Check Out</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Guest Check-Out</h1>
  </div>

  <%= form_with url: reservation_check_out_path(@reservation), local: true do |form| %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content (2/3 width) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Guest Information -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Guest Information</h2>
          </div>
          <div class="px-6 py-4">
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <dt class="text-sm font-medium text-gray-500">Primary Guest</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @reservation.guest.full_name %>
                  <% if @reservation.guest.vip_status? %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">VIP</span>
                  <% end %>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Room</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @reservation.room&.room_number || "Not assigned" %>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Actual Check-in</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @reservation.actual_check_in&.strftime("%b %d, %I:%M %p") || "N/A" %>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Expected Check-out</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @reservation.check_out_date.strftime("%b %d, %Y") %>
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Additional Charges -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-semibold text-gray-900">Additional Charges</h2>
              <button type="button" class="text-sm text-blue-600 hover:text-blue-800" onclick="addChargeRow()">
                + Add Charge
              </button>
            </div>
          </div>
          <div class="px-6 py-4">
            <% if @pending_charges.any? %>
              <div class="space-y-3 mb-4">
                <% @pending_charges.each do |charge| %>
                  <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <div>
                      <p class="text-sm font-medium text-gray-900"><%= charge[:description] %></p>
                      <p class="text-xs text-gray-500"><%= charge[:date] %></p>
                    </div>
                    <p class="text-sm font-medium text-gray-900">$<%= number_with_delimiter(charge[:amount]) %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <div id="additional-charges" class="space-y-3">
              <p class="text-sm text-gray-500 italic">No additional charges</p>
            </div>
            
            <div id="charge-template" class="hidden">
              <div class="charge-row grid grid-cols-3 gap-3 items-end">
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Description</label>
                  <input type="text" name="charges[][description]" placeholder="e.g., Minibar, Late checkout" 
                         class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Amount</label>
                  <div class="relative">
                    <span class="absolute left-3 top-2 text-gray-500">$</span>
                    <input type="number" name="charges[][amount]" step="0.01" min="0" placeholder="0.00"
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                </div>
                <div>
                  <button type="button" onclick="removeChargeRow(this)" class="px-3 py-2 text-sm text-red-600 hover:text-red-800">
                    Remove
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Payment Collection -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Payment Collection</h2>
          </div>
          <div class="px-6 py-4">
            <% if @balance_due > 0 %>
              <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                <div class="flex">
                  <svg class="h-5 w-5 text-yellow-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-yellow-800">
                      Outstanding Balance: $<%= number_with_delimiter(@balance_due) %>
                    </p>
                    <p class="text-xs text-yellow-700 mt-1">
                      Please collect payment before completing check-out
                    </p>
                  </div>
                </div>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="payment_method" class="block text-sm font-medium text-gray-700 mb-1">
                    Payment Method
                  </label>
                  <select name="payment_method" id="payment_method" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="">Select method...</option>
                    <option value="cash">Cash</option>
                    <option value="credit_card">Credit Card</option>
                    <option value="debit_card">Debit Card</option>
                    <option value="room_charge">Room Charge</option>
                  </select>
                </div>
                <div>
                  <label for="payment_amount" class="block text-sm font-medium text-gray-700 mb-1">
                    Amount to Collect
                  </label>
                  <div class="relative">
                    <span class="absolute left-3 top-2 text-gray-500">$</span>
                    <input type="number" name="payment_amount" id="payment_amount" 
                           value="<%= @balance_due %>" 
                           step="0.01" min="0"
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                </div>
              </div>
              
              <div class="mt-4">
                <label class="flex items-center">
                  <input type="checkbox" name="skip_payment" value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                  <span class="ml-2 text-sm text-gray-700">Skip payment collection (bill to account)</span>
                </label>
              </div>
            <% else %>
              <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
                <div class="flex">
                  <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-green-800">
                      No outstanding balance
                    </p>
                    <p class="text-xs text-green-700 mt-1">
                      All charges have been paid in full
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Check-out Notes -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Check-out Notes</h2>
          </div>
          <div class="px-6 py-4">
            <label for="check_out_notes" class="block text-sm font-medium text-gray-700 mb-1">
              Additional Notes (Optional)
            </label>
            <textarea name="check_out_notes" id="check_out_notes" rows="3" 
                      placeholder="Guest feedback, incidents, lost items, etc..."
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
            
            <div class="mt-4 space-y-2">
              <label class="flex items-center">
                <input type="checkbox" name="room_inspected" value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                <span class="ml-2 text-sm text-gray-700">Room has been inspected for damages</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="keys_returned" value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" checked>
                <span class="ml-2 text-sm text-gray-700">Room keys/cards returned</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar (1/3 width) -->
      <div class="space-y-6">
        <!-- Stay Summary -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Stay Summary</h2>
          </div>
          <div class="px-6 py-4">
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-500">Confirmation #</dt>
                <dd class="font-mono text-gray-900"><%= @reservation.confirmation_number %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Check-in</dt>
                <dd class="text-gray-900">
                  <%= @reservation.actual_check_in&.strftime("%b %d") || @reservation.check_in_date.strftime("%b %d") %>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Check-out</dt>
                <dd class="text-gray-900"><%= Date.current.strftime("%b %d") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Total Nights</dt>
                <dd class="text-gray-900">
                  <% if @reservation.actual_check_in %>
                    <%= ((Date.current - @reservation.actual_check_in.to_date).to_i) %> nights
                  <% else %>
                    <%= @reservation.nights_count %> nights
                  <% end %>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Room</dt>
                <dd class="text-gray-900"><%= @reservation.room&.room_number || "N/A" %></dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Final Bill -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Final Bill</h2>
          </div>
          <div class="px-6 py-4">
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-500">Room Charges</dt>
                <dd class="text-gray-900">$<%= number_with_delimiter(@reservation.total_amount) %></dd>
              </div>
              <div id="additional-charges-summary" class="hidden">
                <div class="flex justify-between">
                  <dt class="text-gray-500">Additional Charges</dt>
                  <dd class="text-gray-900">$<span id="additional-total">0</span></dd>
                </div>
              </div>
              <div class="pt-3 border-t border-gray-200 flex justify-between">
                <dt class="font-medium text-gray-900">Total Due</dt>
                <dd class="font-medium text-gray-900">$<span id="total-due"><%= number_with_delimiter(@reservation.total_amount) %></span></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Amount Paid</dt>
                <dd class="text-green-600">$<%= number_with_delimiter(@reservation.paid_amount) %></dd>
              </div>
              <div class="pt-3 border-t border-gray-200 flex justify-between">
                <dt class="font-medium text-gray-900">Balance</dt>
                <dd class="font-medium <%= @balance_due > 0 ? 'text-red-600' : 'text-green-600' %>">
                  $<span id="balance-due"><%= number_with_delimiter(@balance_due) %></span>
                </dd>
              </div>
            </dl>
            
            <div class="mt-4 space-y-2">
              <label class="flex items-center">
                <input type="checkbox" name="email_receipt" value="1" checked class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                <span class="ml-2 text-sm text-gray-700">Email receipt to guest</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="print_receipt" value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                <span class="ml-2 text-sm text-gray-700">Print receipt</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Guest Feedback</h2>
          </div>
          <div class="px-6 py-4">
            <label for="guest_satisfaction" class="block text-sm font-medium text-gray-700 mb-2">
              How was the guest's stay?
            </label>
            <select name="guest_satisfaction" id="guest_satisfaction" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="">Select rating...</option>
              <option value="excellent">Excellent</option>
              <option value="good">Good</option>
              <option value="fair">Fair</option>
              <option value="poor">Poor</option>
            </select>
            
            <div class="mt-3">
              <label class="flex items-center">
                <input type="checkbox" name="request_review" value="1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                <span class="ml-2 text-sm text-gray-700">Send review request</span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class="mt-6 flex items-center justify-between">
      <div>
        <%= link_to "Cancel", reservation_path(@reservation), class: "text-sm text-gray-600 hover:text-gray-900" %>
      </div>
      <div class="flex space-x-3">
        <button type="submit" name="express_checkout" value="1" class="px-6 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
          Express Check-Out
        </button>
        <button type="submit" class="px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Complete Check-Out
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
  function addChargeRow() {
    const template = document.getElementById('charge-template').querySelector('.charge-row').cloneNode(true);
    const container = document.getElementById('additional-charges');
    
    // Remove the "No additional charges" message if it exists
    const emptyMessage = container.querySelector('.text-gray-500');
    if (emptyMessage) {
      emptyMessage.remove();
    }
    
    container.appendChild(template);
    updateTotals();
  }
  
  function removeChargeRow(button) {
    button.closest('.charge-row').remove();
    
    const container = document.getElementById('additional-charges');
    if (container.children.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-500 italic">No additional charges</p>';
    }
    updateTotals();
  }
  
  function updateTotals() {
    const chargeInputs = document.querySelectorAll('input[name="charges[][amount]"]');
    let additionalTotal = 0;
    
    chargeInputs.forEach(input => {
      additionalTotal += parseFloat(input.value) || 0;
    });
    
    const roomCharges = <%= @reservation.total_amount %>;
    const totalDue = roomCharges + additionalTotal;
    const amountPaid = <%= @reservation.paid_amount %>;
    const balance = totalDue - amountPaid;
    
    // Update summary
    if (additionalTotal > 0) {
      document.getElementById('additional-charges-summary').classList.remove('hidden');
      document.getElementById('additional-total').textContent = additionalTotal.toFixed(2);
    } else {
      document.getElementById('additional-charges-summary').classList.add('hidden');
    }
    
    document.getElementById('total-due').textContent = totalDue.toFixed(2);
    document.getElementById('balance-due').textContent = balance.toFixed(2);
    
    // Update payment amount field
    const paymentField = document.getElementById('payment_amount');
    if (paymentField) {
      paymentField.value = Math.max(0, balance).toFixed(2);
    }
  }
  
  // Listen for changes in charge amounts
  document.addEventListener('input', function(e) {
    if (e.target.matches('input[name="charges[][amount]"]')) {
      updateTotals();
    }
  });
</script>