<% content_for :page_title, "Dashboard" %>

<!-- Dashboard Header with Key Metrics -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
  <!-- Today's Arrivals Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600">Today's Arrivals</p>
        <p class="text-2xl font-semibold text-gray-900 mt-1"><%= @todays_check_ins.count %></p>
        <p class="text-xs text-gray-500 mt-1">Expected check-ins</p>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
      </div>
    </div>
    <%= link_to "View all →", reservations_path(filter: 'arrivals'), class: "text-sm text-blue-600 hover:text-blue-700 mt-3 inline-block" %>
  </div>

  <!-- Today's Departures Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600">Today's Departures</p>
        <p class="text-2xl font-semibold text-gray-900 mt-1"><%= @todays_check_outs.count %></p>
        <p class="text-xs text-gray-500 mt-1">Expected check-outs</p>
      </div>
      <div class="p-3 bg-orange-50 rounded-lg">
        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
      </div>
    </div>
    <%= link_to "View all →", reservations_path(filter: 'departures'), class: "text-sm text-orange-600 hover:text-orange-700 mt-3 inline-block" %>
  </div>

  <!-- Occupancy Rate Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600">Occupancy Rate</p>
        <p class="text-2xl font-semibold text-gray-900 mt-1"><%= @occupancy_rate %>%</p>
        <p class="text-xs text-gray-500 mt-1">Currently occupied</p>
      </div>
      <div class="p-3 bg-green-50 rounded-lg">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
    </div>
    <div class="mt-3">
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-green-600 h-2 rounded-full" style="width: <%= @occupancy_rate %>%"></div>
      </div>
    </div>
  </div>

</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Recent Reservations Section (2/3 width) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Recent Reservations</h2>
          <%= link_to "View all", reservations_path, class: "text-sm text-blue-600 hover:text-blue-700" %>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Guest</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Check-in</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @recent_reservations.each do |reservation| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div>
                    <div class="text-sm font-medium text-gray-900">
                      <%= reservation.guest&.full_name || "Guest" %>
                    </div>
                    <div class="text-sm text-gray-500">
                      <%= reservation.confirmation_number %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= reservation.room&.room_number || "TBA" %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= reservation.check_in_date.strftime("%b %d") %>
                  </div>
                  <div class="text-sm text-gray-500">
                    <%= reservation.nights_count %> nights
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= render partial: "shared/status_badge", locals: { status: reservation.status, type: "reservation" } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    $<%= number_with_delimiter(reservation.total_amount) %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", reservation_path(reservation), class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Sidebar -->
  <div class="space-y-6">
    <!-- Room Status Overview -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Room Status</h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
            <span class="text-sm text-gray-600">Available</span>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= @available_rooms %></span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
            <span class="text-sm text-gray-600">Occupied</span>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= @occupied_rooms %></span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <span class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>
            <span class="text-sm text-gray-600">Cleaning</span>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= @cleaning_rooms %></span>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <span class="w-3 h-3 bg-orange-500 rounded-full mr-2"></span>
            <span class="text-sm text-gray-600">Maintenance</span>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= @maintenance_rooms %></span>
        </div>
      </div>
      <% if current_tenant.hotels.any? %>
        <%= link_to "Manage rooms →", hotel_rooms_path(current_tenant.hotels.first), class: "text-sm text-blue-600 hover:text-blue-700 mt-4 inline-block" %>
      <% end %>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
      <div class="space-y-2">
        <%= link_to new_reservation_path, class: "w-full flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          New Reservation
        <% end %>
        
        <%= link_to "#", class: "w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          Walk-in Guest
        <% end %>
        
        <%= link_to "#", class: "w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          Room Assignment
        <% end %>
      </div>
    </div>

    <!-- Today's Activity -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h3>
      <div class="space-y-3">
        <% if @recent_activities.present? %>
          <% @recent_activities.each do |activity| %>
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-<%= activity[:icon_color] %>-100 rounded-full flex items-center justify-center">
                  <% if activity[:type] == 'reservation' %>
                    <svg class="w-4 h-4 text-<%= activity[:icon_color] %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  <% elsif activity[:type] == 'checkin' %>
                    <svg class="w-4 h-4 text-<%= activity[:icon_color] %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4 text-<%= activity[:icon_color] %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="ml-3 flex-1">
                <p class="text-sm text-gray-900"><%= activity[:title] %></p>
                <% if activity[:subtitle].present? %>
                  <p class="text-xs text-gray-600"><%= activity[:subtitle] %></p>
                <% end %>
                <p class="text-xs text-gray-500"><%= activity[:time] %></p>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 italic">No recent activity</p>
        <% end %>
      </div>
    </div>
  </div>
</div>