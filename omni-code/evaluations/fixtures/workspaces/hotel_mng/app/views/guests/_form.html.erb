<%= form_with(model: guest, local: true) do |form| %>
  <% if guest.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(guest.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% guest.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :first_name, 
                  placeholder: "John",
                  required: true,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :last_name, 
                  placeholder: "Doe",
                  required: true,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.email_field :email, 
                  placeholder: "john.doe@example.com",
                  required: true,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.telephone_field :phone, 
                  placeholder: "+1 (555) 123-4567",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :date_of_birth, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.date_field :date_of_birth, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Used for age verification and birthday offers</p>
            </div>
            <div>
              <%= form.label :nationality, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :nationality, 
                  placeholder: "e.g., US, GB, FR",
                  maxlength: 2,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Two-letter country code</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Identification -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Identification</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :passport_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :passport_number, 
                  placeholder: "Optional",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :id_number, "National ID Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :id_number, 
                  placeholder: "Optional",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Address -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Address</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <%= form.label :address, "Street Address", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :address, 
                placeholder: "123 Main Street",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="col-span-2 sm:col-span-1">
              <%= form.label :city, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :city, 
                  placeholder: "New York",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :state, "State/Province", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :state, 
                  placeholder: "NY",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :country, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :country, 
                  placeholder: "US",
                  maxlength: 2,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :postal_code, "ZIP/Postal", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :postal_code, 
                  placeholder: "10001",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Preferences & Notes -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Preferences & Notes</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <div class="flex items-center justify-between mb-2">
              <%= form.label :vip_status, "VIP Status", class: "block text-sm font-medium text-gray-700" %>
              <label class="relative inline-flex items-center cursor-pointer">
                <%= form.check_box :vip_status, class: "sr-only peer" %>
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                <span class="ml-3 text-sm font-medium text-gray-900">Mark as VIP Guest</span>
              </label>
            </div>
            <p class="text-xs text-gray-500">VIP guests receive priority service and special perks</p>
          </div>

          <div>
            <%= form.label :notes, "Internal Notes", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :notes, 
                rows: 4,
                placeholder: "Add any special preferences, requirements, or internal notes about this guest...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            <p class="mt-1 text-xs text-gray-500">These notes are only visible to staff members</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="lg:col-span-1">
      <div class="bg-blue-50 rounded-lg p-6 border border-blue-200">
        <h3 class="text-lg font-semibold text-blue-900 mb-4">Guest Profile Tips</h3>
        <div class="space-y-3 text-sm text-blue-800">
          <div class="flex">
            <svg class="w-5 h-5 mr-2 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <p>Complete profiles help provide personalized service and faster check-ins.</p>
          </div>
          <div class="flex">
            <svg class="w-5 h-5 mr-2 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <p>Email is required for sending booking confirmations and receipts.</p>
          </div>
          <div class="flex">
            <svg class="w-5 h-5 mr-2 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <p>ID information speeds up the check-in process but is optional.</p>
          </div>
          <div class="flex">
            <svg class="w-5 h-5 mr-2 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <p>VIP status is automatically tracked based on stay history.</p>
          </div>
        </div>
        
        <% if guest.persisted? %>
          <div class="mt-6 pt-6 border-t border-blue-200">
            <h4 class="text-sm font-semibold text-blue-900 mb-2">Guest Statistics</h4>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-blue-700">Total Stays:</dt>
                <dd class="font-medium text-blue-900"><%= guest.total_stays %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-blue-700">Total Spent:</dt>
                <dd class="font-medium text-blue-900">$<%= number_with_delimiter(guest.total_spent.to_i) %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-blue-700">Loyalty Status:</dt>
                <dd class="font-medium text-blue-900"><%= guest.loyalty_status %></dd>
              </div>
            </dl>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-end space-x-3">
    <%= link_to "Cancel", guests_path, class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    <%= form.submit guest.persisted? ? "Update Guest" : "Create Guest", 
        class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
  </div>
<% end %>