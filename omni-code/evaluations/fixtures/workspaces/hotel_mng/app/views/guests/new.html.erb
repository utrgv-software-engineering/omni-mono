    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Guests", guests_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Guest</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Create New Guest</h1>
