<% content_for :page_title, @guest.full_name %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to "Guests", guests_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @guest.full_name %></span>
      </nav>
      <div class="flex items-center">
        <h1 class="text-2xl font-bold text-gray-900"><%= @guest.full_name %></h1>
        <% if @guest.vip_status? %>
          <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            VIP Guest
          </span>
        <% end %>
      </div>
      <p class="mt-1 text-sm text-gray-600">Member since <%= @guest.created_at.strftime("%B %Y") %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@guest).edit? %>
        <%= link_to edit_guest_path(@guest), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Guest
        <% end %>
      <% end %>
      <%= link_to new_reservation_path(guest_id: @guest.id), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Reservation
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Guest Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Guest Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Email</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <a href="mailto:<%= @guest.email %>" class="text-blue-600 hover:text-blue-800"><%= @guest.email %></a>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Phone</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @guest.phone || "Not provided" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Date of Birth</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @guest.date_of_birth %>
                  <%= @guest.date_of_birth.strftime("%B %d, %Y") %>
                  <span class="text-gray-500">(<%= @guest.age %> years old)</span>
                <% else %>
                  Not provided
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Nationality</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @guest.nationality || "Not provided" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">ID/Passport</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @guest.passport_number.present? %>
                  Passport: <%= @guest.passport_number %>
                <% elsif @guest.id_number.present? %>
                  ID: <%= @guest.id_number %>
                <% else %>
                  Not provided
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Address</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @guest.complete_address.present? %>
                  <%= @guest.complete_address %>
                <% else %>
                  Not provided
                <% end %>
              </dd>
            </div>
          </dl>
          
          <% if @guest.notes.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Internal Notes</dt>
              <dd class="mt-1 text-sm text-gray-900 bg-yellow-50 rounded-lg p-3">
                <%= simple_format(@guest.notes) %>
              </dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Reservation History -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
          <h2 class="text-lg font-semibold text-gray-900">Reservation History</h2>
          <span class="text-sm text-gray-500"><%= @reservations.count %> total reservations</span>
        </div>
        
        <% if @reservations.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Confirmation
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Hotel
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Dates
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Room
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Total
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @reservations.each do |reservation| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <%= link_to reservation.confirmation_number, reservation_path(reservation), class: "text-blue-600 hover:text-blue-800 font-medium" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= reservation.hotel.name %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= reservation.check_in_date.strftime("%b %d") %> - <%= reservation.check_out_date.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <% if reservation.room %>
                        Room <%= reservation.room.room_number %>
                      <% else %>
                        <%= reservation.room_type.name %>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <%= render 'shared/status_badge', status: reservation.status, type: 'reservation' %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      $<%= number_with_delimiter(reservation.total_amount.to_i) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center text-sm text-gray-500">
            No reservations found for this guest.
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Guest Stats -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Guest Statistics</h3>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Loyalty Status</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @guest.loyalty_status == 'Elite' ? 'bg-yellow-100 text-yellow-800' : @guest.loyalty_status == 'Frequent' ? 'bg-blue-100 text-blue-800' : @guest.loyalty_status == 'Regular' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                <%= @guest.loyalty_status %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Total Stays</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @guest.total_stays %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Total Spent</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">$<%= number_with_delimiter(@guest.total_spent.to_i) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Average Spend</dt>
            <dd class="mt-1 text-lg font-semibold text-gray-900">
              <% if @guest.total_stays > 0 %>
                $<%= number_with_delimiter((@guest.total_spent / @guest.total_stays).to_i) %>
              <% else %>
                $0
              <% end %>
            </dd>
          </div>
        </div>
      </div>

      <!-- Current & Upcoming -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Current & Upcoming</h3>
        </div>
        <div class="px-6 py-4">
          <% if @guest.current_reservation %>
            <div class="mb-4">
              <dt class="text-sm font-medium text-gray-500 mb-2">Currently Checked In</dt>
              <dd class="bg-blue-50 rounded-lg p-3">
                <div class="text-sm font-medium text-blue-900">
                  <%= link_to @guest.current_reservation.confirmation_number, reservation_path(@guest.current_reservation), class: "hover:underline" %>
                </div>
                <div class="text-xs text-blue-700 mt-1">
                  Room <%= @guest.current_reservation.room&.room_number %>
                  <br>
                  Until <%= @guest.current_reservation.check_out_date.strftime("%b %d, %Y") %>
                </div>
              </dd>
            </div>
          <% end %>
          
          <% if @guest.upcoming_reservations.any? %>
            <div>
              <dt class="text-sm font-medium text-gray-500 mb-2">Upcoming Reservations</dt>
              <div class="space-y-2">
                <% @guest.upcoming_reservations.limit(3).each do |reservation| %>
                  <dd class="bg-gray-50 rounded-lg p-3">
                    <div class="text-sm font-medium text-gray-900">
                      <%= link_to reservation.confirmation_number, reservation_path(reservation), class: "hover:underline text-blue-600" %>
                    </div>
                    <div class="text-xs text-gray-600 mt-1">
                      <%= reservation.check_in_date.strftime("%b %d") %> - <%= reservation.check_out_date.strftime("%b %d, %Y") %>
                    </div>
                  </dd>
                <% end %>
              </div>
            </div>
          <% elsif !@guest.current_reservation %>
            <p class="text-sm text-gray-500">No current or upcoming reservations.</p>
          <% end %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Quick Actions</h3>
        </div>
        <div class="px-6 py-4 space-y-2">
          <% if @guest.vip_status? %>
            <%= link_to guests_path(vip_status: false), method: :patch, 
                data: { confirm: "Remove VIP status from #{@guest.full_name}?" },
                class: "w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Remove VIP Status
            <% end %>
          <% else %>
            <%= link_to guest_path(@guest, guest: { vip_status: true }), method: :patch,
                class: "w-full inline-flex items-center justify-center px-4 py-2 border border-purple-300 text-sm font-medium rounded-lg text-purple-700 bg-purple-50 hover:bg-purple-100" do %>
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              Mark as VIP
            <% end %>
          <% end %>
          
          <% if policy(@guest).destroy? %>
            <%= link_to guest_path(@guest), method: :delete,
                data: { confirm: "Are you sure you want to delete this guest profile? This action cannot be undone." },
                class: "w-full inline-flex items-center justify-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Delete Guest
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>