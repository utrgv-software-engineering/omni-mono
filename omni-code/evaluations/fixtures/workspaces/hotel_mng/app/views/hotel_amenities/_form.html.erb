<%= form_with(model: [hotel, hotel_amenity], local: true) do |form| %>
  <% if hotel_amenity.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(hotel_amenity.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% hotel_amenity.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Amenity Configuration</h2>
        </div>
        
        <div class="px-6 py-4 space-y-6">
          <!-- Amenity Selection (only for new) -->
          <% if hotel_amenity.new_record? && available_amenities.present? %>
            <div>
              <%= form.label :amenity_id, "Select Amenity", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :amenity_id,
                  options_for_select(
                    available_amenities.group_by(&:category).map do |category, amenities|
                      [category.humanize, amenities.map { |a| [a.name, a.id] }]
                    end,
                    hotel_amenity.amenity_id
                  ),
                  { prompt: "Choose an amenity..." },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-sm text-gray-500">Select from available amenities not yet added to this hotel</p>
            </div>
          <% else %>
            <!-- Display amenity name for edit -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Amenity</label>
              <div class="px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
                <span class="text-sm text-gray-900"><%= hotel_amenity.amenity.name %></span>
                <span class="text-xs text-gray-500 ml-2">(<%= hotel_amenity.amenity.category.humanize %>)</span>
              </div>
            </div>
          <% end %>

          <!-- Availability Toggle -->
          <div>
            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= form.check_box :is_available, 
                    class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
              </div>
              <div class="ml-3">
                <%= form.label :is_available, class: "block text-sm font-medium text-gray-700" %>
                <p class="text-sm text-gray-500">Uncheck to temporarily make this amenity unavailable</p>
              </div>
            </div>
          </div>

          <!-- Free/Paid Toggle -->
          <div>
            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= form.check_box :is_free, 
                    class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded",
                    onchange: "togglePriceField(this)" %>
              </div>
              <div class="ml-3">
                <%= form.label :is_free, "Free Amenity", class: "block text-sm font-medium text-gray-700" %>
                <p class="text-sm text-gray-500">Check if this amenity is provided at no additional cost</p>
              </div>
            </div>
          </div>

          <!-- Additional Cost -->
          <div id="price-field" class="<%= hotel_amenity.is_free? ? 'hidden' : '' %>">
            <%= form.label :additional_cost, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-gray-500 sm:text-sm">$</span>
              </div>
              <%= form.number_field :additional_cost, 
                  step: 0.01,
                  min: 0,
                  class: "w-full pl-7 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "0.00" %>
            </div>
            <p class="mt-1 text-sm text-gray-500">Cost per use or per day (depending on amenity type)</p>
          </div>

          <!-- Location -->
          <div>
            <%= form.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :location, 
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "e.g., Lobby, 3rd Floor, Pool Area" %>
            <p class="mt-1 text-sm text-gray-500">Where guests can find or access this amenity</p>
          </div>

          <!-- Operating Hours -->
          <div>
            <%= form.label :operating_hours, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :operating_hours, 
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "e.g., 24/7, 6:00 AM - 10:00 PM, Mon-Fri 9-5" %>
            <p class="mt-1 text-sm text-gray-500">Leave blank for always available</p>
          </div>

          <!-- Notes -->
          <div>
            <%= form.label :notes, "Additional Notes", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :notes, 
                rows: 3,
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Any special instructions, restrictions, or additional information" %>
            <p class="mt-1 text-sm text-gray-500">Internal notes or guest-facing information about this amenity</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Quick Tips -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-900">Quick Tips</h3>
        </div>
        <div class="px-6 py-4">
          <ul class="space-y-3 text-xs text-gray-600">
            <li class="flex items-start">
              <svg class="w-4 h-4 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Mark amenities as unavailable during maintenance or seasonal closures</span>
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Specify costs for premium amenities like spa services or equipment rental</span>
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Include operating hours for time-restricted amenities</span>
            </li>
            <li class="flex items-start">
              <svg class="w-4 h-4 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>Add location details to help guests find the amenity</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Common Settings -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 mt-6">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-900">Common Settings</h3>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-2 text-xs">
            <button type="button" 
                    onclick="applyPreset('free-always')"
                    class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded text-gray-700">
              Free & Always Available
            </button>
            <button type="button" 
                    onclick="applyPreset('business-hours')"
                    class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded text-gray-700">
              Business Hours Only
            </button>
            <button type="button" 
                    onclick="applyPreset('premium')"
                    class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded text-gray-700">
              Premium Service
            </button>
            <button type="button" 
                    onclick="applyPreset('seasonal')"
                    class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded text-gray-700">
              Seasonal Amenity
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex justify-end space-x-3">
    <%= link_to "Cancel", hotel_hotel_amenities_path(hotel), 
        class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit hotel_amenity.persisted? ? "Update Amenity" : "Add Amenity",
        class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
  </div>
<% end %>

<script>
  function togglePriceField(checkbox) {
    const priceField = document.getElementById('price-field');
    if (checkbox.checked) {
      priceField.classList.add('hidden');
    } else {
      priceField.classList.remove('hidden');
    }
  }
  
  function applyPreset(preset) {
    const form = document.querySelector('form');
    
    switch(preset) {
      case 'free-always':
        form.querySelector('#hotel_amenity_is_available').checked = true;
        form.querySelector('#hotel_amenity_is_free').checked = true;
        form.querySelector('#hotel_amenity_operating_hours').value = '24/7';
        togglePriceField(form.querySelector('#hotel_amenity_is_free'));
        break;
      case 'business-hours':
        form.querySelector('#hotel_amenity_is_available').checked = true;
        form.querySelector('#hotel_amenity_operating_hours').value = '9:00 AM - 5:00 PM';
        break;
      case 'premium':
        form.querySelector('#hotel_amenity_is_available').checked = true;
        form.querySelector('#hotel_amenity_is_free').checked = false;
        togglePriceField(form.querySelector('#hotel_amenity_is_free'));
        break;
      case 'seasonal':
        form.querySelector('#hotel_amenity_is_available').checked = false;
        form.querySelector('#hotel_amenity_notes').value = 'Seasonal availability - check with front desk';
        break;
    }
  }
</script>