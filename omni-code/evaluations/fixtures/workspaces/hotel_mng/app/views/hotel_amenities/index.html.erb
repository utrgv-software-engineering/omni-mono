<% content_for :page_title, "#{@hotel.name} - Amenities" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Amenities</span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Hotel Amenities</h1>
      <p class="mt-1 text-sm text-gray-600">Manage amenities offered at <%= @hotel.name %></p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(HotelAmenity).new? %>
        <%= link_to new_hotel_hotel_amenity_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Amenity
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @hotel_amenities.any? %>
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500">Available</p>
            <p class="text-lg font-semibold text-gray-900"><%= @hotel_amenities.available.count %></p>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500">Free</p>
            <p class="text-lg font-semibold text-gray-900"><%= @hotel_amenities.free.count %></p>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500">Paid</p>
            <p class="text-lg font-semibold text-gray-900"><%= @hotel_amenities.paid.count %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Amenities Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @hotel_amenities.each do |hotel_amenity| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <div class="p-4">
            <div class="flex items-start justify-between">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-gray-900">
                    <%= link_to hotel_amenity.amenity.name, hotel_hotel_amenity_path(@hotel, hotel_amenity), class: "hover:text-indigo-600" %>
                  </h3>
                  <p class="text-xs text-gray-500"><%= hotel_amenity.amenity.category.humanize %></p>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <% if hotel_amenity.is_available? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                    Available
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                    Unavailable
                  </span>
                <% end %>
              </div>
            </div>
            
            <div class="mt-3 space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500">Price:</span>
                <span class="font-medium <%= hotel_amenity.is_free? ? 'text-green-600' : 'text-gray-900' %>">
                  <%= hotel_amenity.display_price %>
                </span>
              </div>
              
              <% if hotel_amenity.operating_hours.present? %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500">Hours:</span>
                  <span class="text-gray-900"><%= hotel_amenity.formatted_operating_hours %></span>
                </div>
              <% end %>
              
              <% if hotel_amenity.location.present? %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500">Location:</span>
                  <span class="text-gray-900"><%= hotel_amenity.location %></span>
                </div>
              <% end %>
            </div>
            
            <% if hotel_amenity.notes.present? %>
              <div class="mt-3 pt-3 border-t border-gray-100">
                <p class="text-xs text-gray-600 line-clamp-2"><%= hotel_amenity.notes %></p>
              </div>
            <% end %>
            
            <!-- Quick Toggle -->
            <div class="mt-3 pt-3 border-t border-gray-100">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <input type="checkbox" 
                         <%= "checked" if hotel_amenity.is_available? %>
                         class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                         data-amenity-id="<%= hotel_amenity.id %>"
                         onchange="toggleAvailability(this)">
                  <label class="ml-2 text-xs text-gray-600">Available</label>
                </div>
                <div class="flex space-x-2">
                  <%= link_to "Edit", edit_hotel_hotel_amenity_path(@hotel, hotel_amenity), 
                      class: "text-xs text-indigo-600 hover:text-indigo-800" %>
                  <% if policy(hotel_amenity).destroy? %>
                    <%= link_to "Remove", hotel_hotel_amenity_path(@hotel, hotel_amenity), 
                        method: :delete,
                        data: { confirm: "Remove this amenity from the hotel?" },
                        class: "text-xs text-red-600 hover:text-red-800" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="text-center py-12 px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No amenities added</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by adding amenities to this hotel.</p>
        <% if policy(HotelAmenity).new? %>
          <div class="mt-6">
            <%= link_to new_hotel_hotel_amenity_path(@hotel), class: "inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add First Amenity
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  function toggleAvailability(checkbox) {
    // This would need proper Rails UJS or Stimulus implementation
    console.log('Toggle availability for amenity:', checkbox.dataset.amenityId);
  }
</script>