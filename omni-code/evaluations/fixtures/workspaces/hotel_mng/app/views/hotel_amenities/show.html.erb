<% content_for :page_title, "#{@hotel_amenity.amenity.name} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <%= link_to "Amenities", hotel_hotel_amenities_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @hotel_amenity.amenity.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @hotel_amenity.amenity.name %></h1>
      <div class="mt-1 flex items-center space-x-3">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <%= @hotel_amenity.amenity.category.humanize %>
        </span>
        <% if @hotel_amenity.is_available? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Available
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
            Unavailable
          </span>
        <% end %>
        <% if @hotel_amenity.is_free? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Free
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
            Paid
          </span>
        <% end %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@hotel_amenity).edit? %>
        <%= link_to edit_hotel_hotel_amenity_path(@hotel, @hotel_amenity), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if policy(@hotel_amenity).destroy? %>
        <%= link_to hotel_hotel_amenity_path(@hotel, @hotel_amenity), method: :delete,
            data: { confirm: "Are you sure you want to remove this amenity from the hotel?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Remove
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Amenity Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Amenity Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.amenity.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Category</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.amenity.category.humanize %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Availability</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @hotel_amenity.is_available? ? "Currently Available" : "Currently Unavailable" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Pricing</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @hotel_amenity.display_price %>
                <% if @hotel_amenity.additional_cost.present? && !@hotel_amenity.is_free? %>
                  <span class="text-gray-500">(per use/day)</span>
                <% end %>
              </dd>
            </div>
            <% if @hotel_amenity.location.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Location</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.location %></dd>
              </div>
            <% end %>
            <% if @hotel_amenity.operating_hours.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Operating Hours</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.formatted_operating_hours %></dd>
              </div>
            <% end %>
          </dl>
          
          <% if @hotel_amenity.amenity.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Amenity Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.amenity.description %></dd>
            </div>
          <% end %>
          
          <% if @hotel_amenity.notes.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Additional Notes</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel_amenity.notes %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Status Toggle -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Status Management</h2>
        </div>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-medium text-gray-900">Availability Status</h3>
              <p class="text-sm text-gray-500">Toggle to make this amenity available or unavailable to guests</p>
            </div>
            <button type="button" 
                    class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 <%= @hotel_amenity.is_available? ? 'bg-indigo-600' : 'bg-gray-200' %>"
                    role="switch"
                    aria-checked="<%= @hotel_amenity.is_available? %>">
              <span class="pointer-events-none relative inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out <%= @hotel_amenity.is_available? ? 'translate-x-5' : 'translate-x-0' %>"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Info -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Info</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Status</dt>
              <dd class="text-sm font-medium">
                <% if @hotel_amenity.is_available? %>
                  <span class="text-green-600">Available</span>
                <% else %>
                  <span class="text-gray-600">Unavailable</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Type</dt>
              <dd class="text-sm font-medium text-gray-900">
                <%= @hotel_amenity.is_free? ? "Free" : "Paid" %>
              </dd>
            </div>
            <% if !@hotel_amenity.is_free? && @hotel_amenity.additional_cost.present? %>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Cost</dt>
                <dd class="text-sm font-medium text-gray-900">
                  $<%= number_with_delimiter(@hotel_amenity.additional_cost) %>
                </dd>
              </div>
            <% end %>
            <% if @hotel_amenity.currently_open? %>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Current Status</dt>
                <dd class="text-sm font-medium text-green-600">Open</dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Related Amenities -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Related Amenities</h2>
        </div>
        <div class="px-6 py-4">
          <% related = @hotel.hotel_amenities.joins(:amenity)
                          .where(amenities: { category: @hotel_amenity.amenity.category })
                          .where.not(id: @hotel_amenity.id)
                          .limit(5) %>
          <% if related.any? %>
            <ul class="space-y-2">
              <% related.each do |amenity| %>
                <li>
                  <%= link_to hotel_hotel_amenity_path(@hotel, amenity), class: "flex items-center justify-between text-sm hover:bg-gray-50 -mx-2 px-2 py-1 rounded" do %>
                    <span class="text-gray-900"><%= amenity.amenity.name %></span>
                    <span class="text-gray-500"><%= amenity.display_price %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No related amenities in this category</p>
          <% end %>
        </div>
      </div>

      <!-- Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Added</dt>
              <dd class="text-gray-900"><%= @hotel_amenity.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Last Updated</dt>
              <dd class="text-gray-900"><%= @hotel_amenity.updated_at.strftime("%b %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>