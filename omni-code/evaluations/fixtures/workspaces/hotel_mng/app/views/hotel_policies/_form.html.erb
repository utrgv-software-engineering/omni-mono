<%= form_with model: [hotel, hotel_policy], local: true do |form| %>
  <% if hotel_policy.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(hotel_policy.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% hotel_policy.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Policy Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Policy Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <%= form.label :policy_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :policy_type, 
                options_for_select(HotelPolicy::POLICY_TYPES.map { |type| [type.humanize, type] }, hotel_policy.policy_type),
                { prompt: "Select a policy type" },
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">Choose the type of policy this applies to</p>
          </div>
          
          <div>
            <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :title, 
                placeholder: "e.g., Check-in Time, Pet Policy, Cancellation Terms",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">A clear, concise title for this policy</p>
          </div>
          
          <div>
            <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, 
                rows: 6,
                placeholder: "Enter the full policy details here...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">Provide comprehensive details about this policy</p>
          </div>
        </div>
      </div>

      <!-- Display Settings -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Display Settings</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <%= form.label :sort_order, "Display Order", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :sort_order, 
                min: 0,
                placeholder: "0",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">Lower numbers appear first. Policies with the same number are sorted by creation date.</p>
          </div>
          
          <div>
            <div class="flex items-center">
              <%= form.check_box :is_active, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
              <%= form.label :is_active, "Active", class: "ml-2 block text-sm text-gray-900" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 ml-6">Active policies are displayed to guests and staff</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Hotel</dt>
              <dd class="text-gray-900 font-medium"><%= hotel.name %></dd>
            </div>
            <% if hotel_policy.persisted? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Status</dt>
                <dd class="text-gray-900">
                  <% if hotel_policy.is_active %>
                    <span class="text-green-600">Active</span>
                  <% else %>
                    <span class="text-gray-600">Inactive</span>
                  <% end %>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Created</dt>
                <dd class="text-gray-900"><%= hotel_policy.created_at.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Last Updated</dt>
                <dd class="text-gray-900"><%= hotel_policy.updated_at.strftime("%b %d, %Y") %></dd>
              </div>
            <% else %>
              <div class="text-gray-500 italic">
                New policy will be created
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Policy Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc pl-5 space-y-1">
                <li>Keep policies clear and concise</li>
                <li>Use simple language guests can understand</li>
                <li>Group similar policies by type</li>
                <li>Review and update policies regularly</li>
                <li>Consider legal requirements for your location</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel_hotel_policies_path(hotel), class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <%= form.submit class: "px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>
<% end %>