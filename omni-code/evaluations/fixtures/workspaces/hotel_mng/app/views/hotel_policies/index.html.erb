<% content_for :page_title, "Hotel Policies - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Hotel Policies</span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Hotel Policies</h1>
      <p class="mt-1 text-sm text-gray-600">Manage policies and rules for <%= @hotel.name %></p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(HotelPolicy).new? %>
        <%= link_to new_hotel_hotel_policy_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Policy
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Policy Categories -->
  <% if @hotel_policies.any? %>
    <% policy_groups = @hotel_policies.group_by(&:policy_type) %>
    <% HotelPolicy::POLICY_TYPES.each do |policy_type| %>
      <% policies = policy_groups[policy_type] || [] %>
      
      <div class="mb-6">
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h2 class="text-lg font-semibold text-gray-900 capitalize">
              <%= policy_type.humanize %> Policies
            </h2>
          </div>
          
          <% if policies.any? %>
            <div class="divide-y divide-gray-200">
              <% policies.each do |hotel_policy| %>
                <div class="px-6 py-4 hover:bg-gray-50">
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <div class="flex items-center">
                        <h3 class="text-base font-medium text-gray-900">
                          <%= link_to hotel_policy.title, hotel_hotel_policy_path(@hotel, hotel_policy), class: "hover:text-indigo-600" %>
                        </h3>
                        <% if hotel_policy.is_active %>
                          <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Active
                          </span>
                        <% else %>
                          <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            Inactive
                          </span>
                        <% end %>
                        <span class="ml-2 text-sm text-gray-500">
                          Sort order: <%= hotel_policy.sort_order %>
                        </span>
                      </div>
                      <p class="mt-1 text-sm text-gray-600"><%= hotel_policy.description %></p>
                    </div>
                    <div class="ml-4 flex items-center space-x-2">
                      <% if policy(hotel_policy).edit? %>
                        <% if hotel_policy.is_active %>
                          <%= link_to hotel_hotel_policy_path(@hotel, hotel_policy), method: :patch,
                              data: { params: { hotel_policy: { is_active: false } }.to_param },
                              class: "text-gray-600 hover:text-gray-900" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                          <% end %>
                        <% else %>
                          <%= link_to hotel_hotel_policy_path(@hotel, hotel_policy), method: :patch,
                              data: { params: { hotel_policy: { is_active: true } }.to_param },
                              class: "text-green-600 hover:text-green-900" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                          <% end %>
                        <% end %>
                        
                        <%= link_to edit_hotel_hotel_policy_path(@hotel, hotel_policy), class: "text-indigo-600 hover:text-indigo-900" do %>
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                          </svg>
                        <% end %>
                      <% end %>
                      
                      <% if policy(hotel_policy).destroy? %>
                        <%= link_to hotel_hotel_policy_path(@hotel, hotel_policy), method: :delete,
                            data: { confirm: "Are you sure you want to delete this policy?" },
                            class: "text-red-600 hover:text-red-900" do %>
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                          </svg>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-6 py-8 text-center">
              <p class="text-sm text-gray-500">No <%= policy_type.humanize.downcase %> policies defined yet.</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No policies</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating your first hotel policy.</p>
        <div class="mt-6">
          <% if policy(HotelPolicy).new? %>
            <%= link_to new_hotel_hotel_policy_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Policy
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>