<% content_for :page_title, "New Hotel Policy - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Hotel Policies", hotel_hotel_policies_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Policy</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">New Hotel Policy</h1>
    <p class="mt-1 text-sm text-gray-600">Add a new policy for <%= @hotel.name %></p>
  </div>

  <%= render "form", hotel_policy: @hotel_policy, hotel: @hotel %>
</div>