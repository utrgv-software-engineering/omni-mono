<% content_for :page_title, "#{@hotel_policy.title} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <%= link_to "Hotel Policies", hotel_hotel_policies_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @hotel_policy.title %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @hotel_policy.title %></h1>
      <div class="mt-1 flex items-center space-x-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <%= @hotel_policy.policy_type.humanize %>
        </span>
        <% if @hotel_policy.is_active %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Active
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
            Inactive
          </span>
        <% end %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@hotel_policy).edit? %>
        <% if @hotel_policy.is_active %>
          <%= link_to hotel_hotel_policy_path(@hotel, @hotel_policy), method: :patch,
              data: { params: { hotel_policy: { is_active: false } }.to_param },
              class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Deactivate
          <% end %>
        <% else %>
          <%= link_to hotel_hotel_policy_path(@hotel, @hotel_policy), method: :patch,
              data: { params: { hotel_policy: { is_active: true } }.to_param },
              class: "inline-flex items-center px-4 py-2 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Activate
          <% end %>
        <% end %>
        
        <%= link_to edit_hotel_hotel_policy_path(@hotel, @hotel_policy), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if policy(@hotel_policy).destroy? %>
        <%= link_to hotel_hotel_policy_path(@hotel, @hotel_policy), method: :delete,
            data: { confirm: "Are you sure you want to delete this policy?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Policy Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Policy Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Title</dt>
              <dd class="mt-1 text-base text-gray-900"><%= @hotel_policy.title %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Policy Type</dt>
              <dd class="mt-1 text-base text-gray-900"><%= @hotel_policy.policy_type.humanize %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-base text-gray-900 whitespace-pre-wrap"><%= @hotel_policy.description %></dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Related Policies -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Other <%= @hotel_policy.policy_type.humanize %> Policies</h2>
        </div>
        <% related_policies = @hotel.hotel_policies.by_type(@hotel_policy.policy_type).where.not(id: @hotel_policy.id).ordered %>
        <% if related_policies.any? %>
          <div class="divide-y divide-gray-200">
            <% related_policies.each do |policy| %>
              <div class="px-6 py-4">
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <h4 class="text-sm font-medium text-gray-900">
                      <%= link_to policy.title, hotel_hotel_policy_path(@hotel, policy), class: "hover:text-indigo-600" %>
                    </h4>
                    <p class="mt-1 text-sm text-gray-500 truncate"><%= policy.description %></p>
                  </div>
                  <div class="ml-4">
                    <% if policy.is_active %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        Active
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        Inactive
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center">
            <p class="text-sm text-gray-500">No other <%= @hotel_policy.policy_type.humanize.downcase %> policies defined.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Status</dt>
              <dd class="text-gray-900 font-medium">
                <% if @hotel_policy.is_active %>
                  <span class="text-green-600">Active</span>
                <% else %>
                  <span class="text-gray-600">Inactive</span>
                <% end %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Sort Order</dt>
              <dd class="text-gray-900"><%= @hotel_policy.sort_order %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Hotel</dt>
              <dd class="text-gray-900"><%= @hotel.name %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Created</dt>
              <dd class="text-gray-900"><%= @hotel_policy.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Last Updated</dt>
              <dd class="text-gray-900"><%= @hotel_policy.updated_at.strftime("%b %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-2">
          <% if policy(@hotel_policy).edit? %>
            <%= link_to edit_hotel_hotel_policy_path(@hotel, @hotel_policy), class: "w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit Policy
            <% end %>
          <% end %>
          
          <% if policy(HotelPolicy).new? %>
            <%= link_to new_hotel_hotel_policy_path(@hotel), class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add New Policy
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>