<%= form_with(model: hotel, local: true) do |form| %>
  <% if hotel.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(hotel.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% hotel.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="hotel_name" class="block text-sm font-medium text-gray-700 mb-1">
                Hotel Name <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :name, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., Grand Hotel Downtown" %>
            </div>

            <div>
              <label for="hotel_subdomain" class="block text-sm font-medium text-gray-700 mb-1">
                Subdomain <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :subdomain, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., grand-downtown" %>
              <p class="mt-1 text-xs text-gray-500">Used for hotel-specific URLs</p>
            </div>
          </div>

          <div>
            <label for="hotel_star_rating" class="block text-sm font-medium text-gray-700 mb-1">
              Star Rating
            </label>
            <%= form.select :star_rating, 
                options_for_select((1..5).map { |i| ["#{i} Star#{'s' if i > 1}", i] }, hotel.star_rating),
                { include_blank: "Select rating..." },
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
          </div>

          <div>
            <label for="hotel_description" class="block text-sm font-medium text-gray-700 mb-1">
              Description
            </label>
            <%= form.text_area :description, 
                rows: 4,
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Describe your hotel's unique features and amenities..." %>
          </div>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Contact Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="hotel_phone" class="block text-sm font-medium text-gray-700 mb-1">
                Phone Number <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :phone, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., +1 (555) 123-4567" %>
            </div>

            <div>
              <label for="hotel_email" class="block text-sm font-medium text-gray-700 mb-1">
                Email Address <span class="text-red-500">*</span>
              </label>
              <%= form.email_field :email, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., info@grandhotel.com" %>
            </div>
          </div>

          <div>
            <label for="hotel_website" class="block text-sm font-medium text-gray-700 mb-1">
              Website
            </label>
            <%= form.text_field :website, 
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "e.g., https://www.grandhotel.com" %>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Location</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <label for="hotel_address" class="block text-sm font-medium text-gray-700 mb-1">
              Street Address <span class="text-red-500">*</span>
            </label>
            <%= form.text_field :address, 
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "e.g., 123 Main Street" %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label for="hotel_city" class="block text-sm font-medium text-gray-700 mb-1">
                City <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :city, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., New York" %>
            </div>

            <div>
              <label for="hotel_state" class="block text-sm font-medium text-gray-700 mb-1">
                State/Province <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :state, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., NY" %>
            </div>

            <div>
              <label for="hotel_postal_code" class="block text-sm font-medium text-gray-700 mb-1">
                Postal Code <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :postal_code, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., 10001" %>
            </div>
          </div>

          <div>
            <label for="hotel_country" class="block text-sm font-medium text-gray-700 mb-1">
              Country <span class="text-red-500">*</span>
            </label>
            <%= form.text_field :country, 
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "e.g., United States" %>
          </div>
        </div>
      </div>

      <!-- AI Features -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">AI Features</h2>
          <p class="mt-1 text-sm text-gray-600">Enable AI-powered features for your hotel</p>
        </div>
        <div class="px-6 py-4 space-y-4">
          <% AiDeployments.hotel_deployments.each do |key, deployment| %>
            <% setting = hotel.hotel_ai_settings.find_or_initialize_by(deployment_key: key) %>
            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= check_box_tag "ai_settings[#{key}]", "1", setting.enabled, 
                    class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded",
                    id: "ai_setting_#{key}" %>
              </div>
              <div class="ml-3">
                <label for="ai_setting_<%= key %>" class="font-medium text-gray-700">
                  <%= deployment[:name] %>
                </label>
                <% if key.to_s == 'web_chat' %>
                  <p class="text-sm text-gray-500">Enable AI-powered chat for guest support on your public website</p>
                <% end %>
              </div>
            </div>
          <% end %>
          
          <% if AiDeployments.hotel_deployments.empty? %>
            <p class="text-sm text-gray-500 italic">No AI features available for configuration</p>
          <% end %>
        </div>
      </div>

      <!-- Operating Settings -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Operating Settings</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="hotel_check_in_time" class="block text-sm font-medium text-gray-700 mb-1">
                Check-in Time
              </label>
              <%= form.time_field :check_in_time, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Standard check-in time for guests</p>
            </div>

            <div>
              <label for="hotel_check_out_time" class="block text-sm font-medium text-gray-700 mb-1">
                Check-out Time
              </label>
              <%= form.time_field :check_out_time, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Standard check-out time for guests</p>
            </div>
          </div>

          <div>
            <label for="hotel_timezone" class="block text-sm font-medium text-gray-700 mb-1">
              Timezone <span class="text-red-500">*</span>
            </label>
            <%= form.select :timezone, 
                options_for_select(ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] }, hotel.timezone),
                {},
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
            <p class="mt-1 text-xs text-gray-500">Used for all date and time displays</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Current Status -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Current Status</h3>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-gray-500">Total Rooms</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= hotel.rooms.count %> rooms</dd>
            </div>
            <div>
              <dt class="text-gray-500">Room Types</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= hotel.room_types.count %> types</dd>
            </div>
            <div>
              <dt class="text-gray-500">Current Occupancy</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= hotel.occupancy_rate %>%</dd>
            </div>
            <div>
              <dt class="text-gray-500">Active Reservations</dt>
              <dd class="mt-1 font-medium text-gray-900">
                <%= hotel.reservations.where(status: ['confirmed', 'checked_in']).count %> reservations
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Configuration Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc space-y-1 pl-5">
                <li>Subdomain must be unique within your account</li>
                <li>Timezone affects all date/time displays</li>
                <li>Check-in/out times are defaults for reservations</li>
                <li>Contact info appears on guest confirmations</li>
                <li>Star rating helps with guest expectations</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Important Notice -->
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mt-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">Important</h3>
            <div class="mt-2 text-sm text-yellow-700">
              <p>Changes to hotel settings will affect all future reservations and guest communications.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel.persisted? ? hotel_path(hotel) : hotels_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <%= form.submit hotel.persisted? ? "Save Changes" : "Create Hotel", 
          class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
    </div>
  </div>
<% end %>