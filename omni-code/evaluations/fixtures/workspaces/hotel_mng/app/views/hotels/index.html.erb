<% content_for :page_title, "Hotels - #{current_tenant.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Hotels</h1>
      <p class="mt-1 text-sm text-gray-600">Manage your hotel properties and settings</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(Hotel).new? %>
        <%= link_to new_hotel_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Hotel
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Hotels Grid -->
  <% if @hotels.any? %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @hotels.each do |hotel| %>
        <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
          <div class="px-6 py-5">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900">
                  <%= link_to hotel.name, hotel_path(hotel), class: "hover:text-indigo-600" %>
                </h3>
                <% if hotel.star_rating %>
                  <div class="mt-1 flex items-center">
                    <% hotel.star_rating.to_i.times do %>
                      <svg class="h-4 w-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    <% end %>
                    <span class="ml-2 text-sm text-gray-600"><%= hotel.star_rating %> star</span>
                  </div>
                <% end %>
              </div>
              <% if hotel == current_hotel %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Active
                </span>
              <% end %>
            </div>
            
            <div class="mt-4 space-y-2 text-sm text-gray-600">
              <div class="flex items-start">
                <svg class="h-4 w-4 mr-2 mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <div class="flex-1">
                  <%= hotel.address %><br>
                  <%= hotel.city %>, <%= hotel.state %> <%= hotel.postal_code %><br>
                  <%= hotel.country %>
                </div>
              </div>
              
              <div class="flex items-center">
                <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <%= hotel.phone %>
              </div>
              
              <div class="flex items-center">
                <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <%= mail_to hotel.email, hotel.email, class: "hover:text-indigo-600" %>
              </div>
              
              <% if hotel.website.present? %>
                <div class="flex items-center">
                  <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                  </svg>
                  <%= link_to hotel.website, hotel.website, target: "_blank", class: "hover:text-indigo-600" %>
                </div>
              <% end %>
            </div>
            
            <!-- Hotel Stats -->
            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-xs font-medium text-gray-500">Total Rooms</dt>
                  <dd class="mt-1 text-lg font-semibold text-gray-900">
                    <%= hotel.total_rooms || hotel.rooms.count %>
                  </dd>
                </div>
                <div>
                  <dt class="text-xs font-medium text-gray-500">Occupancy</dt>
                  <dd class="mt-1 text-lg font-semibold text-gray-900">
                    <%= hotel.occupancy_rate %>%
                  </dd>
                </div>
              </div>
            </div>
            
            <!-- Actions -->
            <div class="mt-6 flex space-x-3">
              <%= link_to "View", hotel_path(hotel), 
                  class: "flex-1 text-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              <% if policy(hotel).edit? %>
                <%= link_to "Settings", edit_hotel_path(hotel), 
                    class: "flex-1 text-center px-3 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              <% end %>
            </div>
            
            <% if hotel != current_hotel %>
              <div class="mt-3">
                <%= form_with url: set_current_hotel_path, method: :post, local: false do |f| %>
                  <%= f.hidden_field :hotel_id, value: hotel.id %>
                  <%= f.submit "Set as Active", 
                      class: "w-full px-3 py-2 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="text-center py-12 px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No hotels found</h3>
        <p class="mt-1 text-sm text-gray-500">No hotel properties have been added to this account yet.</p>
        <p class="mt-4 text-sm text-gray-500">Contact your administrator to add hotel properties.</p>
      </div>
    </div>
  <% end %>
</div>