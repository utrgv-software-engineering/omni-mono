<% content_for :page_title, "Add New Hotel" %>

<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Hotels", hotels_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Hotel</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Add New Hotel</h1>
    <p class="mt-1 text-sm text-gray-600">Add a new hotel property to your account</p>
  </div>

  <%= render 'form', hotel: @hotel %>
</div>