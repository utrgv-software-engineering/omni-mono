<% content_for :page_title, "#{@hotel.name} - Hotel Details" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to "Hotels", hotels_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @hotel.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @hotel.name %></h1>
      <div class="mt-1 flex items-center space-x-4">
        <% if @hotel.star_rating %>
          <div class="flex items-center">
            <% @hotel.star_rating.to_i.times do %>
              <svg class="h-5 w-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            <% end %>
            <span class="ml-2 text-sm text-gray-600"><%= @hotel.star_rating %> star hotel</span>
          </div>
        <% end %>
        <% if @hotel == current_hotel %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Currently Active
          </span>
        <% end %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if @hotel != current_hotel %>
        <%= form_with url: set_current_hotel_path, method: :post, local: false, class: "inline" do |f| %>
          <%= f.hidden_field :hotel_id, value: @hotel.id %>
          <%= f.submit "Set as Active", 
              class: "inline-flex items-center px-4 py-2 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
        <% end %>
      <% end %>
      <% if policy(@hotel).edit? %>
        <%= link_to edit_hotel_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Settings
        <% end %>
      <% end %>
      <% if policy(@hotel).destroy? && !@hotel.reservations.exists? %>
        <%= link_to hotel_path(@hotel), method: :delete,
            data: { confirm: "Are you sure you want to delete #{@hotel.name}? This action cannot be undone." },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete Hotel
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-sm font-medium text-gray-500 truncate">Total Rooms</dt>
        <dd class="mt-1 text-3xl font-semibold text-gray-900">
          <%= @hotel.total_rooms || @hotel.rooms.count %>
        </dd>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-sm font-medium text-gray-500 truncate">Room Types</dt>
        <dd class="mt-1 text-3xl font-semibold text-gray-900">
          <%= @hotel.room_types.count %>
        </dd>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-sm font-medium text-gray-500 truncate">Current Occupancy</dt>
        <dd class="mt-1 text-3xl font-semibold text-gray-900">
          <%= @hotel.occupancy_rate %>%
        </dd>
        <% occupancy_color = @hotel.occupancy_rate >= 80 ? 'bg-green-500' : (@hotel.occupancy_rate >= 50 ? 'bg-yellow-500' : 'bg-red-500') %>
        <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
          <div class="<%= occupancy_color %> h-2 rounded-full" style="width: <%= @hotel.occupancy_rate %>%"></div>
        </div>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-sm font-medium text-gray-500 truncate">Active Reservations</dt>
        <dd class="mt-1 text-3xl font-semibold text-gray-900">
          <%= @hotel.reservations.where(status: ['confirmed', 'checked_in']).count %>
        </dd>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Hotel Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Hotel Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Hotel Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Subdomain</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <code class="px-2 py-1 bg-gray-100 rounded text-xs"><%= @hotel.subdomain %></code>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Phone</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel.phone %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Email</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= mail_to @hotel.email, @hotel.email, class: "text-indigo-600 hover:text-indigo-500" %>
              </dd>
            </div>
            <% if @hotel.website.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Website</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= link_to @hotel.website, @hotel.website, target: "_blank", class: "text-indigo-600 hover:text-indigo-500" %>
                </dd>
              </div>
            <% end %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Timezone</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @hotel.timezone %></dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Location -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Location</h2>
        </div>
        <div class="px-6 py-4">
          <div class="text-sm text-gray-900">
            <p><%= @hotel.address %></p>
            <p><%= @hotel.city %>, <%= @hotel.state %> <%= @hotel.postal_code %></p>
            <p><%= @hotel.country %></p>
          </div>
          
          <!-- Map Placeholder -->
          <div class="mt-4 bg-gray-100 rounded-lg h-48 flex items-center justify-center">
            <div class="text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <p class="mt-2 text-sm text-gray-500">Map integration available in future update</p>
            </div>
          </div>
        </div>
      </div>

      <% if @hotel.description.present? %>
        <!-- Description -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Description</h2>
          </div>
          <div class="px-6 py-4">
            <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= @hotel.description %></p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Operating Hours -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Operating Hours</h3>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Check-in Time</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= @hotel.check_in_time&.strftime("%l:%M %p") || "3:00 PM" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Check-out Time</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= @hotel.check_out_time&.strftime("%l:%M %p") || "11:00 AM" %>
            </dd>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Quick Actions</h3>
        </div>
        <div class="px-6 py-4 space-y-3">
          <%= link_to hotel_rooms_path(@hotel), class: "flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
            <div class="flex items-center">
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <span class="text-sm font-medium text-gray-900">Manage Rooms</span>
            </div>
            <span class="text-sm text-gray-500"><%= @hotel.rooms.count %></span>
          <% end %>
          
          <%= link_to hotel_room_types_path(@hotel), class: "flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
            <div class="flex items-center">
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              <span class="text-sm font-medium text-gray-900">Room Types</span>
            </div>
            <span class="text-sm text-gray-500"><%= @hotel.room_types.count %></span>
          <% end %>
          
          <%= link_to reservations_path(hotel_id: @hotel.id), class: "flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
            <div class="flex items-center">
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span class="text-sm font-medium text-gray-900">View Reservations</span>
            </div>
            <span class="text-sm text-gray-500"><%= @hotel.reservations.where(status: ['confirmed', 'checked_in']).count %></span>
          <% end %>
          
          <%= link_to hotel_hotel_policies_path(@hotel), class: "flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" do %>
            <div class="flex items-center">
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span class="text-sm font-medium text-gray-900">Hotel Policies</span>
            </div>
            <span class="text-sm text-gray-500"><%= @hotel.hotel_policies.active.count %></span>
          <% end %>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Recent Activity</h3>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-3">
            <% recent_reservations = @hotel.reservations.order(created_at: :desc).limit(5) %>
            <% if recent_reservations.any? %>
              <% recent_reservations.each do |reservation| %>
                <div class="flex items-start space-x-3 text-sm">
                  <div class="flex-shrink-0">
                    <% case reservation.status %>
                    <% when 'confirmed' %>
                      <div class="h-2 w-2 rounded-full bg-green-400 mt-1.5"></div>
                    <% when 'checked_in' %>
                      <div class="h-2 w-2 rounded-full bg-blue-400 mt-1.5"></div>
                    <% when 'checked_out' %>
                      <div class="h-2 w-2 rounded-full bg-gray-400 mt-1.5"></div>
                    <% else %>
                      <div class="h-2 w-2 rounded-full bg-yellow-400 mt-1.5"></div>
                    <% end %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-gray-900">
                      <%= link_to reservation.confirmation_number, reservation_path(reservation), class: "font-medium hover:text-indigo-600" %>
                    </p>
                    <p class="text-gray-500">
                      <%= reservation.guest.full_name %> • <%= reservation.status.humanize %>
                    </p>
                    <p class="text-xs text-gray-400">
                      <%= time_ago_in_words(reservation.created_at) %> ago
                    </p>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No recent activity</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>