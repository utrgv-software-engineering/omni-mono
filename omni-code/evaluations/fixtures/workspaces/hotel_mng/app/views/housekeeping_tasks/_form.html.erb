<%= form_with model: [@hotel, housekeeping_task] do |f| %>
  <% if housekeeping_task.errors.any? %>
    <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">There were <%= pluralize(housekeeping_task.errors.count, "error") %> with your submission</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% housekeeping_task.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Main Form -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Task Details</h2>
        </div>
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= f.label :room_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :room_id,
                  options_from_collection_for_select(@rooms, :id, :room_number, housekeeping_task.room_id),
                  { prompt: "Select a room" },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div>
              <%= f.label :task_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :task_type,
                  options_for_select(HousekeepingTask::TASK_TYPES.map { |t| [t.humanize, t] }, housekeeping_task.task_type),
                  { prompt: "Select task type" },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= f.label :priority, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :priority,
                  options_for_select(HousekeepingTask::PRIORITIES.map { |p| [p.capitalize, p] }, housekeeping_task.priority),
                  {},
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div>
              <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :status,
                  options_for_select(HousekeepingTask::STATUSES.map { |s| [s.humanize, s] }, housekeeping_task.status),
                  {},
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>

          <div>
            <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :notes,
                rows: 4,
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Any special instructions or notes about this task..." %>
          </div>
        </div>
      </div>

      <!-- Scheduling -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Scheduling</h2>
        </div>
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= f.label :scheduled_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.date_field :scheduled_date,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div>
              <%= f.label :scheduled_time, "Scheduled Time (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.time_field :scheduled_time,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>

          <div>
            <%= f.label :assigned_to_id, "Assign To", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :assigned_to_id,
                options_from_collection_for_select(@users, :id, :display_name, housekeeping_task.assigned_to_id),
                { include_blank: "Unassigned" },
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
        </div>
      </div>

      <!-- Completion (only show if editing and task is completed) -->
      <% if housekeeping_task.persisted? && housekeeping_task.completed? %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Completion Details</h2>
          </div>
          <div class="p-6 space-y-6">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
              <div>
                <%= f.label :started_at, class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.datetime_local_field :started_at,
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>

              <div>
                <%= f.label :completed_at, class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.datetime_local_field :completed_at,
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>

              <div>
                <%= f.label :inspection_score, "Inspection Score (1-10)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.number_field :inspection_score,
                    min: 1, max: 10,
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Actions</h2>
        </div>
        <div class="p-6 space-y-3">
          <%= f.submit housekeeping_task.persisted? ? "Update Task" : "Create Task", 
              class: "w-full px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
          
          <%= link_to "Cancel", 
              housekeeping_task.persisted? ? hotel_housekeeping_task_path(@hotel, housekeeping_task) : hotel_housekeeping_tasks_path(@hotel),
              class: "block w-full text-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>

          <% if housekeeping_task.persisted? && policy(housekeeping_task).destroy? %>
            <hr class="my-4 border-gray-200">
            <%= link_to "Delete Task", 
                hotel_housekeeping_task_path(@hotel, housekeeping_task),
                method: :delete,
                data: { confirm: "Are you sure you want to delete this task?" },
                class: "block w-full text-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>