<% content_for :page_title, "Edit Task ##{@housekeeping_task.id} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Housekeeping Tasks", hotel_housekeeping_tasks_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Task ##{@housekeeping_task.id}", hotel_housekeeping_task_path(@hotel, @housekeeping_task), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Edit Housekeeping Task</h1>
    <p class="mt-1 text-sm text-gray-600">Update task details and assignment</p>
  </div>

  <%= render 'form', housekeeping_task: @housekeeping_task %>
</div>