<% content_for :page_title, "Housekeeping Tasks - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Housekeeping Tasks</span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Housekeeping Tasks</h1>
      <p class="mt-1 text-sm text-gray-600">Manage cleaning schedules and room maintenance</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(HousekeepingTask).new? %>
        <%= link_to new_hotel_housekeeping_task_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Task
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-yellow-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Pending</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @housekeeping_tasks.pending.count %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-blue-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">In Progress</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @housekeeping_tasks.in_progress.count %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-red-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Overdue</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @housekeeping_tasks.overdue.count %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Today's Tasks</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @housekeeping_tasks.today.count %></dd>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 mb-6">
    <%= form_with url: hotel_housekeeping_tasks_path(@hotel), method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Date Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
          <%= date_field_tag :date, params[:date], 
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Status Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <%= select_tag :status, 
              options_for_select([
                ['All Statuses', ''],
                ['Pending', 'pending'],
                ['In Progress', 'in_progress'],
                ['Completed', 'completed'],
                ['Cancelled', 'cancelled']
              ], params[:status]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Room Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Room</label>
          <%= select_tag :room_id,
              options_from_collection_for_select(@hotel.rooms.order(:room_number), :id, :room_number, params[:room_id]),
              include_blank: 'All Rooms',
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <!-- Priority Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
          <%= select_tag :priority,
              options_for_select([
                ['All Priorities', ''],
                ['Urgent', 'urgent'],
                ['High', 'high'],
                ['Normal', 'normal'],
                ['Low', 'low']
              ], params[:priority]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <div class="flex space-x-2">
          <%= submit_tag "Apply Filters", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <%= link_to "Clear", hotel_housekeeping_tasks_path(@hotel), class: "px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>

        <div class="flex space-x-2">
          <%= link_to "Today", hotel_housekeeping_tasks_path(@hotel, date: Date.current),
              class: "px-3 py-1 text-xs font-medium rounded-full #{params[:date] == Date.current.to_s ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
          <%= link_to "Tomorrow", hotel_housekeeping_tasks_path(@hotel, date: Date.tomorrow),
              class: "px-3 py-1 text-xs font-medium rounded-full #{params[:date] == Date.tomorrow.to_s ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
          <%= link_to "Overdue", hotel_housekeeping_tasks_path(@hotel, status: 'pending', date: Date.yesterday),
              class: "px-3 py-1 text-xs font-medium rounded-full text-red-700 bg-red-100 hover:bg-red-200" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Tasks Table -->
  <div class="bg-white shadow-sm rounded-lg border border-gray-200">
    <% if @housekeeping_tasks.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Room
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Task Type
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Priority
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Scheduled
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Assigned To
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Score
              </th>
              <th scope="col" class="relative px-6 py-3">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @housekeeping_tasks.each do |task| %>
              <tr class="<%= 'bg-red-50' if task.overdue? %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">
                    Room <%= task.room.room_number %>
                  </div>
                  <div class="text-xs text-gray-500">
                    <%= task.room.room_type.name %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-900"><%= task.task_type.humanize %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% priority_colors = { 'urgent' => 'red', 'high' => 'orange', 'normal' => 'gray', 'low' => 'blue' } %>
                  <% color = priority_colors[task.priority] %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-100 text-<%= color %>-800">
                    <%= task.priority.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% status_colors = { 'pending' => 'yellow', 'in_progress' => 'blue', 'completed' => 'green', 'cancelled' => 'gray' } %>
                  <% color = status_colors[task.status] %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-100 text-<%= color %>-800">
                    <%= task.status.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= task.scheduled_date.strftime("%b %d, %Y") %>
                    <% if task.overdue? %>
                      <span class="ml-1 text-xs text-red-600">(Overdue)</span>
                    <% end %>
                  </div>
                  <% if task.scheduled_time %>
                    <div class="text-xs text-gray-500">
                      <%= task.scheduled_time.strftime("%l:%M %p") %>
                    </div>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if task.assigned_to %>
                    <div class="text-sm text-gray-900"><%= task.assigned_to.display_name %></div>
                  <% else %>
                    <span class="text-sm text-gray-500">Unassigned</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if task.inspection_score %>
                    <span class="text-sm font-medium text-gray-900"><%= task.inspection_score %>/10</span>
                  <% else %>
                    <span class="text-sm text-gray-500">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <% if task.pending? && policy(task).update? %>
                      <%= form_with url: mark_complete_hotel_housekeeping_task_path(@hotel, task), method: :patch, local: false, class: "inline" do |f| %>
                        <%= f.submit "Complete", class: "text-green-600 hover:text-green-900 cursor-pointer" %>
                      <% end %>
                    <% end %>
                    <%= link_to "View", hotel_housekeeping_task_path(@hotel, task), class: "text-indigo-600 hover:text-indigo-900" %>
                    <% if policy(task).edit? %>
                      <%= link_to "Edit", edit_hotel_housekeeping_task_path(@hotel, task), class: "text-gray-600 hover:text-gray-900" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No housekeeping tasks found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if params[:date].present? || params[:status].present? %>
            Try adjusting your filters to see more tasks.
          <% else %>
            Get started by creating a new housekeeping task.
          <% end %>
        </p>
        <div class="mt-6">
          <% if policy(HousekeepingTask).new? %>
            <%= link_to new_hotel_housekeeping_task_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Task
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>