<% content_for :page_title, "New Housekeeping Task - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Housekeeping Tasks", hotel_housekeeping_tasks_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Task</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">New Housekeeping Task</h1>
    <p class="mt-1 text-sm text-gray-600">Schedule a new cleaning or maintenance task for a room</p>
  </div>

  <%= render 'form', housekeeping_task: @housekeeping_task %>
</div>