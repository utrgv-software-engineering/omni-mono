<% content_for :page_title, "Task ##{@housekeeping_task.id} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <%= link_to "Housekeeping Tasks", hotel_housekeeping_tasks_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Task #<%= @housekeeping_task.id %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Housekeeping Task Details</h1>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@housekeeping_task).edit? %>
        <%= link_to "Edit", edit_hotel_housekeeping_task_path(@hotel, @housekeeping_task), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% end %>
      <% if @housekeeping_task.pending? && policy(@housekeeping_task).update? %>
        <%= form_with url: mark_complete_hotel_housekeeping_task_path(@hotel, @housekeeping_task), method: :patch, local: false, class: "inline" do |f| %>
          <%= f.submit "Mark Complete", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Task Information Card -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Task Information</h2>
        </div>
        <div class="p-6">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Room</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to hotel_room_path(@hotel, @housekeeping_task.room), class: "text-indigo-600 hover:text-indigo-900" do %>
                  Room <%= @housekeeping_task.room.room_number %>
                <% end %>
                <div class="text-xs text-gray-500"><%= @housekeeping_task.room.room_type.name %></div>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Task Type</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @housekeeping_task.task_type.humanize %></dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Priority</dt>
              <dd class="mt-1">
                <% priority_colors = { 'urgent' => 'red', 'high' => 'orange', 'normal' => 'gray', 'low' => 'blue' } %>
                <% color = priority_colors[@housekeeping_task.priority] %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-100 text-<%= color %>-800">
                  <%= @housekeeping_task.priority.capitalize %>
                </span>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1">
                <% status_colors = { 'pending' => 'yellow', 'in_progress' => 'blue', 'completed' => 'green', 'cancelled' => 'gray' } %>
                <% color = status_colors[@housekeeping_task.status] %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= color %>-100 text-<%= color %>-800">
                  <%= @housekeeping_task.status.humanize %>
                </span>
                <% if @housekeeping_task.overdue? %>
                  <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Overdue
                  </span>
                <% end %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Scheduled Date</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @housekeeping_task.scheduled_date.strftime("%B %d, %Y") %>
                <% if @housekeeping_task.scheduled_time %>
                  <div class="text-xs text-gray-500"><%= @housekeeping_task.scheduled_time.strftime("%l:%M %p") %></div>
                <% end %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Assigned To</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @housekeeping_task.assigned_to %>
                  <%= @housekeeping_task.assigned_to.display_name %>
                <% else %>
                  <span class="text-gray-500">Unassigned</span>
                  <% if policy(@housekeeping_task).update? %>
                    <%= form_with url: assign_hotel_housekeeping_task_path(@hotel, @housekeeping_task), method: :patch, local: false, class: "mt-2" do |f| %>
                      <%= f.select :assigned_to_id,
                          options_from_collection_for_select(@users, :id, :display_name),
                          { include_blank: "Select staff member" },
                          class: "block w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                          onchange: "this.form.requestSubmit();" %>
                    <% end %>
                  <% end %>
                <% end %>
              </dd>
            </div>
          </dl>

          <% if @housekeeping_task.notes.present? %>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500 mb-2">Notes</dt>
              <dd class="text-sm text-gray-900 whitespace-pre-line"><%= @housekeeping_task.notes %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Time Tracking Card -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Time Tracking</h2>
        </div>
        <div class="p-6">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">Started At</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @housekeeping_task.started_at %>
                  <%= @housekeeping_task.started_at.strftime("%b %d, %Y at %l:%M %p") %>
                <% else %>
                  <span class="text-gray-500">Not started</span>
                <% end %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Completed At</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @housekeeping_task.completed_at %>
                  <%= @housekeeping_task.completed_at.strftime("%b %d, %Y at %l:%M %p") %>
                <% else %>
                  <span class="text-gray-500">Not completed</span>
                <% end %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Duration</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @housekeeping_task.duration_minutes %>
                  <%= @housekeeping_task.duration_minutes %> minutes
                <% else %>
                  <span class="text-gray-500">—</span>
                <% end %>
              </dd>
            </div>
          </dl>

          <% if @housekeeping_task.inspection_score %>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500 mb-2">Inspection Score</dt>
              <dd class="flex items-center">
                <span class="text-2xl font-bold text-gray-900"><%= @housekeeping_task.inspection_score %></span>
                <span class="ml-1 text-lg text-gray-500">/10</span>
                <div class="ml-4 flex space-x-1">
                  <% @housekeeping_task.inspection_score.times do %>
                    <svg class="h-5 w-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  <% end %>
                  <% (10 - @housekeeping_task.inspection_score).times do %>
                    <svg class="h-5 w-5 text-gray-300 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  <% end %>
                </div>
              </dd>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Quick Actions Card -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        </div>
        <div class="p-6 space-y-3">
          <% if @housekeeping_task.pending? && policy(@housekeeping_task).update? %>
            <%= form_with model: [@hotel, @housekeeping_task], method: :patch, local: false do |f| %>
              <%= f.hidden_field :status, value: 'in_progress' %>
              <%= f.hidden_field :started_at, value: Time.current %>
              <%= f.submit "Start Task", class: "w-full px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
            <% end %>
          <% elsif @housekeeping_task.in_progress? && policy(@housekeeping_task).update? %>
            <div class="space-y-3">
              <%= form_with url: mark_complete_hotel_housekeeping_task_path(@hotel, @housekeeping_task), method: :patch, local: false do |f| %>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Inspection Score (optional)</label>
                  <%= f.number_field :inspection_score, min: 1, max: 10, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" %>
                </div>
                <%= f.submit "Complete Task", class: "w-full px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
              <% end %>
            </div>
          <% end %>

          <% if !@housekeeping_task.completed? && !@housekeeping_task.cancelled? && policy(@housekeeping_task).update? %>
            <%= form_with model: [@hotel, @housekeeping_task], method: :patch, data: { confirm: "Are you sure you want to cancel this task?" }, local: false do |f| %>
              <%= f.hidden_field :status, value: 'cancelled' %>
              <%= f.submit "Cancel Task", class: "w-full px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 cursor-pointer" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Metadata Card -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Metadata</h2>
        </div>
        <div class="p-6">
          <dl class="space-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Task ID</dt>
              <dd class="mt-1 text-sm text-gray-900">#<%= @housekeeping_task.id %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Created</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @housekeeping_task.created_at.strftime("%b %d, %Y at %l:%M %p") %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @housekeeping_task.updated_at.strftime("%b %d, %Y at %l:%M %p") %>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>