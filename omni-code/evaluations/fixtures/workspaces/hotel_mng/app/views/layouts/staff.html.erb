<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "#{current_tenant&.name} - Hotel Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <div class="h-screen">
      <%= render 'shared/sidebar' %>

      <!-- Main Content -->
      <div class="flex flex-col h-full lg:ml-64">
        <!-- Top Header -->
        <header class="bg-white shadow-sm border-b border-gray-200 z-10">
          <div class="flex items-center justify-between h-16 px-6">
            <div class="flex items-center space-x-4">
              <!-- Mobile menu button -->
              <button onclick="toggleSidebar()" class="lg:hidden p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </button>

              <!-- Page Title -->
              <div>
                <h1 class="text-xl font-semibold text-gray-900">
                  <%= content_for(:page_title) || "Dashboard" %>
                </h1>
                <% if content_for?(:page_subtitle) %>
                  <p class="text-sm text-gray-500 mt-0.5"><%= content_for(:page_subtitle) %></p>
                <% end %>
              </div>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center space-x-3">
              <% if content_for?(:header_actions) %>
                <!-- Custom header actions (e.g., for Reports page) -->
                <%= yield :header_actions %>
              <% else %>
                <!-- Default header actions for regular pages -->
                <!-- Quick Add Menu -->
                <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                  <button data-action="click->dropdown#toggle" 
                          class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  </button>
                  <div data-dropdown-target="menu" 
                       class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
                    <%= link_to new_reservation_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-t-lg" do %>
                      New Reservation
                    <% end %>
                    <%= link_to "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" do %>
                      Walk-in Guest
                    <% end %>
                    <%= link_to "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-b-lg" do %>
                      Block Rooms
                    <% end %>
                  </div>
                </div>

                <!-- Notifications -->
                <button class="relative p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                  </svg>
                  <% if false %>
                    <span class="absolute top-1 right-1 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                  <% end %>
                </button>

                <!-- Global Search -->
                <div class="relative hidden md:block">
                  <input type="text" 
                         placeholder="Search guests, rooms, reservations..." 
                         class="w-80 pl-10 pr-4 py-2 text-sm bg-gray-50 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors">
                  <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                  <kbd class="absolute right-3 top-2 px-2 py-0.5 text-xs font-semibold text-gray-500 bg-gray-100 border border-gray-200 rounded">⌘K</kbd>
                </div>
              <% end %>
            </div>
          </div>
        </header>

        <!-- Flash Messages -->
        <% if notice.present? || alert.present? %>
          <div class="px-6 py-3 bg-white border-b border-gray-200">
            <% if notice.present? %>
              <div class="flex items-center p-3 text-sm text-green-800 bg-green-50 border border-green-200 rounded-lg" role="alert">
                <svg class="flex-shrink-0 w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div class="flex-1"><%= notice %></div>
                <button onclick="this.parentElement.remove()" class="ml-3 text-green-600 hover:text-green-800">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            <% end %>
            
            <% if alert.present? %>
              <div class="flex items-center p-3 <%= notice.present? ? 'mt-2' : '' %> text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg" role="alert">
                <svg class="flex-shrink-0 w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                <div class="flex-1"><%= alert %></div>
                <button onclick="this.parentElement.remove()" class="ml-3 text-red-600 hover:text-red-800">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto bg-gray-100">
          <div class="p-6">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
