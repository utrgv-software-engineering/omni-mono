<%= form_with(model: [@hotel, maintenance_request], local: true) do |form| %>
  <% if maintenance_request.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(maintenance_request.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-1">
              <% maintenance_request.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Issue Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Issue Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <%= form.label :issue_description, class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_area :issue_description, 
                rows: 4,
                class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Describe the maintenance issue in detail..." %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :category, class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :category, 
                  options_for_select(MaintenanceRequest::CATEGORIES.map { |c| [c.capitalize, c] }, maintenance_request.category),
                  { prompt: 'Select category...' },
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div>
              <%= form.label :room_id, "Location", class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :room_id,
                  options_for_select(
                    [['Common Area', '']] + 
                    @rooms.map { |r| ["Room #{r.room_number}", r.id] },
                    maintenance_request.room_id
                  ),
                  {},
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :priority, class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :priority,
                  options_for_select(MaintenanceRequest::PRIORITIES.map { |p| [p.capitalize, p] }, maintenance_request.priority),
                  {},
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">
                Critical: Safety issues | High: Business impact | Normal: Standard repairs | Low: Cosmetic issues
              </p>
            </div>

            <div>
              <%= form.label :scheduled_date, class: "block text-sm font-medium text-gray-700" %>
              <%= form.date_field :scheduled_date,
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Optional: Target date for completion</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Assignment & Cost -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Assignment & Cost</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :assigned_to_id, "Assign To", class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :assigned_to_id,
                  options_for_select(
                    [['Unassigned', '']] + 
                    @users.map { |u| [u.full_name, u.id] },
                    maintenance_request.assigned_to_id
                  ),
                  {},
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div>
              <%= form.label :cost_estimate, "Estimated Cost ($)", class: "block text-sm font-medium text-gray-700" %>
              <%= form.number_field :cost_estimate,
                  step: 0.01,
                  min: 0,
                  placeholder: "0.00",
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>

          <% if maintenance_request.persisted? %>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= form.label :status, class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :status,
                    options_for_select(MaintenanceRequest::STATUSES.map { |s| [s.humanize, s] }, maintenance_request.status),
                    {},
                    class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>

              <div>
                <%= form.label :actual_cost, "Actual Cost ($)", class: "block text-sm font-medium text-gray-700" %>
                <%= form.number_field :actual_cost,
                    step: 0.01,
                    min: 0,
                    placeholder: "0.00",
                    class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>
            </div>

            <div>
              <%= form.label :resolution_notes, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_area :resolution_notes,
                  rows: 3,
                  class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "Notes about the resolution or cancellation..." %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Request Details</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <% if maintenance_request.persisted? %>
            <div>
              <label class="block text-sm font-medium text-gray-700">Request ID</label>
              <p class="mt-1 text-sm text-gray-900">#<%= maintenance_request.id %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Reported By</label>
              <p class="mt-1 text-sm text-gray-900"><%= maintenance_request.reported_by.full_name %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Created</label>
              <p class="mt-1 text-sm text-gray-900">
                <%= maintenance_request.created_at.strftime("%B %d, %Y") %>
                <span class="block text-xs text-gray-500">
                  <%= maintenance_request.created_at.strftime("%l:%M %p") %>
                </span>
              </p>
            </div>

            <% if maintenance_request.updated_at != maintenance_request.created_at %>
              <div>
                <label class="block text-sm font-medium text-gray-700">Last Updated</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= maintenance_request.updated_at.strftime("%B %d, %Y") %>
                  <span class="block text-xs text-gray-500">
                    <%= maintenance_request.updated_at.strftime("%l:%M %p") %>
                  </span>
                </p>
              </div>
            <% end %>

            <% if maintenance_request.days_open > 0 %>
              <div>
                <label class="block text-sm font-medium text-gray-700">Days Open</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= maintenance_request.days_open %> <%= 'day'.pluralize(maintenance_request.days_open) %>
                </p>
              </div>
            <% end %>
          <% else %>
            <div>
              <label class="block text-sm font-medium text-gray-700">Reported By</label>
              <p class="mt-1 text-sm text-gray-900"><%= current_user.full_name %></p>
            </div>

            <div class="p-3 bg-yellow-50 rounded-lg">
              <p class="text-sm text-yellow-800">
                This request will be created with "Open" status and can be assigned to staff members.
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-end space-x-3">
    <%= link_to "Cancel", 
        maintenance_request.persisted? ? hotel_maintenance_request_path(@hotel, maintenance_request) : hotel_maintenance_requests_path(@hotel),
        class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit maintenance_request.persisted? ? "Update Request" : "Create Request",
        class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>