<% content_for :page_title, "Maintenance Requests - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Maintenance Requests</span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Maintenance Requests</h1>
      <p class="mt-1 text-sm text-gray-600">Manage repair and maintenance issues</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(MaintenanceRequest).new? %>
        <%= link_to new_hotel_maintenance_request_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          New Request
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-red-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Critical</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= @maintenance_requests.where(priority: 'critical').count %>
            </dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-orange-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Unassigned</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= @maintenance_requests.unassigned.count %>
            </dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-yellow-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">In Progress</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              <%= @maintenance_requests.in_progress.count %>
            </dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-blue-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Total Cost Est.</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900">
              $<%= number_with_delimiter(@maintenance_requests.active.sum(:cost_estimate) || 0) %>
            </dd>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <%= form_with url: hotel_maintenance_requests_path(@hotel), method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Category Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
          <%= select_tag :category, 
              options_for_select([
                ['All Categories', ''],
                ['Electrical', 'electrical'],
                ['Plumbing', 'plumbing'],
                ['HVAC', 'hvac'],
                ['Furniture', 'furniture'],
                ['Other', 'other']
              ], params[:category]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        
        <!-- Priority Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
          <%= select_tag :priority, 
              options_for_select([
                ['All Priorities', ''],
                ['Critical', 'critical'],
                ['High', 'high'],
                ['Normal', 'normal'],
                ['Low', 'low']
              ], params[:priority]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        
        <!-- Status Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <%= select_tag :status, 
              options_for_select([
                ['All Statuses', ''],
                ['Open', 'open'],
                ['In Progress', 'in_progress'],
                ['Pending Parts', 'pending_parts'],
                ['Completed', 'completed'],
                ['Cancelled', 'cancelled']
              ], params[:status]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        
        <!-- Room Filter -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Room</label>
          <%= select_tag :room_id, 
              options_for_select(
                [['All Locations', '']] + 
                [['Common Areas', 'common']] +
                @hotel.rooms.order(:room_number).pluck(:room_number, :id), 
                params[:room_id]
              ),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>
      
      <div class="flex items-center space-x-2">
        <%= submit_tag "Apply Filters", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <%= link_to "Clear", hotel_maintenance_requests_path(@hotel), class: "px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>

  <!-- Maintenance Requests Table -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <% if @maintenance_requests.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                ID
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Location
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Category
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Issue
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Priority
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Assigned To
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Est. Cost
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Created
              </th>
              <th class="relative px-6 py-3">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @maintenance_requests.each do |request| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  #<%= request.id %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if request.room %>
                    <span class="text-gray-900">Room <%= request.room.room_number %></span>
                  <% else %>
                    <span class="text-gray-500 italic">Common Area</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800">
                    <%= request.category.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <div class="max-w-xs truncate" title="<%= request.issue_description %>">
                    <%= truncate(request.issue_description, length: 50) %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% priority_colors = {
                    'critical' => 'bg-red-100 text-red-800',
                    'high' => 'bg-orange-100 text-orange-800',
                    'normal' => 'bg-blue-100 text-blue-800',
                    'low' => 'bg-gray-100 text-gray-800'
                  } %>
                  <span class="px-2 py-1 text-xs font-medium rounded-full <%= priority_colors[request.priority] %>">
                    <%= request.priority.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% status_colors = {
                    'open' => 'bg-yellow-100 text-yellow-800',
                    'in_progress' => 'bg-blue-100 text-blue-800',
                    'pending_parts' => 'bg-orange-100 text-orange-800',
                    'completed' => 'bg-green-100 text-green-800',
                    'cancelled' => 'bg-gray-100 text-gray-800'
                  } %>
                  <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_colors[request.status] %>">
                    <%= request.status.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <% if request.assigned_to %>
                    <%= request.assigned_to.full_name %>
                  <% else %>
                    <span class="text-gray-500 italic">Unassigned</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <% if request.cost_estimate %>
                    $<%= number_with_delimiter(request.cost_estimate) %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= request.created_at.strftime("%b %d, %Y") %>
                  <% if request.overdue? %>
                    <span class="block text-xs text-red-600 font-medium">Overdue</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to "View", hotel_maintenance_request_path(@hotel, request), 
                        class: "text-indigo-600 hover:text-indigo-900" %>
                    <% if policy(request).edit? %>
                      <%= link_to "Edit", edit_hotel_maintenance_request_path(@hotel, request), 
                          class: "text-gray-600 hover:text-gray-900" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No maintenance requests</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating a new maintenance request.</p>
        <% if policy(MaintenanceRequest).new? %>
          <div class="mt-6">
            <%= link_to new_hotel_maintenance_request_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              New Request
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>