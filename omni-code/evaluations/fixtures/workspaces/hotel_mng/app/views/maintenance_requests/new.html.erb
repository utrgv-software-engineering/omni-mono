<% content_for :page_title, "New Maintenance Request - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Maintenance Requests", hotel_maintenance_requests_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Request</span>
    </nav>

    <h1 class="text-2xl font-bold text-gray-900">New Maintenance Request</h1>
    <p class="mt-1 text-sm text-gray-600">Report a maintenance issue that needs attention</p>
  </div>

  <%= render 'form', maintenance_request: @maintenance_request %>
</div>