<% content_for :page_title, "Maintenance Request ##{@maintenance_request.id} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Maintenance Requests", hotel_maintenance_requests_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Request #<%= @maintenance_request.id %></span>
    </nav>

    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Maintenance Request #<%= @maintenance_request.id %></h1>
        <p class="mt-1 text-sm text-gray-600">Created <%= @maintenance_request.created_at.strftime("%B %d, %Y at %l:%M %p") %></p>
      </div>
      <div class="flex space-x-3">
        <% if policy(@maintenance_request).edit? %>
          <%= link_to edit_hotel_maintenance_request_path(@hotel, @maintenance_request), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
            </svg>
            Edit Request
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Issue Details -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Issue Details</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Description</label>
            <p class="mt-1 text-sm text-gray-900">
              <%= @maintenance_request.issue_description %>
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">Category</label>
              <p class="mt-1">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= @maintenance_request.category.capitalize %>
                </span>
              </p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Location</label>
              <p class="mt-1 text-sm text-gray-900">
                <% if @maintenance_request.room %>
                  Room <%= @maintenance_request.room.room_number %>
                <% else %>
                  Common Area
                <% end %>
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">Priority</label>
              <p class="mt-1">
                <% priority_colors = {
                  'critical' => 'bg-red-100 text-red-800',
                  'high' => 'bg-orange-100 text-orange-800',
                  'normal' => 'bg-blue-100 text-blue-800',
                  'low' => 'bg-gray-100 text-gray-800'
                } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= priority_colors[@maintenance_request.priority] %>">
                  <%= @maintenance_request.priority.capitalize %>
                </span>
              </p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Status</label>
              <p class="mt-1">
                <% status_colors = {
                  'open' => 'bg-yellow-100 text-yellow-800',
                  'in_progress' => 'bg-blue-100 text-blue-800',
                  'pending_parts' => 'bg-orange-100 text-orange-800',
                  'completed' => 'bg-green-100 text-green-800',
                  'cancelled' => 'bg-gray-100 text-gray-800'
                } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_colors[@maintenance_request.status] %>">
                  <%= @maintenance_request.status.humanize %>
                </span>
              </p>
            </div>
          </div>

          <% if @maintenance_request.scheduled_date.present? %>
            <div>
              <label class="block text-sm font-medium text-gray-700">Scheduled Date</label>
              <p class="mt-1 text-sm text-gray-900">
                <%= @maintenance_request.scheduled_date.strftime("%B %d, %Y") %>
                <% if @maintenance_request.overdue? %>
                  <span class="ml-2 text-xs font-medium text-red-600">(Overdue)</span>
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Cost Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Cost Information</h2>
        </div>
        <div class="px-6 py-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">Estimated Cost</label>
              <p class="mt-1 text-sm text-gray-900">
                <% if @maintenance_request.cost_estimate %>
                  $<%= number_with_delimiter(@maintenance_request.cost_estimate) %>
                <% else %>
                  <span class="text-gray-500">Not estimated</span>
                <% end %>
              </p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700">Actual Cost</label>
              <p class="mt-1 text-sm text-gray-900">
                <% if @maintenance_request.actual_cost %>
                  $<%= number_with_delimiter(@maintenance_request.actual_cost) %>
                  <% if @maintenance_request.cost_variance %>
                    <% variance_color = @maintenance_request.cost_variance > 0 ? 'text-red-600' : 'text-green-600' %>
                    <span class="ml-2 text-xs <%= variance_color %>">
                      (<%= @maintenance_request.cost_variance > 0 ? '+' : '' %>$<%= number_with_delimiter(@maintenance_request.cost_variance.abs) %>)
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-gray-500">To be determined</span>
                <% end %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Resolution -->
      <% if @maintenance_request.resolution_notes.present? || @maintenance_request.completed? %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Resolution</h2>
          </div>
          <div class="px-6 py-4 space-y-4">
            <% if @maintenance_request.completed_at.present? %>
              <div>
                <label class="block text-sm font-medium text-gray-700">Completed At</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @maintenance_request.completed_at.strftime("%B %d, %Y at %l:%M %p") %>
                  <span class="ml-2 text-gray-500">(<%= @maintenance_request.days_open %> days to complete)</span>
                </p>
              </div>
            <% end %>
            
            <% if @maintenance_request.resolution_notes.present? %>
              <div>
                <label class="block text-sm font-medium text-gray-700">Resolution Notes</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @maintenance_request.resolution_notes %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Actions -->
      <% if @maintenance_request.active? && policy(@maintenance_request).update? %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Quick Actions</h2>
          </div>
          <div class="px-6 py-4 space-y-4">
            <% if @maintenance_request.open? %>
              <%= form_with url: assign_hotel_maintenance_request_path(@hotel, @maintenance_request), method: :patch, local: true do |f| %>
                <div class="flex items-end space-x-3">
                  <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Assign To</label>
                    <%= select_tag :assigned_to_id, 
                        options_for_select(
                          [['Select User...', '']] + 
                          current_tenant.users.joins(:account_users)
                            .where(account_users: { account_id: current_tenant.id })
                            .distinct.pluck(:first_name, :last_name, :id).map { |fn, ln, id| ["#{fn} #{ln}", id] },
                          @maintenance_request.assigned_to_id
                        ),
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
                  </div>
                  <%= submit_tag "Assign", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
                </div>
              <% end %>
            <% end %>

            <div class="flex space-x-3">
              <% if @maintenance_request.open? || @maintenance_request.pending_parts? %>
                <%= button_to "Start Work", 
                    hotel_maintenance_request_path(@hotel, @maintenance_request), 
                    method: :patch,
                    params: { maintenance_request: { status: 'in_progress' } },
                    class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
              <% end %>

              <% if @maintenance_request.in_progress? %>
                <%= button_to "Await Parts", 
                    hotel_maintenance_request_path(@hotel, @maintenance_request), 
                    method: :patch,
                    params: { maintenance_request: { status: 'pending_parts' } },
                    class: "px-4 py-2 bg-yellow-600 text-white text-sm font-medium rounded-lg hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500" %>
              <% end %>

              <% if @maintenance_request.active? %>
                <%= form_with url: complete_hotel_maintenance_request_path(@hotel, @maintenance_request), method: :patch, local: true, class: "flex-1" do |f| %>
                  <div class="space-y-3">
                    <%= text_area_tag :resolution_notes, nil, 
                        placeholder: "Resolution notes (optional)",
                        rows: 2,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
                    <%= number_field_tag :actual_cost, nil,
                        placeholder: "Actual cost (optional)",
                        step: 0.01,
                        min: 0,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
                    <%= submit_tag "Mark Complete", class: "w-full px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
                  </div>
                <% end %>
                
                <%= form_with url: cancel_hotel_maintenance_request_path(@hotel, @maintenance_request), method: :patch, local: true, class: "mt-3" do |f| %>
                  <%= text_field_tag :reason, nil,
                      placeholder: "Cancellation reason (optional)",
                      class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-2" %>
                  <%= submit_tag "Cancel Request", 
                      class: "w-full px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500",
                      onclick: "return confirm('Are you sure you want to cancel this request?')" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Assignment Info -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Assignment</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Reported By</label>
            <p class="mt-1 text-sm text-gray-900">
              <%= @maintenance_request.reported_by.full_name %>
              <span class="block text-xs text-gray-500">
                <%= @maintenance_request.created_at.strftime("%b %d, %Y at %l:%M %p") %>
              </span>
            </p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700">Assigned To</label>
            <p class="mt-1 text-sm text-gray-900">
              <% if @maintenance_request.assigned_to %>
                <%= @maintenance_request.assigned_to.full_name %>
              <% else %>
                <span class="text-gray-500 italic">Unassigned</span>
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <!-- Timeline -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Timeline</h2>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-3">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="h-8 w-8 rounded-full bg-gray-100 flex items-center justify-center">
                  <svg class="h-4 w-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                </div>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-gray-900">Request Created</p>
                <p class="text-xs text-gray-500">
                  <%= @maintenance_request.created_at.strftime("%b %d, %Y at %l:%M %p") %>
                </p>
              </div>
            </div>
            
            <% if @maintenance_request.updated_at > @maintenance_request.created_at %>
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="h-8 w-8 rounded-full bg-gray-100 flex items-center justify-center">
                    <svg class="h-4 w-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-gray-900">Last Updated</p>
                  <p class="text-xs text-gray-500">
                    <%= @maintenance_request.updated_at.strftime("%b %d, %Y at %l:%M %p") %>
                  </p>
                </div>
              </div>
            <% end %>
            
            <% if @maintenance_request.completed_at.present? %>
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="h-8 w-8 rounded-full bg-green-100 flex items-center justify-center">
                    <svg class="h-4 w-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-gray-900">Completed</p>
                  <p class="text-xs text-gray-500">
                    <%= @maintenance_request.completed_at.strftime("%b %d, %Y at %l:%M %p") %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>