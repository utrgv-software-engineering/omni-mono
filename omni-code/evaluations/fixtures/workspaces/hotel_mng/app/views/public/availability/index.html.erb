<%# Page Header %>
<div class="bg-gradient-to-r from-blue-600 to-blue-700 py-12">
  <div class="container mx-auto px-4">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Available Rooms</h1>
    <p class="text-white/90">
      <%= @check_in_date.strftime("%B %d, %Y") %> - <%= @check_out_date.strftime("%B %d, %Y") %>
      <span class="mx-2">•</span>
      <%= pluralize(@guests, 'Guest') %>
    </p>
  </div>
</div>

<%# Search Form %>
<div class="bg-white border-b">
  <div class="container mx-auto px-4 py-6">
    <%= form_with url: public_availability_index_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4 items-end" do |f| %>
      <div>
        <label class="text-sm font-semibold text-gray-700 mb-1 block">Check In</label>
        <%= f.date_field :check_in_date, 
            value: @check_in_date,
            min: Date.current,
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
            required: true %>
      </div>
      
      <div>
        <label class="text-sm font-semibold text-gray-700 mb-1 block">Check Out</label>
        <%= f.date_field :check_out_date, 
            value: @check_out_date,
            min: Date.current + 1,
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
            required: true %>
      </div>
      
      <div>
        <label class="text-sm font-semibold text-gray-700 mb-1 block">Guests</label>
        <%= f.select :guests, 
            options_for_select((1..8).map { |i| [pluralize(i, 'Guest'), i] }, @guests),
            {},
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
      
      <%= f.hidden_field :hotel_id, value: @hotel.id %>
      <%= f.submit "Update Search", 
          class: "bg-blue-600 text-white font-semibold py-2.5 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-200 cursor-pointer" %>
    <% end %>
  </div>
</div>

<%# Results Section %>
<section class="py-12 bg-gray-50 min-h-screen">
  <div class="container mx-auto px-4">
    <% if @available_room_types.empty? %>
      <%# No Availability Message %>
      <div class="max-w-2xl mx-auto text-center py-16">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">No Rooms Available</h2>
        <p class="text-gray-600 mb-8">
          We couldn't find any available rooms for your selected dates and guest count.
          Please try different dates or contact us directly.
        </p>
        <div class="space-y-4">
          <%= link_to "← Back to Hotel", 
              public_hotel_path,
              class: "inline-block bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg hover:bg-gray-800 transition-colors duration-200" %>
          <p class="text-gray-600">
            Or call us at 
            <a href="tel:<%= @hotel.phone %>" class="text-blue-600 hover:underline font-semibold">
              <%= @hotel.phone %>
            </a>
          </p>
        </div>
      </div>
    <% else %>
      <%# Available Rooms Grid %>
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
        <% @available_room_types.each do |room_type| %>
          <% nights = (@check_out_date - @check_in_date).to_i %>
          <% total_price = room_type.calculate_price(nights: nights, guests: @guests) %>
          
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
            <%# Room Image %>
            <div class="relative h-48">
              <%= image_tag "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=1000", 
                  class: "w-full h-full object-cover",
                  alt: room_type.name %>
              <% if room_type.available_count <= 3 %>
                <div class="absolute top-4 left-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                  Only <%= room_type.available_count %> left!
                </div>
              <% end %>
            </div>
            
            <%# Room Details %>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2"><%= room_type.name %></h3>
              
              <p class="text-gray-600 mb-4 text-sm">
                <%= room_type.description || "Comfortable accommodation with modern amenities" %>
              </p>
              
              <%# Room Features %>
              <div class="space-y-2 mb-6">
                <div class="flex items-center text-sm text-gray-700">
                  <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <span>Up to <%= room_type.max_occupancy %> guests</span>
                </div>
                
                <% if room_type.size_sqm.present? %>
                  <div class="flex items-center text-sm text-gray-700">
                    <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                    </svg>
                    <span><%= room_type.size_sqm %> sqm</span>
                  </div>
                <% end %>
                
                <div class="flex items-center text-sm text-gray-700">
                  <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-green-600 font-medium"><%= room_type.available_count %> rooms available</span>
                </div>
              </div>
              
              <%# Pricing %>
              <div class="border-t pt-4">
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <p class="text-sm text-gray-600">
                      $<%= room_type.base_price.to_i %> × <%= pluralize(nights, 'night') %>
                    </p>
                    <% if @guests > room_type.standard_occupancy && room_type.extra_person_charge > 0 %>
                      <p class="text-sm text-gray-600">
                        +$<%= room_type.extra_person_charge.to_i %> extra person charge
                      </p>
                    <% end %>
                  </div>
                  <div class="text-right">
                    <p class="text-2xl font-bold text-gray-900">$<%= total_price.to_i %></p>
                    <p class="text-xs text-gray-600">Total</p>
                  </div>
                </div>
                
                <%= link_to "Select Room", 
                    new_public_booking_path(
                      room_type_id: room_type.id,
                      check_in_date: @check_in_date,
                      check_out_date: @check_out_date,
                      guests: @guests
                    ),
                    class: "block w-full text-center bg-blue-600 text-white font-semibold py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors duration-200" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>