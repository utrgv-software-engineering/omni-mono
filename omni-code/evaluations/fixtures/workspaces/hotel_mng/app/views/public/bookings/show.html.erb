<%# Confirmation Page %>
<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-12">
    <%# Success Message %>
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <%# Header with Success Icon %>
        <div class="bg-green-500 p-6 text-center">
          <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h1 class="text-3xl font-bold text-white mb-2">Booking Confirmed!</h1>
          <p class="text-white/90">Your reservation has been successfully created</p>
        </div>
        
        <%# Confirmation Details %>
        <div class="p-8">
          <%# Confirmation Number %>
          <div class="bg-blue-50 border-2 border-blue-200 rounded-lg p-4 mb-6 text-center">
            <p class="text-sm text-blue-800 mb-1">Confirmation Number</p>
            <p class="text-2xl font-bold text-blue-900"><%= @booking.confirmation_number %></p>
            <p class="text-xs text-blue-700 mt-2">Please save this number for your records</p>
          </div>
          
          <%# Booking Details %>
          <div class="space-y-6">
            <%# Hotel Info %>
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Hotel Information
              </h2>
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="font-semibold text-gray-900"><%= @hotel.name %></p>
                <p class="text-sm text-gray-600"><%= @hotel.address %></p>
                <p class="text-sm text-gray-600"><%= @hotel.city %>, <%= @hotel.state %> <%= @hotel.postal_code %></p>
                <p class="text-sm text-gray-600 mt-2">
                  <span class="font-medium">Phone:</span> <%= @hotel.phone %>
                </p>
              </div>
            </div>
            
            <%# Guest Info %>
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Guest Information
              </h2>
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="font-semibold text-gray-900"><%= @booking.guest.full_name %></p>
                <p class="text-sm text-gray-600"><%= @booking.guest.email %></p>
                <p class="text-sm text-gray-600"><%= @booking.guest.phone %></p>
              </div>
            </div>
            
            <%# Reservation Details %>
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Reservation Details
              </h2>
              <div class="bg-gray-50 rounded-lg p-4">
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="text-xs text-gray-500 mb-1">Room Type</p>
                    <p class="font-medium text-gray-900"><%= @booking.room_type.name %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 mb-1">Guests</p>
                    <p class="font-medium text-gray-900"><%= pluralize(@booking.adults, 'Adult') %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 mb-1">Check-in</p>
                    <p class="font-medium text-gray-900"><%= @booking.check_in_date.strftime("%B %d, %Y") %></p>
                    <p class="text-xs text-gray-600">After <%= @hotel.check_in_time.strftime("%l:%M %p") %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 mb-1">Check-out</p>
                    <p class="font-medium text-gray-900"><%= @booking.check_out_date.strftime("%B %d, %Y") %></p>
                    <p class="text-xs text-gray-600">Before <%= @hotel.check_out_time.strftime("%l:%M %p") %></p>
                  </div>
                </div>
                
                <div class="mt-4 pt-4 border-t">
                  <div class="flex justify-between items-center">
                    <div>
                      <p class="text-xs text-gray-500">Total Amount</p>
                      <p class="text-2xl font-bold text-gray-900">$<%= @booking.total_amount.to_i %></p>
                    </div>
                    <div class="text-right">
                      <p class="text-xs text-gray-500">Payment Status</p>
                      <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-medium">
                        Due at Check-in
                      </span>
                    </div>
                  </div>
                </div>
                
                <% if @booking.special_requests.present? %>
                  <div class="mt-4 pt-4 border-t">
                    <p class="text-xs text-gray-500 mb-1">Special Requests</p>
                    <p class="text-sm text-gray-700"><%= @booking.special_requests %></p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          
          <%# Action Buttons %>
          <div class="mt-8 pt-6 border-t">
            <div class="flex flex-col sm:flex-row gap-4">
              <%= link_to "View/Modify Reservation", 
                  public_reservation_path(@booking.confirmation_number, email: @booking.guest.email),
                  class: "flex-1 text-center bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-200" %>
              <%= link_to "Return to Hotel Page", 
                  public_hotel_path,
                  class: "flex-1 text-center bg-gray-200 text-gray-900 font-semibold py-3 px-6 rounded-lg hover:bg-gray-300 transition-colors duration-200" %>
            </div>
          </div>
          
          <%# Important Information %>
          <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-lg">
            <h3 class="font-semibold text-amber-900 mb-2 flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              Important Information
            </h3>
            <ul class="text-sm text-amber-800 space-y-1">
              <li>• A confirmation email has been sent to <%= @booking.guest.email %></li>
              <li>• Please present this confirmation number at check-in</li>
              <li>• Photo ID and credit card will be required at check-in</li>
              <li>• For cancellations, please contact the hotel directly</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Print Styles %>
<style media="print">
  .no-print { display: none; }
  body { font-size: 12pt; }
</style>