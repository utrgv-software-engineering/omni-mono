<%# Hero Section with Search %>
<section class="relative min-h-[70vh] md:min-h-[80vh] flex items-center justify-center overflow-hidden">
  <%# Background Image with Overlay %>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/40 z-10"></div>
    <%= image_tag "https://images.unsplash.com/photo-1564501049412-61c2a3083791?q=80&w=3000", 
        class: "w-full h-full object-cover",
        alt: @hotel.name %>
  </div>
  
  <%# Hero Content %>
  <div class="relative z-20 container mx-auto px-4 text-center text-white">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-4 animate-fade-in">
      <%= @hotel.name %>
    </h1>
    <p class="text-lg md:text-xl lg:text-2xl mb-6 text-white/90 max-w-2xl mx-auto">
      <%= @hotel.description.presence || "Experience luxury and comfort in the heart of #{@hotel.city}" %>
    </p>
    <% if @hotel.star_rating.present? %>
      <div class="flex justify-center mb-8">
        <% @hotel.star_rating.to_i.times do %>
          <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
          </svg>
        <% end %>
      </div>
    <% end %>
    
    <%# Floating Search Card %>
    <div class="bg-white rounded-2xl shadow-2xl p-4 md:p-6 max-w-4xl mx-auto transform hover:scale-[1.02] transition-transform duration-300">
      <%= form_with url: public_rooms_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do |f| %>
        <div class="text-left">
          <label class="text-xs font-semibold text-gray-700 mb-1 block">Check In</label>
          <%= f.date_field :check_in_date, 
              value: Date.current,
              min: Date.current,
              class: "w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900",
              required: true %>
        </div>
        
        <div class="text-left">
          <label class="text-xs font-semibold text-gray-700 mb-1 block">Check Out</label>
          <%= f.date_field :check_out_date, 
              value: Date.current + 1,
              min: Date.current + 1,
              class: "w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900",
              required: true %>
        </div>
        
        <div class="text-left">
          <label class="text-xs font-semibold text-gray-700 mb-1 block">Guests</label>
          <%= f.select :guests, 
              options_for_select((1..8).map { |i| [i == 1 ? "1 Guest" : "#{i} Guests", i] }, 2),
              {},
              class: "w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900" %>
        </div>
        
        <%= f.submit "View Rooms", 
            class: "bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold py-3 px-6 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-200 cursor-pointer shadow-lg hover:shadow-xl" %>
      <% end %>
    </div>
  </div>
  
  <%# Scroll Indicator %>
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<%# Room Types Section %>
<section class="py-16 md:py-24 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Accommodations</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Choose from our selection of beautifully designed rooms and suites
        <% if @hotel.total_rooms.present? && @hotel.total_rooms > 0 %>
          <span class="block mt-1 text-sm">(<%= @hotel.total_rooms %> rooms total)</span>
        <% end %>
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      <% @room_types.each do |room_type| %>
        <div class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
          <%# Room Image %>
          <div class="relative h-64 overflow-hidden">
            <%= image_tag "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=1000", 
                class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500",
                alt: room_type.name %>
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full">
              <span class="text-sm font-semibold text-gray-900">From $<%= room_type.base_price.to_i %></span>
            </div>
          </div>
          
          <%# Room Details %>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= room_type.name %></h3>
            <p class="text-gray-600 mb-4 line-clamp-2">
              <%= room_type.description || "Elegant and comfortable accommodation with modern amenities" %>
            </p>
            
            <%# Room Features %>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="inline-flex items-center px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Up to <%= room_type.max_occupancy %> guests
              </span>
              <% if room_type.size_sqm.present? %>
                <span class="inline-flex items-center px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                  </svg>
                  <%= room_type.size_sqm.to_i %> m²
                </span>
              <% end %>
            </div>
            
            <div class="flex gap-2">
              <%= link_to "View Details", 
                  public_room_path(room_type),
                  class: "flex-1 text-center border border-gray-300 text-gray-700 font-semibold py-2 px-3 rounded-lg hover:bg-gray-50 transition-colors duration-200" %>
              <%= link_to "Book Now", 
                  public_availability_index_path(room_type_id: room_type.id),
                  class: "flex-1 text-center bg-gray-900 text-white font-semibold py-2 px-3 rounded-lg hover:bg-gray-800 transition-colors duration-200" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    
    <%# View All Rooms Button %>
    <div class="text-center mt-8">
      <%= link_to "View All Rooms & Suites", 
          public_rooms_path,
          class: "inline-block bg-blue-600 text-white font-semibold py-3 px-8 rounded-lg hover:bg-blue-700 transition-colors duration-200 shadow-lg" %>
    </div>
  </div>
</section>

<%# Amenities Section %>
<section class="py-16 md:py-24 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Hotel Amenities</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">Everything you need for a comfortable stay</p>
    </div>
    
    <% if @hotel_amenities.any? %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
        <% @hotel_amenities.each do |amenity| %>
          <% hotel_amenity = amenity.hotel_amenities.find_by(hotel: @hotel) %>
          <div class="text-center group">
            <div class="w-16 h-16 mx-auto mb-3 bg-gray-100 rounded-full flex items-center justify-center group-hover:bg-blue-100 transition-colors duration-200">
              <% if amenity.icon.present? %>
                <i class="fa-solid fa-<%= amenity.icon %> text-2xl text-gray-700 group-hover:text-blue-600 transition-colors duration-200"></i>
              <% else %>
                <svg class="w-8 h-8 text-gray-700 group-hover:text-blue-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              <% end %>
            </div>
            <p class="text-sm font-medium text-gray-900"><%= amenity.name %></p>
            <% if hotel_amenity && !hotel_amenity.is_free && hotel_amenity.additional_cost.present? %>
              <p class="text-xs text-gray-500 mt-1">+$<%= hotel_amenity.additional_cost.to_i %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Fallback to some default amenities if none are configured %>
      <div class="text-center text-gray-500">
        <p>Amenities information coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<%# Location Section %>
<section class="py-16 md:py-24 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Perfect Location</h2>
        <p class="text-gray-600 mb-8">
          Located in the heart of <%= @hotel.city %>, our hotel puts you within easy reach of major attractions, 
          business districts, and entertainment venues.
        </p>
        
        <div class="space-y-4">
          <div class="flex items-start">
            <svg class="w-6 h-6 text-blue-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <h3 class="font-semibold text-gray-900"><%= @hotel.address %></h3>
              <p class="text-gray-600"><%= @hotel.city %>, <%= @hotel.state %> <%= @hotel.postal_code %></p>
              <p class="text-gray-600"><%= @hotel.country %></p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg class="w-6 h-6 text-blue-600 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <div>
              <h3 class="font-semibold text-gray-900">Contact Us</h3>
              <p class="text-gray-600"><%= @hotel.phone %></p>
              <p class="text-gray-600"><%= @hotel.email %></p>
              <% if @hotel.website.present? %>
                <p class="text-gray-600"><%= link_to @hotel.website, @hotel.website, target: "_blank", class: "text-blue-600 hover:underline" %></p>
              <% end %>
              <p class="text-gray-600 text-sm mt-1">Timezone: <%= @hotel.timezone %></p>
            </div>
          </div>
        </div>
        
        <div class="mt-8">
          <%= link_to "Get Directions", 
              "https://maps.google.com/?q=#{@hotel.address},#{@hotel.city},#{@hotel.state}",
              target: "_blank",
              class: "inline-flex items-center bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-200" %>
        </div>
      </div>
      
      <div class="relative h-96 lg:h-full min-h-[400px] rounded-xl overflow-hidden shadow-xl">
        <div class="absolute inset-0 bg-gray-200">
          <%# Map placeholder - in production, integrate with Google Maps %>
          <%= image_tag "https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=1000", 
              class: "w-full h-full object-cover",
              alt: "Map location" %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Check-in/Check-out Times %>
<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 text-center">
      <div class="border border-gray-200 rounded-lg p-6">
        <svg class="w-12 h-12 text-blue-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Check-in Time</h3>
        <p class="text-2xl font-bold text-gray-900"><%= @hotel.check_in_time.strftime("%l:%M %p") %></p>
      </div>
      <div class="border border-gray-200 rounded-lg p-6">
        <svg class="w-12 h-12 text-blue-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Check-out Time</h3>
        <p class="text-2xl font-bold text-gray-900"><%= @hotel.check_out_time.strftime("%l:%M %p") %></p>
      </div>
    </div>
  </div>
</section>

<%# CTA Section %>
<section class="py-16 md:py-24 bg-gradient-to-r from-blue-600 to-blue-700">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to Book Your Stay?</h2>
    <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">
      Experience exceptional hospitality and create unforgettable memories with us
    </p>
    <%= link_to "Browse Rooms & Book", 
        public_rooms_path,
        class: "inline-block bg-white text-blue-600 font-bold py-4 px-8 rounded-lg hover:bg-gray-100 transition-colors duration-200 shadow-xl" %>
  </div>
</section>

<%# Add smooth animations %>
<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>