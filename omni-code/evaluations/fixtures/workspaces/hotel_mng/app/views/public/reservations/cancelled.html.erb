<%# Cancellation Success Page %>
<div class="min-h-screen bg-gray-50">
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <%# Header with Success Icon %>
        <div class="bg-gray-600 p-6 text-center">
          <svg class="w-20 h-20 text-white mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h1 class="text-3xl font-bold text-white mb-2">Reservation Cancelled</h1>
          <p class="text-white/90">Your reservation has been successfully cancelled</p>
        </div>
        
        <%# Cancellation Details %>
        <div class="p-8">
          <%# Confirmation Number %>
          <div class="bg-gray-100 border-2 border-gray-300 rounded-lg p-4 mb-6 text-center">
            <p class="text-sm text-gray-700 mb-1">Cancelled Reservation</p>
            <p class="text-2xl font-bold text-gray-900"><%= @reservation.confirmation_number %></p>
            <p class="text-xs text-gray-600 mt-2">Please save this for your records</p>
          </div>
          
          <%# Cancellation Summary %>
          <div class="space-y-6">
            <%# Original Booking Details %>
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-3">Original Booking Details</h2>
              <div class="bg-gray-50 rounded-lg p-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                  <div>
                    <span class="text-gray-600">Guest Name:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= @reservation.guest.full_name %></span>
                  </div>
                  <div>
                    <span class="text-gray-600">Hotel:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= @hotel.name %></span>
                  </div>
                  <div>
                    <span class="text-gray-600">Check-in Date:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= @reservation.check_in_date.strftime("%B %d, %Y") %></span>
                  </div>
                  <div>
                    <span class="text-gray-600">Check-out Date:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= @reservation.check_out_date.strftime("%B %d, %Y") %></span>
                  </div>
                  <div>
                    <span class="text-gray-600">Room Type:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= @reservation.room_type.name %></span>
                  </div>
                  <div>
                    <span class="text-gray-600">Cancellation Date:</span>
                    <span class="font-medium text-gray-900 ml-2"><%= Date.current.strftime("%B %d, %Y") %></span>
                  </div>
                </div>
              </div>
            </div>
            
            <%# Refund Information %>
            <% if @reservation.paid_amount > 0 %>
              <div>
                <h2 class="text-lg font-semibold text-gray-900 mb-3">Refund Information</h2>
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                  <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                      <span class="text-gray-700">Original Payment:</span>
                      <span class="font-medium text-gray-900">$<%= @reservation.paid_amount.to_i %></span>
                    </div>
                    <div class="flex justify-between text-sm">
                      <span class="text-gray-700">Cancellation Fee:</span>
                      <span class="font-medium text-red-600">-$<%= @reservation.calculate_cancellation_fee.to_i %></span>
                    </div>
                    <div class="pt-2 border-t border-blue-200 flex justify-between">
                      <span class="font-medium text-gray-900">Refund Amount:</span>
                      <span class="text-xl font-bold text-green-600">$<%= @reservation.refundable_amount.to_i %></span>
                    </div>
                  </div>
                  
                  <% if @reservation.refundable_amount > 0 %>
                    <div class="mt-4 p-3 bg-blue-100 rounded">
                      <p class="text-sm text-blue-800">
                        <strong>Refund Status:</strong> Your refund will be processed within 5-7 business days and credited to your original payment method.
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            
            <%# Next Steps %>
            <div class="border-t pt-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-3">What's Next?</h2>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>A cancellation confirmation email has been sent to <%= @reservation.guest.email %></span>
                </li>
                <% if @reservation.refundable_amount > 0 %>
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>Your refund will be processed within 5-7 business days</span>
                  </li>
                <% end %>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>Keep this confirmation for your records</span>
                </li>
              </ul>
            </div>
            
            <%# Actions %>
            <div class="mt-8 pt-6 border-t">
              <div class="flex flex-col sm:flex-row gap-4">
                <%= link_to "Make a New Reservation", 
                    public_hotel_path,
                    class: "flex-1 text-center bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-200" %>
                <%= link_to "Return to Home", 
                    root_path,
                    class: "flex-1 text-center bg-gray-200 text-gray-900 font-semibold py-3 px-6 rounded-lg hover:bg-gray-300 transition-colors duration-200" %>
              </div>
            </div>
            
            <%# Contact Information %>
            <div class="mt-6 p-4 bg-gray-50 border border-gray-200 rounded-lg">
              <p class="text-sm text-gray-700">
                <strong>Need Help?</strong> If you have any questions about your cancellation or refund, please contact us:
              </p>
              <div class="mt-2 text-sm">
                <p class="text-gray-600">
                  <a href="tel:<%= @hotel.phone %>" class="text-blue-600 hover:underline"><%= @hotel.phone %></a> • 
                  <a href="mailto:<%= @hotel.email %>" class="text-blue-600 hover:underline"><%= @hotel.email %></a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>