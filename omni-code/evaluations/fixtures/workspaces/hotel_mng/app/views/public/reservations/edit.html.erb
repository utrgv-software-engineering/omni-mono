<%# Reservation Modification Form %>
<div class="min-h-screen bg-gray-50">
  <%# Header %>
  <div class="bg-gradient-to-r from-blue-600 to-blue-700 py-8">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold text-white mb-2">Modify Your Reservation</h1>
      <p class="text-white/90">
        Confirmation Number: <%= @reservation.confirmation_number %>
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <%# Modification Form %>
      <%= form_with model: @reservation, url: public_reservation_path(@reservation.confirmation_number), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :email, params[:email] %>
        <%= hidden_field_tag :phone, params[:phone] %>
        
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 class="text-xl font-bold text-gray-900 mb-6">Update Stay Details</h2>
          
          <%# Current Reservation Info %>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
            <h3 class="font-semibold text-blue-900 mb-2">Current Reservation</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
              <div>
                <span class="text-blue-700">Room Type:</span>
                <span class="font-medium text-blue-900"><%= @reservation.room_type.name %></span>
              </div>
              <div>
                <span class="text-blue-700">Check-in:</span>
                <span class="font-medium text-blue-900"><%= @reservation.check_in_date.strftime("%b %d, %Y") %></span>
              </div>
              <div>
                <span class="text-blue-700">Check-out:</span>
                <span class="font-medium text-blue-900"><%= @reservation.check_out_date.strftime("%b %d, %Y") %></span>
              </div>
            </div>
          </div>
          
          <%# Date Selection %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <%= f.label :check_in_date, "New Check-in Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.date_field :check_in_date,
                  value: @check_in_date,
                  min: Date.current,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                  required: true %>
            </div>
            
            <div>
              <%= f.label :check_out_date, "New Check-out Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.date_field :check_out_date,
                  value: @check_out_date,
                  min: Date.current + 1,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                  required: true %>
            </div>
          </div>
          
          <%# Room Type Selection %>
          <div class="mb-6">
            <%= f.label :room_type_id, "Room Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <p class="text-xs text-gray-500 mb-2">Select a different room type if desired (subject to availability)</p>
            <%= f.select :room_type_id,
                options_for_select(@room_types.map { |rt| 
                  ["#{rt.name} - $#{rt.base_price.to_i}/night (Max #{rt.max_occupancy} guests)", rt.id] 
                }, @reservation.room_type_id),
                {},
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
          
          <%# Guest Count %>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div>
              <%= f.label :adults, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :adults,
                  value: @guests,
                  min: 1,
                  max: 8,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                  required: true %>
            </div>
            
            <div>
              <%= f.label :children, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :children,
                  min: 0,
                  max: 6,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
            </div>
            
            <div>
              <%= f.label :infants, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :infants,
                  min: 0,
                  max: 4,
                  value: 0,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
            </div>
          </div>
          
          <%# Special Requests %>
          <div class="mb-6">
            <%= f.label :special_requests, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <p class="text-xs text-gray-500 mb-2">Update any special requests or preferences</p>
            <%= f.text_area :special_requests,
                rows: 3,
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
        </div>
        
        <%# Important Notes %>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
          <h3 class="font-semibold text-amber-900 mb-2 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            Important Information
          </h3>
          <ul class="text-sm text-amber-800 space-y-1">
            <li>• Changes are subject to availability</li>
            <li>• Price differences will be calculated and shown before confirmation</li>
            <li>• You can modify your reservation up to 24 hours before check-in</li>
            <li>• Room assignments may change with date or room type modifications</li>
          </ul>
        </div>
        
        <%# Actions %>
        <div class="flex items-center justify-between">
          <%= link_to "← Cancel Changes",
              public_reservation_path(@reservation.confirmation_number,
                                     email: params[:email],
                                     phone: params[:phone]),
              class: "text-gray-600 hover:text-gray-900" %>
          <%= f.submit "Update Reservation",
              class: "bg-blue-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-blue-700 transition-colors duration-200 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>