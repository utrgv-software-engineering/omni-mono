<%# Reservation Lookup Page %>
<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-md mx-auto">
      <div class="bg-white rounded-lg shadow-lg p-8">
        <%# Header %>
        <div class="text-center mb-8">
          <svg class="w-16 h-16 text-blue-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <h1 class="text-2xl font-bold text-gray-900 mb-2">Find Your Reservation</h1>
          <p class="text-gray-600">Enter your details to view or modify your booking</p>
        </div>
        
        <%# Lookup Form %>
        <%= form_with url: public_reservation_search_path, method: :post, local: true do |f| %>
          <div class="space-y-4">
            <%# Confirmation Number %>
            <div>
              <%= f.label :confirmation_number, "Confirmation Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :confirmation_number, 
                  required: true,
                  placeholder: "e.g., ABC123XY",
                  class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent uppercase" %>
              <p class="text-xs text-gray-500 mt-1">This was provided when you made your booking</p>
            </div>
            
            <%# Email or Phone %>
            <div>
              <p class="text-sm font-medium text-gray-700 mb-2">Verify with Email OR Phone</p>
              
              <div class="space-y-3">
                <div>
                  <%= f.label :email, "Email Address", class: "block text-sm text-gray-600 mb-1" %>
                  <%= f.email_field :email, 
                      placeholder: "email@example.com",
                      class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                </div>
                
                <div class="text-center text-gray-500 text-sm">— OR —</div>
                
                <div>
                  <%= f.label :phone, "Phone Number", class: "block text-sm text-gray-600 mb-1" %>
                  <%= f.telephone_field :phone, 
                      placeholder: "Your phone number",
                      class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                </div>
              </div>
              
              <p class="text-xs text-gray-500 mt-2">Enter either the email or phone number used for the booking</p>
            </div>
            
            <%# Submit Button %>
            <div class="pt-4">
              <%= f.submit "Find Reservation", 
                  class: "w-full bg-blue-600 text-white font-semibold py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors duration-200 cursor-pointer" %>
            </div>
          </div>
        <% end %>
        
        <%# Help Section %>
        <div class="mt-8 pt-6 border-t">
          <h3 class="text-sm font-semibold text-gray-900 mb-2">Need Help?</h3>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>• Your confirmation number was sent to your email after booking</li>
            <li>• Use the same email or phone number you provided during booking</li>
            <li>• If you still can't find your reservation, please contact us</li>
          </ul>
          
          <div class="mt-4 p-3 bg-gray-50 rounded-lg">
            <p class="text-sm text-gray-700">
              <span class="font-medium">Contact Support:</span><br>
              Call us at <a href="tel:1-800-HOTEL" class="text-blue-600 hover:underline">1-800-HOTEL</a><br>
              Email: <a href="mailto:support@hotel.com" class="text-blue-600 hover:underline">support@hotel.com</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>