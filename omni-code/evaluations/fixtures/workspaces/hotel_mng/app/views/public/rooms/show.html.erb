<%# Room Gallery and Details %>
<section class="py-8 bg-white">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <%# Image Gallery %>
      <div class="space-y-4">
        <div class="relative h-96 rounded-xl overflow-hidden">
          <%= image_tag "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=1500", 
              class: "w-full h-full object-cover",
              alt: @room_type.name %>
          <% if @available_count > 0 %>
            <div class="absolute top-4 left-4 bg-green-500 text-white px-4 py-2 rounded-full font-semibold">
              <%= @available_count %> <%= @available_count == 1 ? 'Room' : 'Rooms' %> Available
            </div>
          <% else %>
            <div class="absolute top-4 left-4 bg-red-500 text-white px-4 py-2 rounded-full font-semibold">
              Sold Out for These Dates
            </div>
          <% end %>
        </div>
        
        <%# Thumbnail Gallery %>
        <div class="grid grid-cols-4 gap-2">
          <% ["photo-1618773928121-c32242e63f39", "photo-1616594039964-ae9021a400a0", "photo-1595526114035-0d45ed16cfbf", "photo-1609766857041-ed402ea8069a"].each do |photo_id| %>
            <div class="relative h-24 rounded-lg overflow-hidden cursor-pointer hover:opacity-80 transition-opacity">
              <%= image_tag "https://images.unsplash.com/#{photo_id}?q=80&w=400", 
                  class: "w-full h-full object-cover",
                  alt: "Room view" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <%# Room Information %>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= @room_type.name %></h1>
        
        <%# Quick Info Grid %>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <div>
              <p class="text-sm text-gray-600">Max Occupancy</p>
              <p class="font-semibold text-gray-900"><%= @room_type.max_occupancy %> Guests</p>
            </div>
          </div>
          
          <% if @room_type.size_sqm.present? %>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
              </svg>
              <div>
                <p class="text-sm text-gray-600">Room Size</p>
                <p class="font-semibold text-gray-900"><%= @room_type.size_sqm %> m²</p>
              </div>
            </div>
          <% end %>
          
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <div>
              <p class="text-sm text-gray-600">Standard Occupancy</p>
              <p class="font-semibold text-gray-900"><%= @room_type.standard_occupancy %> Guests</p>
            </div>
          </div>
          
          <% if @room_type.extra_person_charge > 0 %>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <p class="text-sm text-gray-600">Extra Person</p>
                <p class="font-semibold text-gray-900">+$<%= @room_type.extra_person_charge.to_i %>/night</p>
              </div>
            </div>
          <% end %>
        </div>
        
        <%# Description %>
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">About this room</h2>
          <p class="text-gray-600 leading-relaxed">
            <%= @room_type.description || "Experience the perfect blend of comfort and style in our #{@room_type.name.downcase}. This thoughtfully designed space offers everything you need for a memorable stay at #{@hotel.name}. Whether you're here for business or leisure, you'll appreciate the attention to detail and modern amenities that make your stay exceptional." %>
          </p>
        </div>
        
        <%# Amenities %>
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Room Amenities</h2>
          <% if @room_amenities.any? %>
            <div class="grid grid-cols-2 gap-3">
              <% @room_amenities.each do |amenity| %>
                <% room_type_amenity = amenity.room_type_amenities.find_by(room_type: @room_type) %>
                <div class="flex items-center">
                  <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-gray-700">
                    <%= amenity.name %>
                    <% if room_type_amenity && room_type_amenity.quantity > 1 %>
                      <span class="text-xs text-gray-500">(x<%= room_type_amenity.quantity %>)</span>
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>
          <% else %>
            <%# Fallback if no amenities configured %>
            <p class="text-gray-600">Contact us for amenity details.</p>
          <% end %>
        </div>
        
        <%# Booking Section %>
        <div class="bg-gray-50 rounded-xl p-6">
          <div class="flex items-baseline justify-between mb-4">
            <div>
              <span class="text-3xl font-bold text-gray-900">$<%= @total_price.to_i %></span>
              <span class="text-gray-600 ml-2">total</span>
            </div>
            <div class="text-right">
              <p class="text-lg font-semibold text-gray-900">$<%= @room_type.base_price.to_i %></p>
              <p class="text-sm text-gray-600">per night</p>
            </div>
          </div>
          
          <div class="space-y-2 mb-4 pb-4 border-b">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Check-in</span>
              <span class="font-medium text-gray-900"><%= @check_in_date.strftime("%B %d, %Y") %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Check-out</span>
              <span class="font-medium text-gray-900"><%= @check_out_date.strftime("%B %d, %Y") %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Nights</span>
              <span class="font-medium text-gray-900"><%= @nights %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Guests</span>
              <span class="font-medium text-gray-900"><%= @guests %></span>
            </div>
          </div>
          
          <div class="flex gap-3">
            <%= link_to "Change Dates", 
                public_rooms_path(check_in_date: @check_in_date, check_out_date: @check_out_date, guests: @guests),
                class: "flex-1 text-center border border-gray-300 text-gray-700 font-semibold py-3 px-4 rounded-lg hover:bg-white transition-colors duration-200" %>
            
            <% if @available_count > 0 %>
              <%= link_to "Book Now", 
                  new_public_booking_path(room_type_id: @room_type.id, check_in_date: @check_in_date, check_out_date: @check_out_date, guests: @guests),
                  class: "flex-1 text-center bg-blue-600 text-white font-semibold py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors duration-200" %>
            <% else %>
              <button disabled class="flex-1 text-center bg-gray-300 text-gray-500 font-semibold py-3 px-4 rounded-lg cursor-not-allowed">
                Not Available
              </button>
            <% end %>
          </div>
          
          <% if @available_count > 0 && @available_count <= 3 %>
            <p class="text-sm text-orange-600 mt-3 text-center">
              Only <%= @available_count %> <%= @available_count == 1 ? 'room' : 'rooms' %> left at this price!
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Policies Section %>
<section class="py-12 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Hotel Policies</h2>
    
    <% if @hotel_policies.any? || @cancellation_policy %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <%# Check-in/out policy %>
        <% check_in_policy = @hotel_policies.find { |p| p.policy_type == 'check_in' || p.policy_type == 'check_out' } %>
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Check-in / Check-out</h3>
          <% if check_in_policy %>
            <p class="text-sm text-gray-600"><%= check_in_policy.description %></p>
          <% else %>
            <p class="text-sm text-gray-600">Check-in: <%= @hotel.check_in_time.strftime("%l:%M %p") %></p>
            <p class="text-sm text-gray-600">Check-out: <%= @hotel.check_out_time.strftime("%l:%M %p") %></p>
            <p class="text-sm text-gray-600 mt-2">Valid ID required at check-in</p>
          <% end %>
        </div>
        
        <%# Cancellation policy %>
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Cancellation Policy</h3>
          <% if @cancellation_policy %>
            <p class="text-sm text-gray-600">
              <%= @cancellation_policy.description || "#{@cancellation_policy.cancellation_type.humanize} cancellation policy applies." %>
              <% if @cancellation_policy.free_cancellation_hours.present? %>
                Free cancellation up to <%= @cancellation_policy.free_cancellation_hours %> hours before check-in.
              <% end %>
              <% if @cancellation_policy.penalty_percentage.present? %>
                Late cancellations incur <%= @cancellation_policy.penalty_percentage %>% charge.
              <% end %>
            </p>
          <% elsif cancellation_hotel_policy = @hotel_policies.find { |p| p.policy_type == 'cancellation' } %>
            <p class="text-sm text-gray-600"><%= cancellation_hotel_policy.description %></p>
          <% else %>
            <p class="text-sm text-gray-600">Contact hotel for cancellation policy details.</p>
          <% end %>
        </div>
        
        <%# Payment policy %>
        <% payment_policy = @hotel_policies.find { |p| p.policy_type == 'payment' } %>
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Payment</h3>
          <% if payment_policy %>
            <p class="text-sm text-gray-600"><%= payment_policy.description %></p>
          <% else %>
            <p class="text-sm text-gray-600">Contact hotel for payment policy details.</p>
          <% end %>
        </div>
      </div>
      
      <%# Additional policies %>
      <% other_policies = @hotel_policies.reject { |p| ['check_in', 'check_out', 'cancellation', 'payment'].include?(p.policy_type) } %>
      <% if other_policies.any? %>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
          <% other_policies.each do |policy| %>
            <div class="bg-white rounded-lg p-6">
              <h3 class="font-semibold text-gray-900 mb-2"><%= policy.title %></h3>
              <p class="text-sm text-gray-600"><%= policy.description %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Check-in / Check-out</h3>
          <p class="text-sm text-gray-600">Check-in: <%= @hotel.check_in_time.strftime("%l:%M %p") %></p>
          <p class="text-sm text-gray-600">Check-out: <%= @hotel.check_out_time.strftime("%l:%M %p") %></p>
        </div>
        
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Policies</h3>
          <p class="text-sm text-gray-600">Contact hotel for policy details.</p>
        </div>
        
        <div class="bg-white rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Contact</h3>
          <p class="text-sm text-gray-600"><%= @hotel.phone %></p>
          <p class="text-sm text-gray-600"><%= @hotel.email %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# Other Rooms Section %>
<section class="py-12 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Other Room Options</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @hotel.room_types.where.not(id: @room_type.id).limit(3).each do |other_room| %>
        <div class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <%= link_to public_room_path(other_room, check_in_date: @check_in_date, check_out_date: @check_out_date, guests: @guests) do %>
            <div class="relative h-48">
              <%= image_tag "https://images.unsplash.com/photo-1618773928121-c32242e63f39?q=80&w=800", 
                  class: "w-full h-full object-cover",
                  alt: other_room.name %>
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-gray-900 mb-1"><%= other_room.name %></h3>
              <p class="text-sm text-gray-600 mb-2">Up to <%= other_room.max_occupancy %> guests</p>
              <p class="text-lg font-bold text-gray-900">From $<%= other_room.base_price.to_i %>/night</p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <div class="text-center mt-8">
      <%= link_to "View All Rooms", 
          public_rooms_path(check_in_date: @check_in_date, check_out_date: @check_out_date, guests: @guests),
          class: "inline-block border border-gray-300 text-gray-700 font-semibold py-3 px-6 rounded-lg hover:bg-gray-50 transition-colors duration-200" %>
    </div>
  </div>
</section>