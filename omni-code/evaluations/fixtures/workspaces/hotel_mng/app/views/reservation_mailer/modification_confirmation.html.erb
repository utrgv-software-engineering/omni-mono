<!DOCTYPE html>
<html>
  <body style="margin:0;padding:0;background-color:#f4f5f7;font-family:'Helvetica Neue',Arial,sans-serif;color:#111827;">
    <% hotel_location = [@hotel.address, @hotel.city, @hotel.state, @hotel.country].reject(&:blank?).join(', ') %>
    <% stay_window = "#{@reservation.check_in_date.strftime('%B %d, %Y')} to #{@reservation.check_out_date.strftime('%B %d, %Y')}" %>
    <% check_in_time = @hotel.check_in_time&.strftime('%-I:%M %p') || 'Contact the hotel for the check-in time' %>
    <% check_out_time = @hotel.check_out_time&.strftime('%-I:%M %p') || 'Contact the hotel for the check-out time' %>
    <% total_rate = number_to_currency(@reservation.total_amount) %>
    <% balance_due = number_to_currency(@reservation.balance_due) %>
    <% guest_count = pluralize(@reservation.total_guests, 'guest') %>
    <% special_requests = @reservation.special_requests.presence || 'None provided' %>
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" style="padding:24px;">
          <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.08);">
            <tr>
              <td style="background-color:#111827;color:#ffffff;padding:32px;text-align:center;">
                <div style="font-size:24px;font-weight:600;">Reservation Updated</div>
                <div style="margin-top:8px;font-size:14px;letter-spacing:1px;text-transform:uppercase;opacity:0.8;">Confirmation <%= @reservation.confirmation_number %></div>
                <div style="margin-top:12px;font-size:18px;font-weight:500;"><%= @hotel.name %></div>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;">Hi <%= @guest.first_name %>,</p>
                <p style="margin:0 0 24px;">Your reservation has been updated. Please review the latest details below.</p>
                <table style="width:100%;border-collapse:collapse;margin:0 0 24px;">
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Stay</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= stay_window %> (<%= pluralize(@reservation.nights, 'night') %>)</td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Check-in Time</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= check_in_time %></td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Check-out Time</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= check_out_time %></td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Room Type</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= @room_type.name %></td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Guests</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= guest_count %></td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Status</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= @reservation.status.titleize %></td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;">Total Rate</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;"><%= total_rate %> (<%= @reservation.currency %>)</td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#6b7280;border-bottom:1px solid #e5e7eb;">Balance Due</td>
                    <td style="padding:8px 0;text-align:right;color:#111827;border-bottom:1px solid #e5e7eb;"><%= balance_due %></td>
                  </tr>
                </table>
                <div style="padding:20px;border:1px solid #e5e7eb;border-radius:10px;margin-bottom:24px;">
                  <div style="font-weight:600;margin-bottom:8px;color:#111827;">Special Requests</div>
                  <div style="color:#374151;line-height:1.5;"><%= special_requests %></div>
                </div>
                <div style="padding:20px;background-color:#f9fafb;border-radius:10px;margin-bottom:24px;">
                  <div style="font-weight:600;margin-bottom:8px;color:#111827;">Hotel Information</div>
                  <div style="color:#374151;line-height:1.5;">
                    <div><strong><%= @hotel.name %></strong></div>
                    <% if hotel_location.present? %>
                      <div><%= hotel_location %></div>
                    <% end %>
                    <% if @hotel.phone.present? %>
                      <div>Phone: <%= @hotel.phone %></div>
                    <% end %>
                    <% if @hotel.email.present? %>
                      <div>Email: <%= @hotel.email %></div>
                    <% end %>
                    <% if @hotel.website.present? %>
                      <div>Website: <%= @hotel.website %></div>
                    <% end %>
                  </div>
                </div>
                <p style="margin:0 0 24px;">If anything looks incorrect, reply to this email or call us so we can help.</p>
                <p style="margin:0;">We look forward to welcoming you,<br><strong><%= @hotel.name %> Team</strong></p>
              </td>
            </tr>
            <tr>
              <td style="background-color:#f3f4f6;padding:20px;text-align:center;color:#6b7280;font-size:13px;">
                <div>This message was sent from <%= @hotel.name %>.</div>
                <div style="margin-top:4px;">Confirmation <%= @reservation.confirmation_number %></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
