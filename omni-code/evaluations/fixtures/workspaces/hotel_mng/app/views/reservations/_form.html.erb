<%= form_with(model: reservation, local: true) do |form| %>
  <% if reservation.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(reservation.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% reservation.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="px-6 py-4 space-y-6">
    <!-- Guest Information Section -->
    <div>
      <h3 class="text-lg font-medium text-gray-900 mb-4">Guest Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Guest Selection -->
        <div class="md:col-span-2">
          <label for="reservation_guest_id" class="block text-sm font-medium text-gray-700 mb-1">
            Guest <span class="text-red-500">*</span>
          </label>
          <% if reservation.new_record? %>
            <div class="space-y-2">
              <div class="flex space-x-4">
                <label class="inline-flex items-center">
                  <input type="radio" name="guest_type" value="existing" checked class="mr-2" data-action="change->reservation-form#toggleGuestType">
                  <span class="text-sm text-gray-700">Existing Guest</span>
                </label>
                <label class="inline-flex items-center">
                  <input type="radio" name="guest_type" value="new" class="mr-2" data-action="change->reservation-form#toggleGuestType">
                  <span class="text-sm text-gray-700">New Guest</span>
                </label>
              </div>
              
              <!-- Existing Guest Selector -->
              <div id="existing-guest-section">
                <%= form.select :guest_id, 
                    options_for_select(Guest.all.order(:last_name, :first_name).map { |g| [g.full_name + " - " + g.email, g.id] }, reservation.guest_id),
                    { prompt: "Select a guest..." },
                    { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
              </div>
              
              <!-- New Guest Fields (hidden by default) -->
              <div id="new-guest-section" class="hidden space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">First Name <span class="text-red-500">*</span></label>
                    <input type="text" name="guest[first_name]" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Last Name <span class="text-red-500">*</span></label>
                    <input type="text" name="guest[last_name]" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                    <input type="email" name="guest[email]" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                    <input type="tel" name="guest[phone]" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <!-- For editing, just show the guest name -->
            <div class="px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
              <%= link_to reservation.guest.full_name, guest_path(reservation.guest), class: "text-blue-600 hover:text-blue-800" %>
              <span class="text-gray-500 ml-2"><%= reservation.guest.email %></span>
            </div>
            <%= form.hidden_field :guest_id %>
          <% end %>
        </div>

        <!-- Number of Guests -->
        <div>
          <label for="reservation_adults" class="block text-sm font-medium text-gray-700 mb-1">
            Adults <span class="text-red-500">*</span>
          </label>
          <%= form.number_field :adults, 
              min: 1, 
              max: 10,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        
        <div>
          <label for="reservation_children" class="block text-sm font-medium text-gray-700 mb-1">
            Children
          </label>
          <%= form.number_field :children, 
              min: 0, 
              max: 10,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        
        <div>
          <label for="reservation_infants" class="block text-sm font-medium text-gray-700 mb-1">
            Infants
          </label>
          <%= form.number_field :infants, 
              min: 0, 
              max: 5,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>
    </div>

    <!-- Booking Details Section -->
    <div class="border-t border-gray-200 pt-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Booking Details</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Hotel Selection -->
        <div>
          <label for="reservation_hotel_id" class="block text-sm font-medium text-gray-700 mb-1">
            Hotel <span class="text-red-500">*</span>
          </label>
          <% if current_tenant.hotels.count == 1 %>
            <%= form.hidden_field :hotel_id, value: current_tenant.hotels.first.id %>
            <div class="px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
              <%= current_tenant.hotels.first.name %>
            </div>
          <% else %>
            <%= form.select :hotel_id, 
                options_for_select(current_tenant.hotels.map { |h| [h.name, h.id] }, reservation.hotel_id || current_hotel&.id),
                { prompt: "Select a hotel..." },
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                  data: { action: "change->reservation-form#updateRoomTypes" } } %>
          <% end %>
        </div>

        <!-- Room Type -->
        <div>
          <label for="reservation_room_type_id" class="block text-sm font-medium text-gray-700 mb-1">
            Room Type <span class="text-red-500">*</span>
          </label>
          <%= form.select :room_type_id, 
              options_for_select(
                reservation.hotel ? reservation.hotel.room_types.map { |rt| ["#{rt.name} - $#{rt.base_price}/night (Max: #{rt.max_occupancy})", rt.id] } : [],
                reservation.room_type_id
              ),
              { prompt: "Select room type..." },
              { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                data: { action: "change->reservation-form#updateAvailableRooms" } } %>
        </div>

        <!-- Check-in Date -->
        <div>
          <label for="reservation_check_in_date" class="block text-sm font-medium text-gray-700 mb-1">
            Check-in Date <span class="text-red-500">*</span>
          </label>
          <%= form.date_field :check_in_date, 
              min: Date.today,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              data: { action: "change->reservation-form#updatePricing" } %>
        </div>

        <!-- Check-out Date -->
        <div>
          <label for="reservation_check_out_date" class="block text-sm font-medium text-gray-700 mb-1">
            Check-out Date <span class="text-red-500">*</span>
          </label>
          <%= form.date_field :check_out_date, 
              min: Date.today + 1.day,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              data: { action: "change->reservation-form#updatePricing" } %>
        </div>

        <!-- Room Assignment (Optional) -->
        <div>
          <label for="reservation_room_id" class="block text-sm font-medium text-gray-700 mb-1">
            Assign Room <span class="text-gray-500 text-xs">(Optional)</span>
          </label>
          <% if reservation.checked_in? || reservation.checked_out? %>
            <div class="px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
              Room <%= reservation.room&.room_number || "Not assigned" %>
            </div>
            <%= form.hidden_field :room_id %>
          <% else %>
            <%= form.select :room_id, 
                options_for_select(
                  reservation.room_type ? reservation.hotel.rooms.where(room_type: reservation.room_type, status: 'available').map { |r| [r.room_number, r.id] } : [],
                  reservation.room_id
                ),
                { prompt: "Auto-assign at check-in...", include_blank: true },
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          <% end %>
        </div>

        <!-- Booking Source -->
        <div>
          <label for="reservation_source" class="block text-sm font-medium text-gray-700 mb-1">
            Booking Source
          </label>
          <%= form.select :source, 
              options_for_select(Reservation::SOURCES.map { |s| [s.humanize, s] }, reservation.source),
              { prompt: "Select source..." },
              { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <!-- Status -->
        <div>
          <label for="reservation_status" class="block text-sm font-medium text-gray-700 mb-1">
            Status
          </label>
          <% if reservation.checked_in? || reservation.checked_out? %>
            <div class="px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
              <%= reservation.status.humanize %>
            </div>
            <%= form.hidden_field :status %>
          <% else %>
            <%= form.select :status, 
                options_for_select(
                  reservation.new_record? ? [['Pending', 'pending'], ['Confirmed', 'confirmed']] : Reservation::STATUSES.map { |s| [s.humanize, s] },
                  reservation.status
                ),
                {},
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Pricing & Payment Section -->
    <div class="border-t border-gray-200 pt-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Pricing & Payment</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Total Amount -->
        <div>
          <label for="reservation_total_amount" class="block text-sm font-medium text-gray-700 mb-1">
            Total Amount <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-gray-500">$</span>
            <%= form.number_field :total_amount, 
                step: 0.01,
                min: 0,
                class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <!-- Paid Amount -->
        <div>
          <label for="reservation_paid_amount" class="block text-sm font-medium text-gray-700 mb-1">
            Paid Amount
          </label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-gray-500">$</span>
            <%= form.number_field :paid_amount, 
                step: 0.01,
                min: 0,
                class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <!-- Payment Status -->
        <div>
          <label for="reservation_payment_status" class="block text-sm font-medium text-gray-700 mb-1">
            Payment Status
          </label>
          <%= form.select :payment_status, 
              options_for_select(Reservation::PAYMENT_STATUSES.map { |s| [s.humanize, s] }, reservation.payment_status),
              {},
              { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <!-- Currency -->
        <div>
          <label for="reservation_currency" class="block text-sm font-medium text-gray-700 mb-1">
            Currency
          </label>
          <%= form.select :currency, 
              options_for_select([['USD - US Dollar', 'USD'], ['EUR - Euro', 'EUR'], ['GBP - British Pound', 'GBP']], reservation.currency || 'USD'),
              {},
              { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
      </div>

      <!-- Pricing Summary (for display) -->
      <% if reservation.room_type %>
        <div class="mt-4 p-4 bg-gray-50 rounded-lg">
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-600">Room Rate:</span>
              <span class="font-medium">$<%= reservation.room_type.base_price %> per night</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Number of Nights:</span>
              <span class="font-medium" id="nights-count"><%= reservation.nights_count rescue 0 %></span>
            </div>
            <div class="pt-2 border-t border-gray-200 flex justify-between">
              <span class="text-gray-900 font-medium">Estimated Total:</span>
              <span class="text-gray-900 font-medium" id="estimated-total">$<%= reservation.room_type.base_price * (reservation.nights_count rescue 1) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Additional Information Section -->
    <div class="border-t border-gray-200 pt-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Additional Information</h3>
      <div class="space-y-4">
        <!-- Special Requests -->
        <div>
          <label for="reservation_special_requests" class="block text-sm font-medium text-gray-700 mb-1">
            Special Requests
          </label>
          <%= form.text_area :special_requests, 
              rows: 3,
              placeholder: "Any special requests from the guest...",
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <!-- Internal Notes -->
        <div>
          <label for="reservation_internal_notes" class="block text-sm font-medium text-gray-700 mb-1">
            Internal Notes <span class="text-gray-500 text-xs">(Staff only)</span>
          </label>
          <%= form.text_area :internal_notes, 
              rows: 3,
              placeholder: "Notes for internal use only...",
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", reservations_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <% if reservation.persisted? && reservation.can_cancel? %>
        <%= link_to "Cancel Reservation", 
            reservation_path(reservation), 
            method: :delete,
            data: { confirm: "Are you sure you want to cancel this reservation?" },
            class: "px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
      <% end %>
      <%= form.submit reservation.persisted? ? "Update Reservation" : "Create Reservation", 
          class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
    </div>
  </div>
<% end %>

<script>
  // Simple JavaScript for form interactions
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle between existing and new guest
    const guestTypeRadios = document.querySelectorAll('input[name="guest_type"]');
    const existingGuestSection = document.getElementById('existing-guest-section');
    const newGuestSection = document.getElementById('new-guest-section');
    
    if (guestTypeRadios.length > 0) {
      guestTypeRadios.forEach(radio => {
        radio.addEventListener('change', function() {
          if (this.value === 'new') {
            existingGuestSection.classList.add('hidden');
            newGuestSection.classList.remove('hidden');
          } else {
            existingGuestSection.classList.remove('hidden');
            newGuestSection.classList.add('hidden');
          }
        });
      });
    }

    // Update pricing calculation
    const checkInField = document.getElementById('reservation_check_in_date');
    const checkOutField = document.getElementById('reservation_check_out_date');
    const nightsDisplay = document.getElementById('nights-count');
    const totalDisplay = document.getElementById('estimated-total');
    
    function updatePricing() {
      if (checkInField && checkOutField && checkInField.value && checkOutField.value) {
        const checkIn = new Date(checkInField.value);
        const checkOut = new Date(checkOutField.value);
        const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
        
        if (nightsDisplay) {
          nightsDisplay.textContent = nights;
        }
        
        // Update total if we have a room rate
        const roomRate = parseFloat(document.querySelector('[data-room-rate]')?.dataset.roomRate || 0);
        if (totalDisplay && roomRate > 0) {
          totalDisplay.textContent = '$' + (roomRate * nights).toFixed(2);
        }
      }
    }
    
    if (checkInField) checkInField.addEventListener('change', updatePricing);
    if (checkOutField) checkOutField.addEventListener('change', updatePricing);
  });
</script>