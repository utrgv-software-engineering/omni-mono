<% content_for :page_title, "Edit Reservation #{@reservation.confirmation_number}" %>

<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Reservations", reservations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to @reservation.confirmation_number, reservation_path(@reservation), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Edit Reservation</h1>
    <p class="mt-1 text-sm text-gray-600">
      Modify reservation details for <%= @reservation.guest&.full_name %>
    </p>
  </div>

  <!-- Status Alert if needed -->
  <% if @reservation.checked_in? %>
    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <p class="text-sm text-blue-700">
            This guest has already checked in. Some fields may not be editable.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Form Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= render 'form', reservation: @reservation %>
  </div>
</div>