<% content_for :page_title, "New Reservation" %>

<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to "Reservations", reservations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New Reservation</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Create New Reservation</h1>
    <p class="mt-1 text-sm text-gray-600">Book a room for a guest or walk-in customer.</p>
  </div>

  <!-- Form Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= render 'form', reservation: @reservation %>
  </div>
</div>