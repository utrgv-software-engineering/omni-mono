<%= form_with model: [hotel, room_type], local: true do |form| %>
  <% if room_type.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(room_type.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% room_type.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, 
                  placeholder: "e.g., Deluxe King Room",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Display name for this room type</p>
            </div>
            <div>
              <%= form.label :code, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :code, 
                  placeholder: "e.g., DLX-K",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Unique code for internal use</p>
            </div>
          </div>
          
          <div>
            <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, 
                rows: 4,
                placeholder: "Describe the room features, amenities, and view...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="mt-1 text-xs text-gray-500">This description will be shown to guests when booking</p>
          </div>
        </div>
      </div>

      <!-- Pricing -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Pricing</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :base_price, "Base Price per Night", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative">
                <span class="absolute left-3 top-2 text-gray-500">$</span>
                <%= form.number_field :base_price, 
                    step: 0.01,
                    min: 0,
                    placeholder: "0.00",
                    class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Standard rate for this room type</p>
            </div>
            <div>
              <%= form.label :extra_person_charge, "Extra Person Charge", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative">
                <span class="absolute left-3 top-2 text-gray-500">$</span>
                <%= form.number_field :extra_person_charge, 
                    step: 0.01,
                    min: 0,
                    placeholder: "0.00",
                    class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Additional charge per person above standard occupancy</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Capacity & Size -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Capacity & Size</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <%= form.label :standard_occupancy, "Standard Occupancy", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :standard_occupancy, 
                  min: 1,
                  placeholder: "2",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Default number of guests</p>
            </div>
            <div>
              <%= form.label :max_occupancy, "Maximum Occupancy", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :max_occupancy, 
                  min: 1,
                  placeholder: "4",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Maximum guests allowed</p>
            </div>
            <div>
              <%= form.label :size_sqm, "Room Size (m²)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :size_sqm, 
                  step: 0.01,
                  min: 0,
                  placeholder: "35",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
              <p class="mt-1 text-xs text-gray-500">Optional room size</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Quick Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Hotel</dt>
              <dd class="text-gray-900 font-medium"><%= hotel.name %></dd>
            </div>
            <% if room_type.persisted? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Total Rooms</dt>
                <dd class="text-gray-900 font-medium"><%= room_type.rooms.count %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Created</dt>
                <dd class="text-gray-900"><%= room_type.created_at.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Last Updated</dt>
                <dd class="text-gray-900"><%= room_type.updated_at.strftime("%b %d, %Y") %></dd>
              </div>
            <% else %>
              <div class="text-gray-500 italic">
                Fill in the form to see pricing calculations
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc pl-5 space-y-1">
                <li>Use clear, descriptive names that guests will understand</li>
                <li>Set standard occupancy to the most common booking size</li>
                <li>Extra person charges apply above standard occupancy</li>
                <li>Room codes should be unique within your hotel</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel_room_types_path(hotel), class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <%= form.submit class: "px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>
<% end %>