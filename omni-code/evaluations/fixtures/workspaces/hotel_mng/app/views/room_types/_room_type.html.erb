<tr>
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm font-medium text-gray-900">
      <%= link_to room_type.name, hotel_room_type_path(hotel, room_type), class: "hover:text-indigo-600" %>
    </div>
    <% if room_type.description.present? %>
      <div class="text-sm text-gray-500 max-w-xs truncate"><%= room_type.description %></div>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
      <%= room_type.code %>
    </span>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm text-gray-900">$<%= number_with_delimiter(room_type.base_price) %></div>
    <div class="text-xs text-gray-500">per night</div>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm text-gray-900">
      <%= room_type.standard_occupancy %> - <%= room_type.max_occupancy %> guests
    </div>
    <div class="text-xs text-gray-500">
      Standard - Max
    </div>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <% if room_type.extra_person_charge > 0 %>
      <div class="text-sm text-gray-900">$<%= number_with_delimiter(room_type.extra_person_charge) %></div>
      <div class="text-xs text-gray-500">per person</div>
    <% else %>
      <span class="text-sm text-gray-500">-</span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="flex items-center">
      <span class="text-sm font-medium text-gray-900"><%= room_type.rooms.count %></span>
      <span class="ml-2 text-xs text-gray-500">rooms</span>
    </div>
    <% if room_type.rooms.any? %>
      <div class="flex gap-1 mt-1">
        <% available_count = room_type.rooms.available.count %>
        <% occupied_count = room_type.rooms.occupied.count %>
        <% cleaning_count = room_type.rooms.cleaning.count %>
        <% maintenance_count = room_type.rooms.maintenance.count %>
        
        <% if available_count > 0 %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800" title="Available">
            <%= available_count %>
          </span>
        <% end %>
        <% if occupied_count > 0 %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800" title="Occupied">
            <%= occupied_count %>
          </span>
        <% end %>
        <% if cleaning_count > 0 %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800" title="Cleaning">
            <%= cleaning_count %>
          </span>
        <% end %>
        <% if maintenance_count > 0 %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 text-orange-800" title="Maintenance">
            <%= maintenance_count %>
          </span>
        <% end %>
      </div>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <% if room_type.size_sqm.present? %>
      <div class="text-sm text-gray-900"><%= room_type.size_sqm %> m²</div>
    <% else %>
      <span class="text-sm text-gray-500">-</span>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
    <div class="flex items-center justify-end space-x-2">
      <%= link_to hotel_room_type_path(hotel, room_type), class: "text-gray-600 hover:text-gray-900" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
      <% end %>
      <% if policy(room_type).edit? %>
        <%= link_to edit_hotel_room_type_path(hotel, room_type), class: "text-indigo-600 hover:text-indigo-900" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>
      <% end %>
      <% if policy(room_type).destroy? && room_type.rooms.empty? %>
        <%= link_to hotel_room_type_path(hotel, room_type), method: :delete,
            data: { confirm: "Are you sure you want to delete this room type?" },
            class: "text-red-600 hover:text-red-900" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>