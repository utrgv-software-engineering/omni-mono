<% content_for :page_title, "Edit #{@room_type.name} - #{@hotel.name}" %>

<div class="max-w-5xl mx-auto">
  <!-- Header with Breadcrumb -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Room Types", hotel_room_types_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to @room_type.name, hotel_room_type_path(@hotel, @room_type), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">Edit Room Type</h1>
    <p class="mt-1 text-sm text-gray-600">Update details for <%= @room_type.name %></p>
  </div>

  <% if @room_type.rooms.any? %>
    <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            This room type has <strong><%= @room_type.rooms.count %> rooms</strong> associated with it. 
            Changes to pricing and capacity will affect all these rooms.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "form", room_type: @room_type, hotel: @hotel %>
</div>