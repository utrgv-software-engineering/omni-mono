<% content_for :page_title, "New Room Type - #{@hotel.name}" %>

<div class="max-w-5xl mx-auto">
  <!-- Header with Breadcrumb -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Room Types", hotel_room_types_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">New</span>
    </nav>
    <h1 class="text-2xl font-bold text-gray-900">New Room Type</h1>
    <p class="mt-1 text-sm text-gray-600">Create a new room category for <%= @hotel.name %></p>
  </div>

  <%= render "form", room_type: @room_type, hotel: @hotel %>
</div>