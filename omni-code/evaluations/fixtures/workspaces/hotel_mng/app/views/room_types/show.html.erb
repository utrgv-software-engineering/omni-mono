<% content_for :page_title, "#{@room_type.name} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <%= link_to "Room Types", hotel_room_types_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900"><%= @room_type.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900"><%= @room_type.name %></h1>
      <div class="mt-1 flex items-center space-x-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
          <%= @room_type.code %>
        </span>
        <span class="text-sm text-gray-600"><%= @room_type.rooms.count %> rooms</span>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@room_type).edit? %>
        <%= link_to edit_hotel_room_type_path(@hotel, @room_type), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if policy(@room_type).destroy? && @room_type.rooms.empty? %>
        <%= link_to hotel_room_type_path(@hotel, @room_type), method: :delete,
            data: { confirm: "Are you sure you want to delete this room type?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Room Type Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room_type.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Code</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room_type.code %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Base Price</dt>
              <dd class="mt-1 text-sm text-gray-900">$<%= number_with_delimiter(@room_type.base_price) %> per night</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Extra Person Charge</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @room_type.extra_person_charge > 0 %>
                  $<%= number_with_delimiter(@room_type.extra_person_charge) %> per person
                <% else %>
                  No additional charge
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Standard Occupancy</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room_type.standard_occupancy %> guests</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Maximum Occupancy</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room_type.max_occupancy %> guests</dd>
            </div>
            <% if @room_type.size_sqm.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Room Size</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @room_type.size_sqm %> m²</dd>
              </div>
            <% end %>
          </dl>
          
          <% if @room_type.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room_type.description %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Rooms List -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Rooms (<%= @room_type.rooms.count %>)</h2>
          <%= link_to new_hotel_room_path(@hotel, room_type_id: @room_type.id), class: "text-sm text-indigo-600 hover:text-indigo-800" do %>
            Add Room
          <% end %>
        </div>
        
        <% if @room_type.rooms.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Room Number
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Floor
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Smoking
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Current Guest
                  </th>
                  <th scope="col" class="relative px-6 py-3">
                    <span class="sr-only">Actions</span>
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @room_type.rooms.includes(:reservations).each do |room| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to room.room_number, hotel_room_path(@hotel, room), class: "hover:text-indigo-600" %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900"><%= room.floor || "-" %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% status_colors = {
                        "available" => "green",
                        "occupied" => "blue",
                        "cleaning" => "yellow",
                        "maintenance" => "orange"
                      } %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= status_colors[room.status] %>-100 text-<%= status_colors[room.status] %>-800">
                        <%= room.status.capitalize %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if room.is_smoking %>
                        <span class="text-sm text-gray-900">Yes</span>
                      <% else %>
                        <span class="text-sm text-gray-500">No</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if room.current_reservation %>
                        <%= link_to room.current_reservation.guest.full_name, 
                            reservation_path(room.current_reservation),
                            class: "text-sm text-indigo-600 hover:text-indigo-800" %>
                      <% else %>
                        <span class="text-sm text-gray-500">-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <%= link_to "View", hotel_room_path(@hotel, room), class: "text-indigo-600 hover:text-indigo-900" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8">
            <p class="text-sm text-gray-500">No rooms have been added to this room type yet.</p>
            <div class="mt-4">
              <%= link_to new_hotel_room_path(@hotel, room_type_id: @room_type.id), class: "inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
                Add First Room
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
      <!-- Amenities -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Amenities</h2>
          <%= link_to "Manage", hotel_room_type_room_type_amenities_path(@hotel, @room_type), class: "text-sm text-indigo-600 hover:text-indigo-800" %>
        </div>
        <div class="px-6 py-4">
          <% room_amenities = @room_type.room_type_amenities.includes(:amenity) %>
          <% if room_amenities.any? %>
            <div class="space-y-2">
              <% room_amenities.limit(5).each do |rta| %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-700"><%= rta.amenity.name %></span>
                  <% if rta.amenity.is_countable? && rta.quantity > 1 %>
                    <span class="text-gray-500">×<%= rta.quantity %></span>
                  <% end %>
                </div>
              <% end %>
              <% if room_amenities.count > 5 %>
                <div class="pt-2 border-t">
                  <%= link_to "View all #{room_amenities.count} amenities →", 
                      hotel_room_type_room_type_amenities_path(@hotel, @room_type),
                      class: "text-sm text-indigo-600 hover:text-indigo-800" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No amenities configured</p>
            <%= link_to "Add amenities", hotel_room_type_room_type_amenities_path(@hotel, @room_type),
                class: "mt-2 inline-block text-sm text-indigo-600 hover:text-indigo-800" %>
          <% end %>
        </div>
      </div>

      <!-- Statistics -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 mt-6">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Statistics</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Total Rooms</dt>
              <dd class="text-sm font-medium text-gray-900"><%= @room_type.rooms.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Available</dt>
              <dd class="text-sm font-medium text-green-600"><%= @room_type.rooms.available.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Occupied</dt>
              <dd class="text-sm font-medium text-blue-600"><%= @room_type.rooms.occupied.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Cleaning</dt>
              <dd class="text-sm font-medium text-yellow-600"><%= @room_type.rooms.cleaning.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Maintenance</dt>
              <dd class="text-sm font-medium text-orange-600"><%= @room_type.rooms.maintenance.count %></dd>
            </div>
          </dl>
          
          <% if @room_type.rooms.any? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <div class="text-sm">
                <div class="flex justify-between mb-1">
                  <span class="text-gray-500">Occupancy Rate</span>
                  <span class="font-medium text-gray-900">
                    <%= ((@room_type.rooms.occupied.count.to_f / @room_type.rooms.count) * 100).round %>%
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= ((@room_type.rooms.occupied.count.to_f / @room_type.rooms.count) * 100).round %>%"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Pricing Calculator -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Pricing Calculator</h2>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nights</label>
              <input type="number" id="calc-nights" value="1" min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Guests</label>
              <input type="number" id="calc-guests" value="<%= @room_type.standard_occupancy %>" min="1" max="<%= @room_type.max_occupancy %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div class="pt-3 border-t border-gray-200">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Base Price</span>
                <span id="calc-base">$<%= number_with_delimiter(@room_type.base_price) %></span>
              </div>
              <div class="flex justify-between text-sm mt-2">
                <span class="text-gray-500">Extra Person Charge</span>
                <span id="calc-extra">$0</span>
              </div>
              <div class="flex justify-between text-base font-medium mt-3 pt-3 border-t border-gray-200">
                <span>Total</span>
                <span id="calc-total">$<%= number_with_delimiter(@room_type.base_price) %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Created</dt>
              <dd class="text-gray-900"><%= @room_type.created_at.strftime("%b %d, %Y") %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Last Updated</dt>
              <dd class="text-gray-900"><%= @room_type.updated_at.strftime("%b %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const nightsInput = document.getElementById('calc-nights');
    const guestsInput = document.getElementById('calc-guests');
    const basePrice = <%= @room_type.base_price %>;
    const standardOccupancy = <%= @room_type.standard_occupancy %>;
    const extraPersonCharge = <%= @room_type.extra_person_charge %>;
    
    function calculatePrice() {
      const nights = parseInt(nightsInput.value) || 1;
      const guests = parseInt(guestsInput.value) || standardOccupancy;
      
      const baseTotal = basePrice * nights;
      const extraGuests = Math.max(0, guests - standardOccupancy);
      const extraTotal = extraPersonCharge * extraGuests * nights;
      const total = baseTotal + extraTotal;
      
      document.getElementById('calc-base').textContent = '$' + baseTotal.toLocaleString();
      document.getElementById('calc-extra').textContent = '$' + extraTotal.toLocaleString();
      document.getElementById('calc-total').textContent = '$' + total.toLocaleString();
    }
    
    nightsInput.addEventListener('input', calculatePrice);
    guestsInput.addEventListener('input', calculatePrice);
  });
</script>