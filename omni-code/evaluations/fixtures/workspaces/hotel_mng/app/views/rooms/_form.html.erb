<%= form_with(model: [hotel, room], local: true) do |form| %>
  <% if room.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(room.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% room.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="room_room_number" class="block text-sm font-medium text-gray-700 mb-1">
                Room Number <span class="text-red-500">*</span>
              </label>
              <%= form.text_field :room_number, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., 101, 201A, Penthouse" %>
              <p class="mt-1 text-xs text-gray-500">Unique identifier for this room</p>
            </div>

            <div>
              <label for="room_floor" class="block text-sm font-medium text-gray-700 mb-1">
                Floor
              </label>
              <%= form.text_field :floor, 
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                  placeholder: "e.g., 1, 2, Ground, Basement" %>
              <p class="mt-1 text-xs text-gray-500">Floor or level location</p>
            </div>
          </div>

          <div>
            <label for="room_room_type_id" class="block text-sm font-medium text-gray-700 mb-1">
              Room Type <span class="text-red-500">*</span>
            </label>
            <%= form.select :room_type_id, 
                options_for_select(hotel.room_types.map { |rt| ["#{rt.name} - $#{rt.base_price}/night (Max: #{rt.max_occupancy} guests)", rt.id] }, room.room_type_id),
                { prompt: "Select a room type..." },
                { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
            <p class="mt-1 text-xs text-gray-500">Category and pricing for this room</p>
          </div>

          <% unless room.new_record? %>
            <div>
              <label for="room_status" class="block text-sm font-medium text-gray-700 mb-1">
                Status
              </label>
              <%= form.select :status, 
                  options_for_select(Room::STATUSES.map { |s| [s.humanize, s] }, room.status),
                  {},
                  { class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
              <p class="mt-1 text-xs text-gray-500">Current room availability status</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Room Features -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Room Features</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div>
            <label class="flex items-center">
              <%= form.check_box :is_smoking, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              <span class="ml-2 text-sm text-gray-700">Smoking room</span>
            </label>
            <p class="mt-1 ml-6 text-xs text-gray-500">Check if smoking is allowed in this room</p>
          </div>
        </div>
      </div>

      <!-- Internal Notes -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Internal Notes</h2>
        </div>
        <div class="px-6 py-4">
          <label for="room_notes" class="block text-sm font-medium text-gray-700 mb-1">
            Notes <span class="text-xs text-gray-500">(Staff only)</span>
          </label>
          <%= form.text_area :notes, 
              rows: 4,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
              placeholder: "Any special notes about this room (e.g., connecting room, accessible features, maintenance history)..." %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Room Type Preview -->
      <% if room.room_type %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900">Room Type Details</h3>
          </div>
          <div class="px-6 py-4">
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-gray-500">Type</dt>
                <dd class="mt-1 font-medium text-gray-900"><%= room.room_type.name %></dd>
              </div>
              <div>
                <dt class="text-gray-500">Base Price</dt>
                <dd class="mt-1 font-medium text-gray-900">$<%= number_with_delimiter(room.room_type.base_price) %> per night</dd>
              </div>
              <div>
                <dt class="text-gray-500">Occupancy</dt>
                <dd class="mt-1 font-medium text-gray-900">
                  Standard: <%= room.room_type.standard_occupancy %> | Max: <%= room.room_type.max_occupancy %>
                </dd>
              </div>
              <% if room.room_type.extra_person_charge > 0 %>
                <div>
                  <dt class="text-gray-500">Extra Person</dt>
                  <dd class="mt-1 font-medium text-gray-900">$<%= room.room_type.extra_person_charge %></dd>
                </div>
              <% end %>
              <% if room.room_type.size_sqm %>
                <div>
                  <dt class="text-gray-500">Size</dt>
                  <dd class="mt-1 font-medium text-gray-900"><%= room.room_type.size_sqm %> m²</dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>

      <!-- Help Text -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Quick Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc space-y-1 pl-5">
                <li>Room numbers must be unique within the hotel</li>
                <li>Floor information helps with housekeeping organization</li>
                <li>Room type determines pricing and occupancy limits</li>
                <li>Use notes for any special room characteristics</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel_rooms_path(hotel), class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <%= form.submit room.persisted? ? "Update Room" : "Create Room", 
          class: "px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
    </div>
  </div>
<% end %>