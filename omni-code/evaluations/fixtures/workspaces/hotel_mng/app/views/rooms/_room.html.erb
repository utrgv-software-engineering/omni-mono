<tr class="hover:bg-gray-50 transition-colors">
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="flex items-center">
      <div class="flex-shrink-0 h-10 w-10">
        <div class="h-10 w-10 rounded-lg bg-indigo-100 flex items-center justify-center">
          <span class="text-sm font-medium text-indigo-600">
            <%= room.room_number %>
          </span>
        </div>
      </div>
      <div class="ml-4">
        <div class="text-sm font-medium text-gray-900">
          Room <%= room.room_number %>
        </div>
      </div>
    </div>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm text-gray-900"><%= room.room_type.name %></div>
    <div class="text-xs text-gray-500">$<%= room.room_type.base_price %>/night</div>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="text-sm text-gray-900"><%= room.floor || "—" %></div>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <%= render partial: "shared/status_badge", locals: { status: room.status, type: "room" } %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <% if room.current_reservation %>
      <div class="flex items-center">
        <div class="flex-shrink-0 h-8 w-8">
          <div class="h-8 w-8 rounded-full bg-gray-300 flex items-center justify-center">
            <span class="text-xs font-medium text-gray-600">
              <%= room.current_guest&.display_initials %>
            </span>
          </div>
        </div>
        <div class="ml-3">
          <div class="text-sm font-medium text-gray-900">
            <%= link_to room.current_guest&.full_name, guest_path(room.current_guest), class: "hover:text-indigo-600" if room.current_guest %>
          </div>
          <div class="text-xs text-gray-500">
            Until <%= room.current_reservation.check_out_date.strftime("%b %d") %>
          </div>
        </div>
      </div>
    <% else %>
      <span class="text-sm text-gray-500">—</span>
    <% end %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <% if room.last_cleaned_at %>
      <div class="text-sm text-gray-900"><%= time_ago_in_words(room.last_cleaned_at) %> ago</div>
      <div class="text-xs text-gray-500"><%= room.last_cleaned_at.strftime("%b %d, %I:%M %p") %></div>
    <% else %>
      <span class="text-sm text-gray-500">—</span>
    <% end %>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap">
    <div class="flex space-x-2">
      <% if room.is_smoking %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
          Smoking
        </span>
      <% end %>
      <% if room.room_type.max_occupancy > 2 %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
          <%= room.room_type.max_occupancy %> guests
        </span>
      <% end %>
    </div>
  </td>
  
  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
    <div class="flex items-center justify-end space-x-2">
      <% if room.status == 'cleaning' && policy(room).update? %>
        <%= form_with model: room, url: hotel_room_path(hotel, room), method: :patch, local: false, class: "inline" do |f| %>
          <%= f.hidden_field :status, value: 'available' %>
          <%= f.hidden_field :last_cleaned_at, value: Time.current %>
          <%= f.submit "✓", class: "px-2 py-1 text-xs font-medium text-green-700 bg-green-100 rounded hover:bg-green-200 cursor-pointer", title: "Mark as Clean" %>
        <% end %>
      <% end %>
      
      <%= link_to "View", hotel_room_path(hotel, room), class: "text-indigo-600 hover:text-indigo-900" %>
      
      <% if policy(room).edit? %>
        <%= link_to "Edit", edit_hotel_room_path(hotel, room), class: "text-gray-600 hover:text-gray-900" %>
      <% end %>
    </div>
  </td>
</tr>