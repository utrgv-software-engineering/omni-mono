<% content_for :page_title, "Edit Room #{@room.room_number} - #{@hotel.name}" %>

<div class="max-w-5xl mx-auto">
  <!-- Header -->
  <div class="mb-6">
    <nav class="flex mb-2" aria-label="Breadcrumb">
      <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Rooms", hotel_rooms_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Room #{@room.room_number}", hotel_room_path(@hotel, @room), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-sm text-gray-900">Edit</span>
    </nav>
    <div class="flex items-center space-x-3">
      <h1 class="text-2xl font-bold text-gray-900">Edit Room <%= @room.room_number %></h1>
      <%= render partial: "shared/status_badge", locals: { status: @room.status, type: "room" } %>
    </div>
    <p class="mt-1 text-sm text-gray-600">Update room details and settings</p>
  </div>

  <% if @room.current_reservation %>
    <div class="rounded-md bg-yellow-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">
            Room Currently Occupied
          </h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p>This room is currently occupied by <%= @room.current_guest.full_name %>.</p>
            <p class="mt-1">Check-out scheduled for <%= @room.current_reservation.check_out_date.strftime("%B %d, %Y") %>.</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= render partial: "form", locals: { room: @room, hotel: @hotel } %>
</div>