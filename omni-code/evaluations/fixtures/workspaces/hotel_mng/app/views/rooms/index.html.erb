<% content_for :page_title, "Room Inventory - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Room Inventory</span>
      </nav>
      <h1 class="text-2xl font-bold text-gray-900">Room Inventory</h1>
      <p class="mt-1 text-sm text-gray-600">Manage individual rooms and their status</p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if params[:filter] == 'housekeeping' %>
        <%= link_to "View All Rooms", hotel_rooms_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% else %>
        <%= link_to "Housekeeping View", hotel_rooms_path(@hotel, filter: 'housekeeping'), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% end %>
      <% if policy(Room).new? %>
        <%= link_to new_hotel_room_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Room
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Status Summary Cards -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-5 mb-6">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Available</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @rooms.where(status: 'available').count %></dd>
          </div>
        </div>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-blue-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Occupied</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @rooms.where(status: 'occupied').count %></dd>
          </div>
        </div>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-yellow-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Cleaning</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @rooms.where(status: 'cleaning').count %></dd>
          </div>
        </div>
      </div>
    </div>
    
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-orange-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Maintenance</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @rooms.where(status: 'maintenance').count %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-12 w-12 rounded-lg bg-gray-100 flex items-center justify-center">
              <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <dt class="text-sm font-medium text-gray-500">Total Rooms</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @rooms.count %></dd>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if params[:filter] == 'housekeeping' %>
    <!-- Housekeeping View -->
    <div class="bg-white shadow-sm rounded-lg border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Housekeeping Status</h2>
        <p class="mt-1 text-sm text-gray-500">Quick view of rooms requiring attention</p>
      </div>
      
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @rooms.where(status: ['cleaning', 'maintenance']).each do |room| %>
            <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-semibold text-gray-900">Room <%= room.room_number %></h3>
                <%= render partial: "shared/status_badge", locals: { status: room.status, type: "room" } %>
              </div>
              
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-500">Type:</span>
                  <span class="text-gray-900"><%= room.room_type.name %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Floor:</span>
                  <span class="text-gray-900"><%= room.floor || "—" %></span>
                </div>
                <% if room.last_cleaned_at %>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Last Cleaned:</span>
                    <span class="text-gray-900"><%= time_ago_in_words(room.last_cleaned_at) %> ago</span>
                  </div>
                <% end %>
                <% if room.current_guest %>
                  <div class="pt-2 border-t border-gray-100">
                    <span class="text-gray-500">Guest:</span>
                    <span class="text-gray-900 block"><%= room.current_guest.full_name %></span>
                  </div>
                <% end %>
              </div>
              
              <div class="mt-4 flex space-x-2">
                <% if policy(room).update? %>
                  <%= form_with model: room, url: hotel_room_path(@hotel, room), method: :patch, local: false, class: "flex-1" do |f| %>
                    <%= f.hidden_field :status, value: 'available' %>
                    <%= f.submit "Mark Clean", class: "w-full px-3 py-2 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
                  <% end %>
                <% end %>
                <%= link_to "View", hotel_room_path(@hotel, room), class: "flex-1 px-3 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 text-center" %>
              </div>
            </div>
          <% end %>
          
          <% if @rooms.where(status: ['cleaning', 'maintenance']).none? %>
            <div class="col-span-full text-center py-8">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">All rooms are clean</h3>
              <p class="mt-1 text-sm text-gray-500">No rooms currently require housekeeping attention.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Regular Table View -->
    <div class="bg-white shadow-sm rounded-lg border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">All Rooms</h2>
          <div class="flex space-x-2">
            <% ['all', 'available', 'occupied', 'cleaning', 'maintenance'].each do |status_filter| %>
              <% 
                count = status_filter == 'all' ? @rooms.count : @rooms.where(status: status_filter).count
                is_active = params[:status] == status_filter || (params[:status].blank? && status_filter == 'all')
              %>
              <%= link_to hotel_rooms_path(@hotel, status: status_filter == 'all' ? nil : status_filter), 
                  class: "px-3 py-1 text-xs font-medium rounded-full transition-colors #{is_active ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
                <%= status_filter.capitalize %> (<%= count %>)
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      
      <% if @rooms.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Room
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Type
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Floor
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Status
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Current Guest
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Last Cleaned
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Features
                </th>
                <th scope="col" class="relative px-6 py-3">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @rooms.each do |room| %>
                <%= render partial: "room", locals: { room: room, hotel: @hotel } %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No rooms found</h3>
          <p class="mt-1 text-sm text-gray-500">
            <% if params[:status].present? %>
              No rooms with status "<%= params[:status].humanize %>".
            <% else %>
              Get started by adding rooms to your inventory.
            <% end %>
          </p>
          <div class="mt-6">
            <% if policy(Room).new? %>
              <%= link_to new_hotel_room_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Add Room
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>