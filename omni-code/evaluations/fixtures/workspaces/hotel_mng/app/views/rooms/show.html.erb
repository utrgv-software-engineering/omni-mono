<% content_for :page_title, "Room #{@room.room_number} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <%= link_to "Rooms", hotel_rooms_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-sm text-gray-900">Room <%= @room.room_number %></span>
      </nav>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-900">Room <%= @room.room_number %></h1>
        <%= render partial: "shared/status_badge", locals: { status: @room.status, type: "room" } %>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if @room.status == 'cleaning' && policy(@room).update? %>
        <%= form_with model: @room, url: hotel_room_path(@hotel, @room), method: :patch, local: false do |f| %>
          <%= f.hidden_field :status, value: 'available' %>
          <%= f.hidden_field :last_cleaned_at, value: Time.current %>
          <%= f.submit "Mark as Clean", class: "inline-flex items-center px-4 py-2 border border-green-300 text-sm font-medium rounded-lg text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer" %>
        <% end %>
      <% elsif @room.status == 'available' && policy(@room).update? %>
        <%= form_with model: @room, url: hotel_room_path(@hotel, @room), method: :patch, local: false do |f| %>
          <%= f.hidden_field :status, value: 'maintenance' %>
          <%= f.submit "Set Maintenance", class: "inline-flex items-center px-4 py-2 border border-orange-300 text-sm font-medium rounded-lg text-orange-700 bg-white hover:bg-orange-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 cursor-pointer" %>
        <% end %>
      <% end %>
      <% if policy(@room).edit? %>
        <%= link_to edit_hotel_room_path(@hotel, @room), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Room
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Room Details Card -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Room Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Room Type</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to @room.room_type.name, hotel_room_type_path(@hotel, @room.room_type), class: "text-indigo-600 hover:text-indigo-900" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Floor</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room.floor || "Not specified" %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Base Price</dt>
              <dd class="mt-1 text-sm text-gray-900">$<%= number_with_delimiter(@room.room_type.base_price) %> per night</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Max Occupancy</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room.room_type.max_occupancy %> guests</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Smoking</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @room.is_smoking %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                    Smoking Allowed
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                    Non-Smoking
                  </span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Room Size</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @room.room_type.size_sqm %>
                  <%= @room.room_type.size_sqm %> m²
                <% else %>
                  Not specified
                <% end %>
              </dd>
            </div>
          </dl>
          
          <% if @room.notes.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500">Internal Notes</dt>
              <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= @room.notes %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Housekeeping Status -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Housekeeping Status</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Current Status</dt>
              <dd class="mt-1">
                <%= render partial: "shared/status_badge", locals: { status: @room.status, type: "room" } %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Last Cleaned</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @room.last_cleaned_at %>
                  <%= @room.last_cleaned_at.strftime("%B %d, %Y at %I:%M %p") %>
                  <span class="text-gray-500">(<%= time_ago_in_words(@room.last_cleaned_at) %> ago)</span>
                <% else %>
                  <span class="text-gray-500">No cleaning record</span>
                <% end %>
              </dd>
            </div>
          </dl>
          
          <% if policy(@room).update? %>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <h3 class="text-sm font-medium text-gray-900 mb-3">Quick Status Update</h3>
              <div class="grid grid-cols-2 gap-2">
                <% Room::STATUSES.each do |status| %>
                  <% unless status == @room.status %>
                    <%= form_with model: @room, url: hotel_room_path(@hotel, @room), method: :patch, local: false do |f| %>
                      <%= f.hidden_field :status, value: status %>
                      <% if status == 'available' %>
                        <%= f.hidden_field :last_cleaned_at, value: Time.current %>
                      <% end %>
                      <% 
                        button_class = case status
                        when 'available' then 'border-green-300 text-green-700 hover:bg-green-50 focus:ring-green-500'
                        when 'occupied' then 'border-blue-300 text-blue-700 hover:bg-blue-50 focus:ring-blue-500'
                        when 'cleaning' then 'border-yellow-300 text-yellow-700 hover:bg-yellow-50 focus:ring-yellow-500'
                        when 'maintenance' then 'border-orange-300 text-orange-700 hover:bg-orange-50 focus:ring-orange-500'
                        else 'border-gray-300 text-gray-700 hover:bg-gray-50 focus:ring-gray-500'
                        end
                      %>
                      <%= f.submit "Set #{status.humanize}", class: "w-full px-3 py-2 border #{button_class} text-sm font-medium rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-offset-2 cursor-pointer" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recent Reservations -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Recent Reservations</h2>
        </div>
        <div class="divide-y divide-gray-200">
          <% recent_reservations = @room.reservations.includes(:guest).order(check_in_date: :desc).limit(5) %>
          <% if recent_reservations.any? %>
            <% recent_reservations.each do |reservation| %>
              <div class="px-6 py-4 hover:bg-gray-50">
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <div class="flex items-center space-x-3">
                      <div class="flex-shrink-0">
                        <div class="h-8 w-8 rounded-full bg-gray-300 flex items-center justify-center">
                          <span class="text-xs font-medium text-gray-600">
                            <%= reservation.guest.display_initials %>
                          </span>
                        </div>
                      </div>
                      <div>
                        <p class="text-sm font-medium text-gray-900">
                          <%= link_to reservation.guest.full_name, guest_path(reservation.guest), class: "hover:text-indigo-600" %>
                        </p>
                        <p class="text-xs text-gray-500">
                          <%= reservation.check_in_date.strftime("%b %d") %> - <%= reservation.check_out_date.strftime("%b %d, %Y") %>
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center space-x-3">
                    <%= render partial: "shared/status_badge", locals: { status: reservation.status, type: "reservation" } %>
                    <%= link_to "View", reservation_path(reservation), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="px-6 py-8 text-center">
              <p class="text-sm text-gray-500">No reservation history for this room</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Current Occupancy -->
      <% if @room.current_reservation %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Current Occupancy</h2>
          </div>
          <div class="px-6 py-4">
            <div class="flex items-center space-x-3 mb-4">
              <div class="flex-shrink-0">
                <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center">
                  <span class="text-sm font-medium text-gray-600">
                    <%= @room.current_guest.display_initials %>
                  </span>
                </div>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900">
                  <%= link_to @room.current_guest.full_name, guest_path(@room.current_guest), class: "hover:text-indigo-600" %>
                </p>
                <p class="text-xs text-gray-500"><%= @room.current_guest.email %></p>
              </div>
            </div>
            
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-gray-500">Confirmation:</dt>
                <dd class="text-gray-900 font-medium"><%= @room.current_reservation.confirmation_number %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Check-in:</dt>
                <dd class="text-gray-900"><%= @room.current_reservation.check_in_date.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Check-out:</dt>
                <dd class="text-gray-900"><%= @room.current_reservation.check_out_date.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Nights:</dt>
                <dd class="text-gray-900"><%= @room.current_reservation.nights_count %></dd>
              </div>
            </dl>
            
            <div class="mt-4 pt-4 border-t border-gray-200">
              <%= link_to "View Reservation", reservation_path(@room.current_reservation), class: "block w-full text-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              <% if @room.current_reservation.can_check_out? %>
                <%= link_to "Process Check-out", new_reservation_check_out_path(@room.current_reservation), class: "block w-full text-center mt-2 px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500" %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-white shadow-sm rounded-lg border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Availability</h2>
          </div>
          <div class="px-6 py-4">
            <div class="text-center py-4">
              <svg class="mx-auto h-12 w-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="mt-2 text-sm font-medium text-gray-900">Room Available</p>
              <p class="mt-1 text-xs text-gray-500">Ready for new reservations</p>
            </div>
            <div class="mt-4">
              <%= link_to "Create Reservation", new_reservation_path(room_id: @room.id), class: "block w-full text-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Quick Actions -->
      <div class="bg-white shadow-sm rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-2">
          <%= link_to hotel_rooms_path(@hotel), class: "flex items-center justify-between px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg" do %>
            <span>View All Rooms</span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          <% end %>
          
          <%= link_to hotel_room_type_path(@hotel, @room.room_type), class: "flex items-center justify-between px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg" do %>
            <span>View Room Type</span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          <% end %>
          
          <% if policy(@room).edit? %>
            <%= link_to edit_hotel_room_path(@hotel, @room), class: "flex items-center justify-between px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg" do %>
              <span>Edit Room Details</span>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>