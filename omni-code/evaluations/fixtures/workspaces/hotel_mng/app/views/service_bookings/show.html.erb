<% content_for :page_title, "Service Booking - #{@service_booking.service.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Breadcrumb Navigation -->
  <nav class="flex mb-4" aria-label="Breadcrumb">
    <% if @reservation %>
      <%= link_to "Reservations", reservations_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to @reservation.confirmation_number, reservation_path(@reservation), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <span class="mx-2 text-gray-400">/</span>
      <%= link_to "Service Bookings", reservation_service_bookings_path(@reservation), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <% else %>
      <%= link_to "Service Bookings", service_bookings_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <% end %>
    <span class="mx-2 text-gray-400">/</span>
    <span class="text-sm text-gray-900">Booking Details</span>
  </nav>

  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Service Booking Details</h1>
      <p class="text-sm text-gray-600 mt-1">
        <%= @service_booking.service.name %> for <%= @service_booking.guest.full_name %>
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if @service_booking.pending? && policy(@service_booking).update? %>
        <%= button_to "Confirm Booking", 
            @reservation ? reservation_service_booking_path(@reservation, @service_booking) : service_booking_path(@service_booking),
            method: :patch,
            params: { service_booking: { status: 'confirmed' } },
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
      <% elsif @service_booking.confirmed? && @service_booking.booking_date <= Date.current && policy(@service_booking).update? %>
        <%= button_to "Mark Complete", 
            @reservation ? reservation_service_booking_path(@reservation, @service_booking) : service_booking_path(@service_booking),
            method: :patch,
            params: { service_booking: { status: 'completed' } },
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% end %>
      
      <% if policy(@service_booking).edit? && !@service_booking.completed? && !@service_booking.cancelled? %>
        <%= link_to @reservation ? edit_reservation_service_booking_path(@reservation, @service_booking) : edit_service_booking_path(@service_booking),
            class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if @service_booking.can_cancel? && policy(@service_booking).destroy? %>
        <%= link_to @reservation ? reservation_service_booking_path(@reservation, @service_booking) : service_booking_path(@service_booking),
            method: :delete,
            data: { confirm: "Are you sure you want to cancel this booking?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          Cancel
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Status Alert -->
  <% if @service_booking.pending? %>
    <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            This booking is pending confirmation. Please confirm to secure the service.
          </p>
        </div>
      </div>
    </div>
  <% elsif @service_booking.cancelled? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <p class="text-sm text-red-700">
            This booking has been cancelled and is no longer valid.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Service Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Service Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Service Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @service_booking.service.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Category</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @service_booking.service.category.humanize %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Booking Date</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_booking.booking_date.strftime("%B %d, %Y") %>
                <span class="text-gray-500">(<%= @service_booking.booking_date.strftime("%A") %>)</span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Time</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @service_booking.booking_time %>
                  <%= @service_booking.formatted_booking_time %>
                  <% if @service_booking.duration_minutes %>
                    - <%= @service_booking.end_time %>
                    <span class="text-gray-500">(<%= @service_booking.duration_minutes %> min)</span>
                  <% end %>
                <% else %>
                  <span class="text-gray-500">No specific time set</span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Quantity</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_booking.quantity %>
                <span class="text-gray-500">
                  <%= @service_booking.service.pricing_unit == 'per_person' ? 'guests' : @service_booking.service.pricing_unit.split('_').last %>
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1">
                <%= render partial: "shared/status_badge", locals: { status: @service_booking.status, type: "service_booking" } %>
              </dd>
            </div>
          </dl>
          
          <% if @service_booking.notes.present? %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <dt class="text-sm font-medium text-gray-500 mb-2">Special Requests / Notes</dt>
              <dd class="text-sm text-gray-900 bg-gray-50 p-3 rounded-lg">
                <%= @service_booking.notes %>
              </dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Guest Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Guest Information</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Guest Name</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to @service_booking.guest.full_name, guest_path(@service_booking.guest), 
                    class: "text-blue-600 hover:text-blue-800" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Email</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @service_booking.guest.email %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Phone</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_booking.guest.phone || "Not provided" %>
              </dd>
            </div>
            <% if @service_booking.reservation %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Associated Reservation</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= link_to @service_booking.reservation.confirmation_number, 
                      reservation_path(@service_booking.reservation),
                      class: "text-blue-600 hover:text-blue-800" %>
                </dd>
              </div>
            <% else %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Booking Type</dt>
                <dd class="mt-1 text-sm text-gray-900">Walk-in Service</dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Pricing Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Pricing Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Unit Price</dt>
              <dd class="text-sm text-gray-900">
                $<%= number_with_delimiter(@service_booking.unit_price) %>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-gray-500">Quantity</dt>
              <dd class="text-sm text-gray-900">
                × <%= @service_booking.quantity %>
              </dd>
            </div>
            <% if @service_booking.service.pricing_unit == 'per_hour' && @service_booking.duration_minutes %>
              <div class="flex justify-between">
                <dt class="text-sm text-gray-500">Duration</dt>
                <dd class="text-sm text-gray-900">
                  <%= number_with_precision(@service_booking.duration_minutes / 60.0, precision: 1) %> hours
                </dd>
              </div>
            <% end %>
            <div class="pt-3 border-t border-gray-200 flex justify-between">
              <dt class="text-base font-medium text-gray-900">Total Amount</dt>
              <dd class="text-base font-medium text-gray-900">
                $<%= number_with_delimiter(@service_booking.total_price) %>
              </dd>
            </div>
          </dl>
          
          <div class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-gray-900">Payment Status</span>
              <% if @service_booking.completed? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Paid
                </span>
              <% elsif @service_booking.cancelled? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  N/A
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  Pending
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Booking Information</h2>
        </div>
        <div class="px-6 py-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Booking ID</span>
            <span class="font-mono text-gray-900">#<%= @service_booking.id %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Created</span>
            <span class="text-gray-900">
              <%= @service_booking.created_at.strftime("%b %d, %Y at %I:%M %p") %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Last Updated</span>
            <span class="text-gray-900">
              <%= @service_booking.updated_at.strftime("%b %d, %Y at %I:%M %p") %>
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <% if !@service_booking.cancelled? && !@service_booking.completed? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
          </div>
          <div class="px-6 py-4 space-y-2">
            <% if @service_booking.pending? %>
              <%= button_to "Confirm Booking", 
                  @reservation ? reservation_service_booking_path(@reservation, @service_booking) : service_booking_path(@service_booking),
                  method: :patch,
                  params: { service_booking: { status: 'confirmed' } },
                  class: "w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-green-600 hover:bg-green-700" %>
            <% end %>
            
            <button type="button" class="w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Send Confirmation
            </button>
            
            <button type="button" class="w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
              </svg>
              Print Voucher
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>