<%= form_with model: [hotel, service, service_schedule], local: true do |form| %>
  <% if service_schedule.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(service_schedule.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% service_schedule.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Day Selection -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Day of Week</h2>
        </div>
        <div class="px-6 py-4">
          <div>
            <%= form.label :day_of_week, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <% ServiceSchedule::DAYS_OF_WEEK.each do |day_num, day_name| %>
                <% # Check if this day already has a schedule (unless editing that specific day)
                   has_schedule = service.service_schedules.where(day_of_week: day_num).where.not(id: service_schedule.id).exists?
                %>
                <label class="<%= has_schedule ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer' %> relative flex items-center justify-center px-4 py-3 border rounded-lg hover:bg-gray-50 transition-colors">
                  <%= form.radio_button :day_of_week, day_num, 
                      disabled: has_schedule,
                      checked: (service_schedule.day_of_week == day_num || params[:day_of_week].to_i == day_num),
                      class: "sr-only peer" %>
                  <span class="text-sm font-medium <%= has_schedule ? 'text-gray-400' : 'text-gray-700 peer-checked:text-blue-600' %>">
                    <%= day_name %>
                  </span>
                  <% if has_schedule %>
                    <span class="absolute top-1 right-1">
                      <svg class="h-3 w-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                  <% end %>
                  <div class="absolute inset-0 border-2 border-transparent peer-checked:border-blue-500 rounded-lg pointer-events-none"></div>
                </label>
              <% end %>
            </div>
            <p class="mt-2 text-xs text-gray-500">Select the day of the week for this schedule</p>
          </div>
        </div>
      </div>

      <!-- Time Configuration -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Operating Hours</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :start_time, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.time_field :start_time,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Service start time</p>
            </div>
            
            <div>
              <%= form.label :end_time, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.time_field :end_time,
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Service end time</p>
            </div>
          </div>
          
          <!-- Duration Display -->
          <div id="duration-display" class="hidden">
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700">Total Duration</span>
                <span id="calculated-duration" class="text-sm font-medium text-gray-900">-</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Configuration -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Booking Configuration</h2>
        </div>
        <div class="px-6 py-4">
          <div>
            <%= form.label :max_bookings_per_slot, "Maximum Bookings per Slot", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :max_bookings_per_slot,
                min: 1,
                placeholder: "Leave blank for unlimited",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            <p class="mt-1 text-xs text-gray-500">Maximum number of bookings allowed per time slot (optional)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Service Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Service Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Service</dt>
              <dd class="text-gray-900 font-medium"><%= service.name %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Category</dt>
              <dd class="text-gray-900"><%= service.category.humanize %></dd>
            </div>
            <% if service.duration_minutes %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Service Duration</dt>
                <dd class="text-gray-900"><%= service.duration_minutes %> min</dd>
              </div>
            <% end %>
            <% if service.capacity %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Capacity</dt>
                <dd class="text-gray-900"><%= service.capacity %> guests</dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Existing Schedule -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Current Schedule</h2>
        </div>
        <div class="px-6 py-4">
          <% existing_schedules = service.service_schedules.where.not(id: service_schedule.id).ordered %>
          <% if existing_schedules.any? %>
            <div class="space-y-2">
              <% existing_schedules.each do |schedule| %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600"><%= schedule.day_name[0..2] %></span>
                  <span class="text-gray-900 font-medium"><%= schedule.formatted_hours %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No schedules configured yet</p>
          <% end %>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Schedule Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc pl-5 space-y-1">
                <li>Each day can only have one schedule</li>
                <li>Set max bookings to limit concurrent reservations</li>
                <li>Leave max bookings empty for unlimited capacity</li>
                <li>Schedules apply every week on the selected day</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel_service_service_schedules_path(hotel, service), class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <% if service_schedule.persisted? %>
        <%= link_to "View Schedule", hotel_service_service_schedule_path(hotel, service, service_schedule), 
            class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" %>
      <% end %>
      <%= form.submit service_schedule.persisted? ? "Update Schedule" : "Create Schedule", 
          class: "px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
<% end %>

<script>
// Simple duration calculator
document.addEventListener('DOMContentLoaded', function() {
  const startTimeField = document.getElementById('service_schedule_start_time');
  const endTimeField = document.getElementById('service_schedule_end_time');
  const durationDisplay = document.getElementById('duration-display');
  const calculatedDuration = document.getElementById('calculated-duration');
  
  function calculateDuration() {
    if (!startTimeField || !endTimeField) return;
    
    const startTime = startTimeField.value;
    const endTime = endTimeField.value;
    
    if (startTime && endTime) {
      const start = new Date(`2000-01-01T${startTime}`);
      const end = new Date(`2000-01-01T${endTime}`);
      
      let diff = end - start;
      if (diff < 0) {
        // Handle overnight schedules
        diff += 24 * 60 * 60 * 1000;
      }
      
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      
      if (calculatedDuration) {
        calculatedDuration.textContent = hours > 0 
          ? `${hours} hour${hours !== 1 ? 's' : ''} ${minutes > 0 ? minutes + ' minutes' : ''}`
          : `${minutes} minutes`;
      }
      
      if (durationDisplay) {
        durationDisplay.classList.remove('hidden');
      }
    } else {
      if (durationDisplay) {
        durationDisplay.classList.add('hidden');
      }
    }
  }
  
  if (startTimeField && endTimeField) {
    startTimeField.addEventListener('change', calculateDuration);
    endTimeField.addEventListener('change', calculateDuration);
    calculateDuration(); // Initial calculation
  }
});
</script>