<% content_for :page_title, "#{@service_schedule.day_name} Schedule - #{@service.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Breadcrumb Navigation -->
  <nav class="flex mb-4" aria-label="Breadcrumb">
    <%= link_to "Hotels", hotels_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to "Services", hotel_services_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to @service.name, hotel_service_path(@hotel, @service), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to "Schedule", hotel_service_service_schedules_path(@hotel, @service), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <span class="text-sm text-gray-900"><%= @service_schedule.day_name %></span>
  </nav>

  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @service_schedule.day_name %> Schedule</h1>
      <p class="text-sm text-gray-600 mt-1"><%= @service.name %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@service_schedule).edit? %>
        <%= link_to edit_hotel_service_service_schedule_path(@hotel, @service, @service_schedule), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Schedule
        <% end %>
      <% end %>
      
      <% if policy(@service_schedule).destroy? %>
        <%= link_to hotel_service_service_schedule_path(@hotel, @service, @service_schedule), 
            method: :delete,
            data: { confirm: "Are you sure you want to delete this schedule?" },
            class: "inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Schedule Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Schedule Details</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Day of Week</dt>
              <dd class="mt-1 text-sm text-gray-900 font-medium">
                <%= @service_schedule.day_name %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Operating Hours</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_schedule.formatted_hours %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Start Time</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_schedule.formatted_start_time %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">End Time</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_schedule.formatted_end_time %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Duration</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_schedule.duration_in_minutes %> minutes
                <span class="text-gray-500">(<%= number_with_precision(@service_schedule.duration_in_hours, precision: 1) %> hours)</span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Max Bookings per Slot</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @service_schedule.max_bookings_per_slot || "Unlimited" %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Available Time Slots -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Available Time Slots</h2>
          <p class="text-sm text-gray-500 mt-1">30-minute slots for next occurrence</p>
        </div>
        <div class="px-6 py-4">
          <% # Find next occurrence of this day
             days_ahead = (@service_schedule.day_of_week - Date.current.wday) % 7
             days_ahead = 7 if days_ahead == 0  # If it's today, show next week
             next_date = Date.current + days_ahead.days
             slots = @service_schedule.available_slots(next_date, 30)
          %>
          
          <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg p-3">
            <p class="text-sm text-blue-700">
              Next <%= @service_schedule.day_name %>: <%= next_date.strftime("%B %d, %Y") %>
            </p>
          </div>
          
          <% if slots.any? %>
            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-2">
              <% slots.each do |slot| %>
                <div class="text-center p-2 bg-gray-50 rounded border border-gray-200 hover:bg-blue-50 hover:border-blue-300 transition-colors cursor-pointer">
                  <p class="text-xs font-medium text-gray-900">
                    <%= slot[:start_time].strftime("%l:%M %p").strip %>
                  </p>
                  <% if @service_schedule.max_bookings_per_slot %>
                    <p class="text-xs text-gray-500">
                      <%= @service_schedule.max_bookings_per_slot %> slots
                    </p>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No time slots available</p>
          <% end %>
        </div>
      </div>

      <!-- Upcoming Bookings for this Day -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Upcoming <%= @service_schedule.day_name %> Bookings</h2>
        </div>
        <div class="px-6 py-4">
          <% # Get bookings for the next few occurrences of this day
             upcoming_bookings = []
             (0..3).each do |week_offset|
               date = next_date + (week_offset * 7).days
               upcoming_bookings += @service.bookings_on_date(date).includes(:guest)
             end
          %>
          
          <% if upcoming_bookings.any? %>
            <div class="space-y-3">
              <% upcoming_bookings.first(5).each do |booking| %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div>
                    <p class="text-sm font-medium text-gray-900">
                      <%= booking.guest.full_name %>
                    </p>
                    <p class="text-xs text-gray-500">
                      <%= booking.booking_date.strftime("%b %d, %Y") %>
                      <% if booking.booking_time %>
                        at <%= booking.formatted_booking_time %>
                      <% end %>
                    </p>
                  </div>
                  <div class="text-right">
                    <%= render partial: "shared/status_badge", locals: { status: booking.status, type: "service_booking" } %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 text-center py-4">
              No upcoming bookings for <%= @service_schedule.day_name %>s
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Service Info -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Service Information</h2>
        </div>
        <div class="px-6 py-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Service</span>
            <span class="text-gray-900 font-medium">
              <%= link_to @service.name, hotel_service_path(@hotel, @service), class: "text-blue-600 hover:text-blue-800" %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Category</span>
            <span class="text-gray-900"><%= @service.category.humanize %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Price</span>
            <span class="text-gray-900">
              $<%= number_with_delimiter(@service.price) %>
              <span class="text-xs text-gray-500">/ <%= @service.pricing_unit.humanize.downcase %></span>
            </span>
          </div>
          <% if @service.duration_minutes %>
            <div class="flex justify-between">
              <span class="text-gray-500">Service Duration</span>
              <span class="text-gray-900"><%= @service.duration_minutes %> min</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Schedule Metadata -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Schedule Information</h2>
        </div>
        <div class="px-6 py-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Created</span>
            <span class="text-gray-900">
              <%= @service_schedule.created_at.strftime("%b %d, %Y") %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Last Updated</span>
            <span class="text-gray-900">
              <%= @service_schedule.updated_at.strftime("%b %d, %Y") %>
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-2">
          <%= link_to hotel_service_service_schedules_path(@hotel, @service), class: "w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            View All Schedules
          <% end %>
          
          <%= link_to new_service_booking_path(service_id: @service.id, booking_date: next_date), class: "w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Book for <%= @service_schedule.day_name %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>