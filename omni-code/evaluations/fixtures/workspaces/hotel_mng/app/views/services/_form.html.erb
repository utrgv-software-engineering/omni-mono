<%= form_with model: [hotel, service], local: true do |form| %>
  <% if service.errors.any? %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            There were <%= pluralize(service.errors.count, "error") %> with your submission
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% service.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Form Fields -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Basic Information -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, 
                  placeholder: "e.g., Full Body Massage",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Service name visible to guests</p>
            </div>
            
            <div>
              <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :category, 
                  options_for_select(Service::CATEGORIES.map { |c| [c.humanize, c] }, service.category),
                  { prompt: "Select category" },
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Service category for organization</p>
            </div>
          </div>
          
          <div>
            <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, 
                rows: 4,
                placeholder: "Describe the service, what's included, and any special features...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            <p class="mt-1 text-xs text-gray-500">Detailed description for guests</p>
          </div>
        </div>
      </div>

      <!-- Pricing Configuration -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Pricing Configuration</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :price, "Base Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative">
                <span class="absolute left-3 top-2 text-gray-500">$</span>
                <%= form.number_field :price, 
                    step: 0.01,
                    min: 0,
                    placeholder: "0.00",
                    class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Base price for the service</p>
            </div>
            
            <div>
              <%= form.label :pricing_unit, "Pricing Unit", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :pricing_unit, 
                  options_for_select(Service::PRICING_UNITS.map { |u| [u.humanize, u] }, service.pricing_unit),
                  {},
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">How the service is priced</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Service Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Service Details</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :duration_minutes, "Duration (Minutes)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :duration_minutes, 
                  min: 0,
                  placeholder: "60",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Service duration in minutes</p>
            </div>
            
            <div>
              <%= form.label :capacity, "Maximum Capacity", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :capacity, 
                  min: 1,
                  placeholder: "1",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Maximum guests per booking</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :location, 
                  placeholder: "e.g., Spa Level 2, Poolside",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Where the service is provided</p>
            </div>
            
            <div>
              <%= form.label :provider_info, "Provider Information", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :provider_info, 
                  placeholder: "e.g., External vendor name",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="mt-1 text-xs text-gray-500">Optional provider details</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Settings -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Booking Settings</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="flex items-start">
            <%= form.check_box :advance_booking_required, class: "mt-1" %>
            <div class="ml-3">
              <%= form.label :advance_booking_required, class: "text-sm font-medium text-gray-700" %>
              <p class="text-xs text-gray-500">Require guests to book in advance (no walk-ins)</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <%= form.check_box :is_active, class: "mt-1" %>
            <div class="ml-3">
              <%= form.label :is_active, "Active", class: "text-sm font-medium text-gray-700" %>
              <p class="text-xs text-gray-500">Service is available for booking</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Summary -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Summary</h2>
        </div>
        <div class="px-6 py-4">
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Hotel</dt>
              <dd class="text-gray-900 font-medium"><%= hotel.name %></dd>
            </div>
            <% if service.persisted? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Total Bookings</dt>
                <dd class="text-gray-900 font-medium"><%= service.service_bookings.count %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Upcoming</dt>
                <dd class="text-gray-900 font-medium"><%= service.service_bookings.upcoming.count %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Created</dt>
                <dd class="text-gray-900"><%= service.created_at.strftime("%b %d, %Y") %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-gray-500">Last Updated</dt>
                <dd class="text-gray-900"><%= service.updated_at.strftime("%b %d, %Y") %></dd>
              </div>
            <% else %>
              <div class="text-gray-500 italic">
                Fill in the form to create your service
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Service Tips</h3>
            <div class="mt-2 text-sm text-blue-700">
              <ul class="list-disc pl-5 space-y-1">
                <li>Use clear service names that guests will understand</li>
                <li>Set appropriate pricing based on your pricing unit</li>
                <li>Include duration for time-based services</li>
                <li>Set capacity limits to manage availability</li>
                <li>Configure schedules after creating the service</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="mt-6 flex items-center justify-between">
    <div>
      <%= link_to "Cancel", hotel_services_path(hotel), class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
    <div class="flex space-x-3">
      <% if service.persisted? %>
        <%= link_to "View Service", hotel_service_path(hotel, service), 
            class: "px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" %>
      <% end %>
      <%= form.submit service.persisted? ? "Update Service" : "Create Service", 
          class: "px-6 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
<% end %>