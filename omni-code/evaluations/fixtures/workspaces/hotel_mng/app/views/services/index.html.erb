<% content_for :page_title, "Services - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Breadcrumb Navigation -->
  <nav class="flex mb-4" aria-label="Breadcrumb">
    <%= link_to "Hotels", hotels_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <span class="text-sm text-gray-900">Services</span>
  </nav>

  <!-- Page Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Hotel Services</h1>
      <p class="text-sm text-gray-600 mt-1">Manage spa, dining, transport and other hotel services</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <% if policy(Service).new? %>
        <%= link_to new_hotel_service_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Service
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Category Tabs -->
  <div class="mb-6 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8" aria-label="Categories">
      <% categories = [['all', 'All Services']] + Service::CATEGORIES.map { |c| [c, c.humanize] } %>
      <% categories.each do |category, label| %>
        <% is_active = (params[:category] || 'all') == category %>
        <%= link_to hotel_services_path(@hotel, category: category == 'all' ? nil : category),
            class: "py-2 px-1 border-b-2 font-medium text-sm #{is_active ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} transition-colors" do %>
          <%= label %>
          <% count = category == 'all' ? @services.count : @services.by_category(category).count %>
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= is_active ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-900' %>">
            <%= count %>
          </span>
        <% end %>
      <% end %>
    </nav>
  </div>

  <% if @services.any? %>
    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @services.each do |service| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <!-- Service Header -->
          <div class="p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center">
                  <% icon_map = {
                    'spa' => 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
                    'dining' => 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
                    'transport' => 'M8 7v8a4 4 0 008 0V7M8 7V3m8 4V3m-9 8h10',
                    'laundry' => 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12',
                    'other' => 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
                  } %>
                  <div class="flex-shrink-0 h-10 w-10 rounded-lg bg-blue-100 flex items-center justify-center">
                    <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_map[service.category] || icon_map['other'] %>"></path>
                    </svg>
                  </div>
                  <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">
                      <%= link_to service.name, hotel_service_path(@hotel, service), class: "hover:text-blue-600" %>
                    </h3>
                    <p class="text-sm text-gray-500"><%= service.category.humanize %></p>
                  </div>
                </div>
              </div>
              <% if service.is_active %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                  Active
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                  Inactive
                </span>
              <% end %>
            </div>

            <% if service.description.present? %>
              <p class="mt-3 text-sm text-gray-600 line-clamp-2">
                <%= service.description %>
              </p>
            <% end %>

            <!-- Service Details -->
            <div class="mt-4 space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500">Price:</span>
                <span class="font-medium text-gray-900">
                  $<%= number_with_delimiter(service.price) %>
                  <span class="text-xs text-gray-500">/ <%= service.pricing_unit.humanize.downcase %></span>
                </span>
              </div>
              
              <% if service.duration_minutes.present? %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500">Duration:</span>
                  <span class="text-gray-900"><%= service.duration_minutes %> minutes</span>
                </div>
              <% end %>
              
              <% if service.capacity.present? %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500">Capacity:</span>
                  <span class="text-gray-900"><%= service.capacity %> guests</span>
                </div>
              <% end %>
              
              <% if service.advance_booking_required %>
                <div class="flex items-center text-sm text-amber-600">
                  <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                  </svg>
                  Advance booking required
                </div>
              <% end %>
            </div>
          </div>

          <!-- Service Actions -->
          <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <div class="flex items-center space-x-2 text-sm text-gray-600">
              <% bookings_count = service.service_bookings.upcoming.count %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <%= bookings_count %> upcoming bookings
            </div>
            
            <div class="flex items-center space-x-2">
              <% if policy(service).edit? %>
                <%= link_to edit_hotel_service_path(@hotel, service), 
                    class: "text-gray-400 hover:text-gray-600 transition-colors",
                    title: "Edit" do %>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                <% end %>
              <% end %>
              
              <%= link_to hotel_service_path(@hotel, service), 
                  class: "text-gray-400 hover:text-gray-600 transition-colors",
                  title: "View Details" do %>
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No services found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if params[:category].present? %>
            No <%= params[:category].humanize.downcase %> services available for this hotel.
          <% else %>
            Get started by adding your first service offering.
          <% end %>
        </p>
        <div class="mt-6">
          <% if policy(Service).new? %>
            <%= link_to new_hotel_service_path(@hotel), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Service
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>