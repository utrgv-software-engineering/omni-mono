<% content_for :page_title, "#{@service.name} - #{@hotel.name}" %>

<div class="max-w-7xl mx-auto">
  <!-- Breadcrumb Navigation -->
  <nav class="flex mb-4" aria-label="Breadcrumb">
    <%= link_to "Hotels", hotels_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to @hotel.name, hotel_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <%= link_to "Services", hotel_services_path(@hotel), class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="mx-2 text-gray-400">/</span>
    <span class="text-sm text-gray-900"><%= @service.name %></span>
  </nav>

  <!-- Header with Actions -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @service.name %></h1>
      <p class="text-sm text-gray-600 mt-1">
        <%= @service.category.humanize %> Service
        <% if @service.is_active %>
          <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Active</span>
        <% else %>
          <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
        <% end %>
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <% if policy(@service).edit? %>
        <%= link_to edit_hotel_service_path(@hotel, @service), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit Service
        <% end %>
      <% end %>
      
      <% if @service.has_schedule? %>
        <%= link_to hotel_service_service_schedules_path(@hotel, @service), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Manage Schedule
        <% end %>
      <% else %>
        <%= link_to new_hotel_service_service_schedule_path(@hotel, @service), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Set Schedule
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Service Details -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Service Details</h2>
        </div>
        <div class="px-6 py-4">
          <% if @service.description.present? %>
            <div class="mb-4">
              <h3 class="text-sm font-medium text-gray-500 mb-2">Description</h3>
              <p class="text-sm text-gray-900"><%= @service.description %></p>
            </div>
          <% end %>
          
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Category</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @service.category.humanize %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @service.is_active %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Active</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                <% end %>
              </dd>
            </div>
            
            <% if @service.duration_minutes.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Duration</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @service.duration_minutes %> minutes
                  <span class="text-gray-500">(<%= number_with_precision(@service.duration_minutes / 60.0, precision: 1) %> hours)</span>
                </dd>
              </div>
            <% end %>
            
            <% if @service.capacity.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Maximum Capacity</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @service.capacity %> guests</dd>
              </div>
            <% end %>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Advance Booking</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @service.advance_booking_required %>
                  <span class="inline-flex items-center text-amber-600">
                    <svg class="h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                    </svg>
                    Required
                  </span>
                <% else %>
                  Walk-in available
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Pricing Structure -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Pricing Structure</h2>
        </div>
        <div class="px-6 py-4">
          <div class="bg-gray-50 rounded-lg p-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm text-gray-500">Base Price</p>
                <p class="text-2xl font-bold text-gray-900">$<%= number_with_delimiter(@service.price) %></p>
                <p class="text-sm text-gray-600 mt-1">per <%= @service.pricing_unit.humanize.downcase %></p>
              </div>
              
              <div class="text-right">
                <% case @service.pricing_unit %>
                <% when 'per_hour' %>
                  <p class="text-sm text-gray-500">Example (2 hours):</p>
                  <p class="text-lg font-medium text-gray-900">$<%= number_with_delimiter(@service.calculate_price(1, 2)) %></p>
                <% when 'per_person' %>
                  <p class="text-sm text-gray-500">Example (4 people):</p>
                  <p class="text-lg font-medium text-gray-900">$<%= number_with_delimiter(@service.calculate_price(4)) %></p>
                <% when 'per_item' %>
                  <p class="text-sm text-gray-500">Example (3 items):</p>
                  <p class="text-lg font-medium text-gray-900">$<%= number_with_delimiter(@service.calculate_price(3)) %></p>
                <% else %>
                  <p class="text-sm text-gray-500">Fixed price</p>
                  <p class="text-lg font-medium text-gray-900">$<%= number_with_delimiter(@service.price) %></p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Schedule Overview -->
      <% if @service.has_schedule? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">Schedule Overview</h2>
            <%= link_to "Manage", hotel_service_service_schedules_path(@hotel, @service), class: "text-sm text-blue-600 hover:text-blue-800" %>
          </div>
          <div class="px-6 py-4">
            <div class="grid grid-cols-7 gap-2 text-center">
              <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].each_with_index do |day, index| %>
                <% schedule = @service.schedule_for_day(index) %>
                <div class="<%= schedule ? 'bg-blue-50 border-blue-200' : 'bg-gray-50 border-gray-200' %> border rounded-lg p-2">
                  <p class="text-xs font-medium <%= schedule ? 'text-blue-700' : 'text-gray-500' %>"><%= day %></p>
                  <% if schedule %>
                    <p class="text-xs text-gray-600 mt-1">
                      <%= schedule.formatted_start_time %><br>
                      <%= schedule.formatted_end_time %>
                    </p>
                    <% if schedule.max_bookings_per_slot %>
                      <p class="text-xs text-gray-500 mt-1">Max: <%= schedule.max_bookings_per_slot %></p>
                    <% end %>
                  <% else %>
                    <p class="text-xs text-gray-400 mt-1">Closed</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <div class="flex">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <div class="ml-3">
              <p class="text-sm text-yellow-700">
                No schedule configured. <%= link_to "Set up a schedule", new_hotel_service_service_schedule_path(@hotel, @service), class: "font-medium underline" %> to manage availability.
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Recent Bookings -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Recent Bookings</h2>
          <%= link_to "View All", service_bookings_path(service_id: @service.id), class: "text-sm text-blue-600 hover:text-blue-800" %>
        </div>
        <div class="px-6 py-4">
          <% recent_bookings = @service.service_bookings.includes(:guest).order(booking_date: :desc).limit(5) %>
          <% if recent_bookings.any? %>
            <div class="space-y-3">
              <% recent_bookings.each do |booking| %>
                <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">
                      <%= booking.guest.full_name %>
                    </p>
                    <p class="text-xs text-gray-500">
                      <%= booking.booking_date.strftime("%b %d, %Y") %>
                      <% if booking.booking_time %>
                        at <%= booking.formatted_booking_time %>
                      <% end %>
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-gray-900">$<%= number_with_delimiter(booking.total_price) %></p>
                    <%= render partial: "shared/status_badge", locals: { status: booking.status, type: "service_booking" } %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 text-center py-4">No bookings yet</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Statistics -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Statistics</h2>
        </div>
        <div class="px-6 py-4 space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Total Bookings</span>
            <span class="text-sm font-medium text-gray-900"><%= @service.service_bookings.count %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">Upcoming</span>
            <span class="text-sm font-medium text-gray-900"><%= @service.service_bookings.upcoming.count %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm text-gray-500">This Month</span>
            <span class="text-sm font-medium text-gray-900">
              <%= @service.service_bookings.where(booking_date: Date.current.beginning_of_month..Date.current.end_of_month).count %>
            </span>
          </div>
          <div class="pt-3 border-t border-gray-200">
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500">Total Revenue</span>
              <span class="text-sm font-medium text-green-600">
                $<%= number_with_delimiter(@service.service_bookings.sum(:total_price)) %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-2">
          <%= link_to new_service_booking_path(service_id: @service.id), class: "w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Book Service
          <% end %>
          
          <% if @service.has_schedule? %>
            <%= link_to hotel_service_service_schedules_path(@hotel, @service), class: "w-full inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              View Schedule
            <% end %>
          <% end %>
          
          <% if policy(@service).destroy? %>
            <%= link_to hotel_service_path(@hotel, @service), method: :delete,
                data: { confirm: "Are you sure you want to delete this service?" },
                class: "w-full inline-flex items-center px-4 py-2 border border-red-300 text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Delete Service
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Service Info -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Information</h2>
        </div>
        <div class="px-6 py-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Created</span>
            <span class="text-gray-900"><%= @service.created_at.strftime("%b %d, %Y") %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Last Updated</span>
            <span class="text-gray-900"><%= @service.updated_at.strftime("%b %d, %Y") %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>