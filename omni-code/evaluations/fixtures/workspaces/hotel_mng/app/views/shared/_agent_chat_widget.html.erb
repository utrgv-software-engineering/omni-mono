<%
  # Required parameters - fail early if not provided
  deployment_type = local_assigns.fetch(:deployment_type) # Required: 'platform' or 'hotel'
  deployment_key = local_assigns.fetch(:deployment_key)   # Required: e.g., 'data_analytics', 'web_chat'
  
  # Optional parameters with no defaults
  subtitle = local_assigns[:subtitle]
  welcome_message = local_assigns[:welcome_message]
  
  # Determine if this is a platform or hotel deployment
  is_platform = deployment_type == 'platform'
  
  # For platform deployments, check if enabled
  # For hotel deployments, check if hotel exists and has it enabled
  show_widget = if is_platform
    AiDeployments.platform_enabled?(deployment_key)
  else
    @hotel && AiDeployments.hotel_enabled?(@hotel, deployment_key)
  end
  
  # Get deployment configuration for display
  deployment_config = if is_platform
    AiDeployments.get_platform(deployment_key)
  else
    AiDeployments.get_hotel(deployment_key)
  end
%>

<% if show_widget && deployment_config %>
<div data-controller="agent-chat" 
     data-agent-chat-hotel-id-value="<%= @hotel&.id unless is_platform %>"
     data-agent-chat-referrer-value="<%= request.fullpath %>"
     data-agent-chat-deployment-type-value="<%= deployment_type %>"
     data-agent-chat-deployment-key-value="<%= deployment_key %>"
     class="fixed bottom-0 right-0 z-50">
  <!-- Chat Bubble -->
  <div data-agent-chat-target="bubble" 
       data-action="click->agent-chat#toggle"
       class="fixed bottom-6 right-6 w-14 h-14 bg-blue-600 hover:bg-blue-700 rounded-full cursor-pointer flex items-center justify-center shadow-lg transition-colors">
    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
  </div>

  <!-- Chat Window -->
  <div data-agent-chat-target="window" 
       class="hidden fixed bottom-6 right-6 w-96 h-[600px] bg-white rounded-lg shadow-2xl flex-col">
    
    <!-- Header -->
    <div class="bg-blue-600 text-white p-4 rounded-t-lg flex justify-between items-center">
      <div>
        <h3 class="font-semibold text-lg"><%= deployment_config[:name] %></h3>
        <% if subtitle.present? %>
          <p class="text-sm text-blue-100"><%= subtitle %></p>
        <% end %>
      </div>
      <button data-action="click->agent-chat#close" 
              class="text-white hover:text-blue-200 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div data-agent-chat-target="messages" 
         class="flex-1 overflow-y-auto p-4 space-y-2">
      <!-- Welcome Message (only show if provided) -->
      <% if welcome_message.present? %>
        <div class="mb-3">
          <div class="inline-block px-4 py-2 rounded-lg max-w-xs lg:max-w-md bg-gray-100 text-gray-800">
            <%= welcome_message %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Typing Indicator -->
    <div data-agent-chat-target="typingIndicator" 
         class="hidden px-4 py-2 text-sm text-gray-500 italic">
      <span class="inline-flex items-center">
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Typing...
      </span>
    </div>

    <!-- Input Container -->
    <div class="border-t p-4">
      <form data-action="submit->agent-chat#sendMessage" class="flex space-x-2">
        <input data-agent-chat-target="input"
               data-action="keypress->agent-chat#sendMessage keyup->agent-chat#handleInputKeyup"
               type="text" 
               placeholder="Type your message..." 
               class="flex-1 px-4 py-2 border border-gray-300 rounded-full focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
               autocomplete="off">
        <button type="submit" 
                class="px-6 py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
          Send
        </button>
      </form>
      <p class="text-xs text-gray-500 mt-2 text-center">
        Powered by AI Assistant
      </p>
    </div>
  </div>
</div>
<% end %>