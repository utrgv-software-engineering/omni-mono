<nav class="bg-white shadow-lg sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      <!-- Hotel Brand/Logo -->
      <div class="flex items-center">
        <%= link_to public_hotel_path, class: "flex items-center space-x-3" do %>
          <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-900"><%= @hotel&.name || "Hotel" %></h1>
            <% if @hotel&.star_rating.present? %>
              <div class="flex">
                <% @hotel.star_rating.to_i.times do %>
                  <svg class="w-3 h-3 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Main Navigation -->
      <div class="hidden md:flex items-center space-x-6">
        <%= link_to "Hotel Info", public_hotel_path, 
            class: "text-gray-700 hover:text-blue-600 font-medium transition-colors duration-200" %>
        
        <%= link_to "Rooms & Rates", public_rooms_path, 
            class: "text-gray-700 hover:text-blue-600 font-medium transition-colors duration-200" %>
        
        <%= link_to "Check Availability", public_availability_index_path, 
            class: "text-gray-700 hover:text-blue-600 font-medium transition-colors duration-200" %>
        
        <%= link_to "My Reservation", public_reservation_lookup_path, 
            class: "text-gray-700 hover:text-blue-600 font-medium transition-colors duration-200" %>
      </div>

      <!-- Right Side Actions -->
      <div class="flex items-center space-x-4">
        <!-- Contact Info -->
        <div class="hidden lg:flex items-center space-x-4 text-sm">
          <a href="tel:<%= @hotel&.phone %>" class="flex items-center text-gray-600 hover:text-blue-600">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <%= @hotel&.phone %>
          </a>
        </div>

        <!-- Book Now Button -->
        <%= link_to "Book Now", 
            public_availability_index_path,
            class: "bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold py-2 px-6 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-200 shadow-md hover:shadow-lg" %>

        <!-- Mobile Menu Button -->
        <button class="md:hidden mobile-menu-button">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="md:hidden hidden mobile-menu">
      <div class="py-3 space-y-1">
        <%= link_to "Hotel Info", public_hotel_path, 
            class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 font-medium" %>
        <%= link_to "Rooms & Rates", public_rooms_path, 
            class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 font-medium" %>
        <%= link_to "Check Availability", public_availability_index_path, 
            class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 font-medium" %>
        <%= link_to "My Reservation", public_reservation_lookup_path, 
            class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 font-medium" %>
        
        <hr class="border-gray-200">
        
        <div class="px-4 py-2">
          <a href="tel:<%= @hotel&.phone %>" class="flex items-center text-gray-600">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call <%= @hotel&.phone %>
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>