<!-- Sidebar Navigation -->
<aside id="sidebar" class="flex flex-col gap-y-5 overflow-y-auto border-r border-gray-200 bg-white px-4 transition-all duration-300 ease-in-out lg:translate-x-0 -translate-x-full fixed inset-y-0 left-0 z-40 w-64 flex-shrink-0" data-sidebar>
  <!-- Brand Header -->
  <div class="relative flex h-16 shrink-0 items-center">
    <%= link_to authenticated_root_path, class: "flex items-center gap-x-3" do %>
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-600">
        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-gray-900">Hotel Manager</span>
        <% if current_tenant %>
          <span class="text-xs text-gray-500"><%= current_tenant.name %></span>
        <% end %>
      </div>
    <% end %>
    <button onclick="toggleSidebar()" class="absolute right-0 lg:hidden rounded-lg p-1.5 text-gray-400 hover:bg-gray-50 hover:text-gray-600">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Hotel Context Selector -->
  <% if current_tenant && current_tenant.hotels.any? %>
    <div class="-mx-2">
      <label class="block px-2 text-xs/6 font-semibold text-gray-400 mb-2">Active Hotel</label>
      <%= form_with url: set_current_hotel_path, method: :post, local: false, class: "px-2" do |f| %>
        <%= f.select :hotel_id, 
            options_for_select(current_tenant.hotels.map { |h| [h.name, h.id] }, current_hotel&.id),
            {},
            { onchange: "this.form.requestSubmit()",
              class: "w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6 appearance-none bg-white" } %>
      <% end %>
      
      <!-- View Public Site Link -->
      <% if current_hotel %>
        <% 
          # Determine the public URL based on environment
          public_url = if Rails.env.development? || request.host == 'localhost' || request.host == '0.0.0.0'
            # Use path-based routing for development
            "/hotels/#{current_hotel.subdomain}"
          else
            # Use subdomain for production
            "#{request.protocol}#{current_hotel.subdomain}.#{request.domain}#{request.port == 80 || request.port == 443 ? '' : ":#{request.port}"}/public/hotel"
          end
        %>
        <%= link_to public_url, 
            target: "_blank",
            class: "flex items-center gap-x-2 mt-3 mx-2 px-3 py-2 text-sm font-medium text-gray-700 bg-gray-50 rounded-md hover:bg-gray-100 transition-colors" do %>
          <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          <span>View Public Site</span>
          <svg class="h-3 w-3 ml-auto text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
          </svg>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <!-- Navigation -->
  <nav class="relative flex flex-1 flex-col overflow-y-auto">
    <ul role="list" class="flex flex-1 flex-col gap-y-7 pb-4">
      <li>
        <ul role="list" class="-mx-2 space-y-1">
          <!-- Dashboard -->
          <%= link_to authenticated_root_path, 
              class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold #{current_page?(authenticated_root_path) ? 'bg-gray-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50 hover:text-indigo-600'}" do %>
            <svg class="size-6 shrink-0 <%= current_page?(authenticated_root_path) ? 'text-indigo-600' : 'text-gray-400 group-hover:text-indigo-600' %>" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            Dashboard
            <% if @todays_arrivals_count.to_i > 0 %>
              <span class="ml-auto w-9 min-w-max whitespace-nowrap rounded-full bg-white px-2.5 py-0.5 text-center text-xs/5 font-medium text-gray-600 ring-1 ring-inset ring-gray-200"><%= @todays_arrivals_count %></span>
            <% end %>
          <% end %>

          <!-- Reservations Section -->
          <li data-controller="sidebar-section" data-sidebar-section-collapsed-value="true">
            <button type="button" data-action="click->sidebar-section#toggle"
                    class="flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
              <svg class="size-6 shrink-0 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
              Reservations
              <svg data-sidebar-section-target="chevron" class="ml-auto size-5 shrink-0 text-gray-400 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <ul data-sidebar-section-target="content" class="mt-1 px-2 hidden">
              <%= link_to reservations_path, 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{current_page?(reservations_path) && !params[:filter] ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                All Reservations
              <% end %>
              <%= link_to reservations_path(filter: 'arrivals'), 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{params[:filter] == 'arrivals' ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                <div class="flex items-center justify-between">
                  <span>Today's Arrivals</span>
                  <% if @todays_arrivals_count.to_i > 0 %>
                    <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20"><%= @todays_arrivals_count %></span>
                  <% end %>
                </div>
              <% end %>
              <%= link_to reservations_path(filter: 'departures'), 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{params[:filter] == 'departures' ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                <div class="flex items-center justify-between">
                  <span>Today's Departures</span>
                  <% if @todays_departures_count.to_i > 0 %>
                    <span class="rounded-full bg-orange-50 px-2 py-0.5 text-xs font-medium text-orange-700 ring-1 ring-inset ring-orange-600/20"><%= @todays_departures_count %></span>
                  <% end %>
                </div>
              <% end %>
              <%= link_to new_reservation_path, 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{current_page?(new_reservation_path) ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                <div class="flex items-center">
                  <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                  </svg>
                  <span>New Reservation</span>
                </div>
              <% end %>
            </ul>
          </li>

          <!-- Rooms Section -->
          <li data-controller="sidebar-section" data-sidebar-section-collapsed-value="true">
            <button type="button" data-action="click->sidebar-section#toggle"
                    class="flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
              <svg class="size-6 shrink-0 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
              </svg>
              Room Management
              <svg data-sidebar-section-target="chevron" class="ml-auto size-5 shrink-0 text-gray-400 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <ul data-sidebar-section-target="content" class="mt-1 px-2 hidden">
              <% if current_hotel %>
                <%= link_to hotel_rooms_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 text-gray-700 hover:bg-gray-50" do %>
                  <div class="flex items-center justify-between">
                    <span>Room Inventory</span>
                    <div class="flex gap-x-1">
                      <% if @available_rooms_count.to_i > 0 %>
                        <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20" title="Available"><%= @available_rooms_count %></span>
                      <% end %>
                      <% if @occupied_rooms_count.to_i > 0 %>
                        <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20" title="Occupied"><%= @occupied_rooms_count %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= link_to hotel_room_types_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 text-gray-700 hover:bg-gray-50" do %>
                  Room Types
                <% end %>
                <%= link_to hotel_rooms_path(current_hotel, filter: 'housekeeping'), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 text-gray-700 hover:bg-gray-50" do %>
                  <div class="flex items-center justify-between">
                    <span>Housekeeping View</span>
                    <% if @rooms_need_cleaning.to_i > 0 %>
                      <span class="rounded-full bg-yellow-50 px-2 py-0.5 text-xs font-medium text-yellow-700 ring-1 ring-inset ring-yellow-600/20"><%= @rooms_need_cleaning %></span>
                    <% end %>
                  </div>
                <% end %>
                <%= link_to hotel_housekeeping_tasks_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 text-gray-700 hover:bg-gray-50" do %>
                  Housekeeping Tasks
                <% end %>
                <%= link_to hotel_maintenance_requests_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 text-gray-700 hover:bg-gray-50" do %>
                  Maintenance Requests
                <% end %>
              <% else %>
                <span class="block rounded-md py-2 pl-9 pr-2 text-sm/6 italic text-gray-500">No hotel selected</span>
              <% end %>
            </ul>
          </li>

          <!-- Services Section -->
          <li data-controller="sidebar-section" data-sidebar-section-collapsed-value="true">
            <button type="button" data-action="click->sidebar-section#toggle"
                    class="flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
              <svg class="size-6 shrink-0 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
              </svg>
              Services & Bookings
              <svg data-sidebar-section-target="chevron" class="ml-auto size-5 shrink-0 text-gray-400 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <ul data-sidebar-section-target="content" class="mt-1 px-2 hidden">
              <% if current_hotel %>
                <%= link_to hotel_services_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{controller_name == 'services' ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                  Hotel Services
                <% end %>
                <%= link_to service_bookings_path, 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{controller_name == 'service_bookings' && !@reservation ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                  All Bookings
                <% end %>
                <%= link_to new_service_booking_path, 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{current_page?(new_service_booking_path) ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                  <div class="flex items-center">
                    <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Book Service</span>
                  </div>
                <% end %>
              <% else %>
                <span class="block rounded-md py-2 pl-9 pr-2 text-sm/6 italic text-gray-500">No hotel selected</span>
              <% end %>
            </ul>
          </li>

          <!-- Guests -->
          <%= link_to guests_path, 
              class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold #{current_page?(guests_path) ? 'bg-gray-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50 hover:text-indigo-600'}" do %>
            <svg class="size-6 shrink-0 <%= current_page?(guests_path) ? 'text-indigo-600' : 'text-gray-400 group-hover:text-indigo-600' %>" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
            Guests
          <% end %>

          <!-- Amenities Section -->
          <li data-controller="sidebar-section" data-sidebar-section-collapsed-value="true">
            <button type="button" data-action="click->sidebar-section#toggle"
                    class="flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
              <svg class="size-6 shrink-0 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
              </svg>
              Amenities
              <svg data-sidebar-section-target="chevron" class="ml-auto size-5 shrink-0 text-gray-400 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <ul data-sidebar-section-target="content" class="mt-1 px-2 hidden">
              <%= link_to amenities_path, 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{current_page?(amenities_path) ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                All Amenities
              <% end %>
              <% if current_hotel %>
                <%= link_to hotel_hotel_amenities_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{controller_name == 'hotel_amenities' ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                  Hotel Amenities
                <% end %>
              <% else %>
                <span class="block rounded-md py-2 pl-9 pr-2 text-sm/6 italic text-gray-500">No hotel selected</span>
              <% end %>
            </ul>
          </li>

          <!-- Policies Section -->
          <li data-controller="sidebar-section" data-sidebar-section-collapsed-value="true">
            <button type="button" data-action="click->sidebar-section#toggle"
                    class="flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
              <svg class="size-6 shrink-0 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Policies
              <svg data-sidebar-section-target="chevron" class="ml-auto size-5 shrink-0 text-gray-400 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <ul data-sidebar-section-target="content" class="mt-1 px-2 hidden">
              <% if current_hotel %>
                <%= link_to hotel_hotel_policies_path(current_hotel), 
                    class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{controller_name == 'hotel_policies' ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                  Hotel Policies
                <% end %>
              <% else %>
                <span class="block rounded-md py-2 pl-9 pr-2 text-sm/6 italic text-gray-500">No hotel selected</span>
              <% end %>
              <%= link_to cancellation_policies_path, 
                  class: "block rounded-md py-2 pl-9 pr-2 text-sm/6 #{current_page?(cancellation_policies_path) ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50'}" do %>
                Cancellation Policies
              <% end %>
            </ul>
          </li>

          <!-- Reports & Analytics -->
          <%= link_to reports_path, 
              data: { turbo: false },
              class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold #{current_page?(reports_path) ? 'bg-gray-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50 hover:text-indigo-600'}" do %>
            <svg class="size-6 shrink-0 <%= current_page?(reports_path) ? 'text-indigo-600' : 'text-gray-400 group-hover:text-indigo-600' %>" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
            Reports & Analytics
          <% end %>
        </ul>
      </li>

      <!-- Settings Section (Admin Only) -->
      <% if current_account_user && (current_account_user.owner? || current_account_user.admin? || current_account_user.hotel_manager?) %>
        <li>
          <div class="text-xs/6 font-semibold text-gray-400">Settings</div>
          <ul role="list" class="-mx-2 mt-2 space-y-1">
            <%= link_to hotels_path, 
                class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold #{current_page?(hotels_path) ? 'bg-gray-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50 hover:text-indigo-600'}" do %>
              <span class="flex size-6 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white text-[0.625rem] font-medium text-gray-400 group-hover:border-indigo-600 group-hover:text-indigo-600">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </span>
              <span class="truncate">All Hotels</span>
            <% end %>
            <% if current_hotel %>
              <%= link_to edit_hotel_path(current_hotel), 
                  class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold #{current_page?(edit_hotel_path(current_hotel)) ? 'bg-gray-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50 hover:text-indigo-600'}" do %>
                <span class="flex size-6 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white text-[0.625rem] font-medium text-gray-400 group-hover:border-indigo-600 group-hover:text-indigo-600">
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </span>
                <span class="truncate">Hotel Settings</span>
              <% end %>
            <% end %>
            <%= link_to account_users_path, 
                class: "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600" do %>
              <span class="flex size-6 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white text-[0.625rem] font-medium text-gray-400 group-hover:border-indigo-600 group-hover:text-indigo-600">T</span>
              <span class="truncate">Team Members</span>
            <% end %>
          </ul>
        </li>
      <% end %>

    </ul>
  </nav>

  <!-- User Profile Section (Sticky Bottom) -->
  <div class="border-t border-gray-200 -mx-4 px-4 py-3 mt-auto">
    <% if current_user %>
      <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button data-action="click->dropdown#toggle" 
                class="flex w-full items-center gap-x-4 py-2 text-sm/6 font-semibold text-gray-900 hover:bg-gray-50 rounded-lg -mx-2 px-2">
              <div class="size-8 rounded-full bg-gray-300 flex items-center justify-center text-gray-600 font-medium">
                <%= current_user.initials %>
              </div>
              <span class="sr-only">Your profile</span>
              <span aria-hidden="true" class="flex-1 text-left"><%= current_user.display_name %></span>
              <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div data-dropdown-target="menu" 
                 class="hidden absolute bottom-full left-0 right-0 mb-2 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 z-50">
              <div class="py-1">
                <%= link_to edit_user_registration_path, class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                  <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  My Profile
                <% end %>
                <% if current_account_user %>
                  <div class="px-4 py-2">
                    <p class="text-xs text-gray-500">Signed in as</p>
                    <p class="text-sm font-medium text-gray-900"><%= current_account_user.role_display_name %></p>
                  </div>
                <% end %>
                <div class="border-t border-gray-100"></div>
                <%= button_to destroy_user_session_path, method: :delete, 
                    data: { "turbo-method": :delete },
                    class: "flex w-full items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                  <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
                  </svg>
                  Sign Out
                <% end %>
              </div>
            </div>
          </div>
    <% end %>
  </div>
</aside>

<!-- Mobile Overlay -->
<div id="sidebar-overlay" 
     class="fixed inset-0 bg-black bg-opacity-50 z-30 lg:hidden hidden"
     onclick="toggleSidebar()"></div>

<script>
  function toggleSidebar() {
    const sidebar = document.querySelector('[data-sidebar]');
    const overlay = document.getElementById('sidebar-overlay');
    
    sidebar.classList.toggle('-translate-x-full');
    overlay.classList.toggle('hidden');
  }
</script>