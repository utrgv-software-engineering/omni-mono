<%
  # Determine color scheme based on status and type
  badge_classes = case type
  when "reservation"
    case status
    when "pending"
      "bg-yellow-100 text-yellow-800"
    when "confirmed" 
      "bg-green-100 text-green-800"
    when "checked_in"
      "bg-blue-100 text-blue-800"
    when "checked_out"
      "bg-gray-100 text-gray-800"
    when "cancelled"
      "bg-red-100 text-red-800"
    when "no_show"
      "bg-orange-100 text-orange-800"
    else
      "bg-gray-100 text-gray-800"
    end
  when "room"
    case status
    when "available"
      "bg-green-100 text-green-800"
    when "occupied"
      "bg-blue-100 text-blue-800"
    when "cleaning"
      "bg-yellow-100 text-yellow-800"
    when "maintenance"
      "bg-orange-100 text-orange-800"
    when "blocked"
      "bg-red-100 text-red-800"
    else
      "bg-gray-100 text-gray-800"
    end
  when "payment"
    case status
    when "pending"
      "bg-yellow-100 text-yellow-800"
    when "partial"
      "bg-orange-100 text-orange-800"
    when "paid"
      "bg-green-100 text-green-800"
    when "refunded"
      "bg-purple-100 text-purple-800"
    else
      "bg-gray-100 text-gray-800"
    end
  else
    "bg-gray-100 text-gray-800"
  end
%>

<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge_classes %>">
  <%= status.humanize %>
</span>