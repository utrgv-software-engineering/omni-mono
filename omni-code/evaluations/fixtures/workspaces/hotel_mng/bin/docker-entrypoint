#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Wait for PostgreSQL to be ready (sidecar container)
wait_for_postgres() {
    echo "Waiting for PostgreSQL to be ready..."
    local max_attempts=30
    local attempt=1

    while [ $attempt -le $max_attempts ]; do
        if pg_isready -h localhost -p 5432 -q 2>/dev/null; then
            echo "PostgreSQL is ready!"
            return 0
        fi
        echo "  Attempt $attempt/$max_attempts - PostgreSQL not ready yet..."
        sleep 2
        attempt=$((attempt + 1))
    done

    echo "Warning: PostgreSQL may not be fully ready, proceeding anyway..."
    return 0
}

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
    # Wait for PostgreSQL sidecar if DATABASE_URL is set
    if [ -n "${DATABASE_URL}" ]; then
        wait_for_postgres
    fi

    # Create all databases and run migrations
    echo "Preparing databases..."
    ./bin/rails db:prepare

    # Create auxiliary databases if they don't exist (cache, queue, cable)
    if [ -n "${DATABASE_URL}" ]; then
        for db in hotel_cache hotel_queue hotel_cable; do
            echo "Ensuring database ${db} exists..."
            PGPASSWORD="${POSTGRES_PASSWORD:-hotel}" psql -h localhost -U "${POSTGRES_USER:-hotel}" -tc "SELECT 1 FROM pg_database WHERE datname = '${db}'" | grep -q 1 || \
            PGPASSWORD="${POSTGRES_PASSWORD:-hotel}" psql -h localhost -U "${POSTGRES_USER:-hotel}" -c "CREATE DATABASE ${db}" 2>/dev/null || true
        done
    fi
fi

exec "${@}"
