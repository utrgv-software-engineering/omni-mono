#!/usr/bin/env bash
#
# Thin shim — delegates to the omniagents-eval-creator skill's scripts.
#
# Usage:
#   scripts/eval validate_scenario [args...]
#   scripts/eval generate_review   [args...]
#   scripts/eval compare_iterations [args...]
#
# Override the skill location via $OMNIAGENTS_EVAL_CREATOR_PATH.
#
set -euo pipefail

SKILL_PATH="${OMNIAGENTS_EVAL_CREATOR_PATH:-$HOME/code/skills/skills/omniagents-eval-creator}"

if [ $# -lt 1 ]; then
  echo "usage: $0 <subcommand> [args...]" >&2
  echo "" >&2
  echo "available subcommands (from $SKILL_PATH/scripts/):" >&2
  if [ -d "$SKILL_PATH/scripts" ]; then
    for f in "$SKILL_PATH/scripts/"*.py; do
      [ -e "$f" ] || continue
      name="$(basename "$f" .py)"
      echo "  $name" >&2
    done
  else
    echo "  (skill not found at $SKILL_PATH)" >&2
  fi
  exit 2
fi

SUBCMD="$1"; shift
SCRIPT="$SKILL_PATH/scripts/$SUBCMD.py"

if [ ! -f "$SCRIPT" ]; then
  echo "unknown subcommand: $SUBCMD" >&2
  echo "looked for: $SCRIPT" >&2
  echo "" >&2
  echo "set \$OMNIAGENTS_EVAL_CREATOR_PATH if the skill lives elsewhere." >&2
  exit 2
fi

exec python "$SCRIPT" "$@"
