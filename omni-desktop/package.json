{
  "name": "omni-code-launcher",
  "productName": "Omni Code",
  "version": "1.8.7",
  "description": "Omni Code",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:utrgv-software-engineering/omni-mono.git",
    "directory": "omni-desktop"
  },
  "scripts": {
    "dev": "npm run rebuild && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "download:vcredist": "node scripts/download-vcredist.mjs",
    "package": "npm run clean && npm run download:vcredist && npm run build && dotenv -e .env -- electron-builder --config electron-builder.config.ts --publish never",
    "publish": "npm run clean && npm run download:vcredist && npm run build && dotenv -e .env -- electron-builder --config electron-builder.config.ts --publish always",
    "start": "npm run build && npm run preview",
    "clean": "rimraf out/ dist/",
    "download": "ts-node download_uv.ts",
    "download:clean": "rimraf assets/bin/",
    "lint:knip": "knip --tags=-knipignore",
    "lint:dpdm": "dpdm --no-warning --no-tree --transform --exit-code circular:1 src/main/index.ts src/renderer/index.ts src/preload/index.ts",
    "lint:eslint": "eslint --max-warnings=0 .",
    "lint:prettier": "prettier --check .",
    "lint:shadcn": "node scripts/check-shadcn-boundaries.mjs",
    "lint:shadcn-registry": "node scripts/check-shadcn-registry.mjs",
    "shadcn:self-test": "node scripts/check-shadcn-boundaries.mjs --self-test",
    "shadcn:summary": "node scripts/check-shadcn-boundaries.mjs --summary",
    "shadcn:registry:self-test": "node scripts/check-shadcn-registry.mjs --self-test",
    "shadcn:registry:summary": "node scripts/check-shadcn-registry.mjs --summary",
    "lint:tsc": "tsc --noEmit",
    "lint": "concurrently -g -c red,green,yellow,blue,magenta npm:lint:*",
    "fix": "eslint --fix . && prettier --log-level warn --write .",
    "test": "npm rebuild node-pty && vitest",
    "test:ui": "npm rebuild node-pty && vitest --coverage --ui",
    "test:no-watch": "npm rebuild node-pty && vitest --no-watch",
    "test:e2e": "npm run build && npm run build:server && playwright test",
    "test:e2e:server": "npm run build:server && playwright test --project=server-local",
    "test:e2e:electron": "npm run build && playwright test --project=electron-local",
    "test:e2e:proof": "VISUAL_PROOF=1 npm run build && VISUAL_PROOF=1 npm run build:server && VISUAL_PROOF=1 playwright test",
    "test:e2e:proof:server": "VISUAL_PROOF=1 npm run build:server && VISUAL_PROOF=1 playwright test --project=server-local",
    "test:e2e:proof:electron": "VISUAL_PROOF=1 npm run build && VISUAL_PROOF=1 playwright test --project=electron-local",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "rebuild": "electron-rebuild -f -w node-pty",
    "rebuild:node": "node scripts/rebuild-if-needed.mjs",
    "postinstall": "npm run rebuild && node scripts/download-uv.mjs",
    "react-devtools": "react-devtools",
    "version": "npm version --message 'chore: bump version to v%s'",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:server": "vite build --config vite.server.config.ts && npm run build:browser",
    "build:wsl-payload": "node scripts/build-wsl-payload.mjs",
    "dev:server": "npm run rebuild:node && vite build --config vite.server.config.ts --mode development && concurrently -k -n server-build,browser-dev -c blue,magenta \"NODE_OPTIONS=--max-old-space-size=8192 vite build --config vite.server.config.ts --mode development --watch\" \"vite --config vite.browser.config.ts --mode development --host 0.0.0.0 --port 5173 --strictPort\"",
    "start:server": "npm run rebuild:node && node out/server/index.mjs"
  },
