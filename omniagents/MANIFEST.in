# Include Go TUI sources and auxiliary files in the source distribution
recursive-include omniagents/backends/bubbletea/cmd/omni-tui *.go go.mod go.sum
recursive-include omniagents/backends/bubbletea/cmd/omni-tui/themes *
include omniagents/backends/bubbletea/README.md
recursive-include omniagents/backends/bubbletea/vendor *
recursive-include omniagents/studio/server/static *
recursive-include omniagents/core/project/templates *
recursive-include omniagents/backends/ink/tui/dist *
recursive-include omniagents/backends/ink/tui/src *.ts *.tsx
include omniagents/backends/ink/tui/package.json
include omniagents/backends/ink/tui/tsconfig.json
include omniagents/backends/ink/tui/tsconfig.tsx.json
recursive-include omniagents/backends/web/ui/dist *
recursive-include omniagents/backends/web/ui/src *
include omniagents/backends/web/ui/package.json
include omniagents/backends/web/ui/tsconfig.json
include omniagents/backends/web/ui/tailwind.config.js
include omniagents/backends/web/ui/postcss.config.js

recursive-include vendor/quickjs-ng *.c *.h LICENSE README.md
