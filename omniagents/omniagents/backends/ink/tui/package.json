{
  "name": "omni-ink-tui",
  "version": "0.1.0",
  "type": "module",
  "description": "React Ink-based TUI for OmniAgents",
  "main": "src/index.tsx",
  "bin": {
    "omni-ink-tui": "src/index.tsx"
  },
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "tsx src/build.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "ink",
    "cli",
    "react",
    "tui",
    "terminal",
    "omniagents"
  ],
  "author": "OmniAgents",
  "license": "MIT",
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "figures": "^6.1.0",
    "immer": "^10.2.0",
    "ink": "npm:@jrichman/ink@7.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^19.0.0",
    "slice-ansi": "^9.0.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.20.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "react-devtools-core": "^6.1.5",
    "strip-ansi": "^7.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "react-devtools-core": "^6.1.2"
  }
}
